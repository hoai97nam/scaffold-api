_APP_MUTEX_HANDLE = None


def _resource_path(filename):
    """Resolve bundled resources in source, onefile, and legacy frozen builds."""
    candidates = [
        getattr(sys, "_MEIPASS", ""),
        os.path.dirname(os.path.abspath(__file__)),
        os.path.dirname(sys.executable),
    ]
    for root in candidates:
        if root:
            candidate = os.path.join(root, filename)
            if os.path.isfile(candidate):
                return candidate
    return os.path.join(os.path.dirname(os.path.abspath(__file__)), filename)


def _acquire_single_instance():
    """Allow only one AutoCapCut GUI per Windows user session."""
    global _APP_MUTEX_HANDLE
    if os.name != "nt":
        return True

    import ctypes

    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
    kernel32.CreateMutexW.argtypes = (ctypes.c_void_p, ctypes.c_bool, ctypes.c_wchar_p)
    kernel32.CreateMutexW.restype = ctypes.c_void_p
    kernel32.CloseHandle.argtypes = (ctypes.c_void_p,)

    ctypes.set_last_error(0)
    handle = kernel32.CreateMutexW(
        None,
        False,
        "Local\\AutoCapCut_Vietnam_Main_Instance",
    )
    if not handle:
        return True
    if ctypes.get_last_error() == 183:  # ERROR_ALREADY_EXISTS
        ctypes.WinDLL("user32", use_last_error=True).MessageBoxW(
            None,
            "AutoCapCut đang mở hoặc đang khởi động. Vui lòng chờ.",
            "AutoCapCut",
            0x40,
        )
        kernel32.CloseHandle(handle)
        return False

    _APP_MUTEX_HANDLE = (kernel32, handle)
    return True


def _release_single_instance():
    global _APP_MUTEX_HANDLE
    if _APP_MUTEX_HANDLE:
        kernel32, handle = _APP_MUTEX_HANDLE
        kernel32.CloseHandle(handle)
        _APP_MUTEX_HANDLE = None


def _close_nuitka_splash():
    """Tell the Nuitka onefile parent that the main GUI is ready."""
    parent_pid = os.environ.get("NUITKA_ONEFILE_PARENT")
    if not parent_pid:
        return
    indicator = os.path.join(
        tempfile.gettempdir(),
        f"onefile_{parent_pid}_splash_feedback.tmp",
    )
    try:
        os.remove(indicator)
    except FileNotFoundError:
        pass
    except OSError:
        pass

# PyInstaller cần biết vị trí thư viện Tcl/Tk trước khi customtkinter được import.
# Các thư mục này nằm trong "_internal" (sys._MEIPASS) ở bản đóng gói onedir.
if getattr(sys, "frozen", False):
    runtime_dir = getattr(sys, "_MEIPASS", os.path.dirname(sys.executable))
    tcl_dir = os.path.join(runtime_dir, "_tcl_data")
    tk_dir = os.path.join(runtime_dir, "_tk_data")
    if os.path.isfile(os.path.join(tcl_dir, "init.tcl")):
        os.environ["TCL_LIBRARY"] = tcl_dir
    if os.path.isfile(os.path.join(tk_dir, "tk.tcl")):
        os.environ["TK_LIBRARY"] = tk_dir

