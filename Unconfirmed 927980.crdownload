class GenerationCancelled(Exception):
    """Raised inside the generation thread after a full user cancellation."""


class DualRangeSlider(tk.Canvas):
    """Thanh chọn một khoảng với hai đầu kéo trên cùng một timeline."""

    def __init__(self, master, maximum=1.0, start=0.0, end=1.0, command=None, **kwargs):
        width = kwargs.pop("width", 480)
        height = kwargs.pop("height", 42)
        super().__init__(
            master,
            width=width,
            height=height,
            bg="#2b2b2b",
            highlightthickness=0,
            bd=0,
            **kwargs,
        )
        self.maximum = max(0.1, float(maximum or 1.0))
        self.start_value = max(0.0, min(float(start), self.maximum))
        self.end_value = max(self.start_value, min(float(end), self.maximum))
        self.command = command
        self._active_handle = None
        self._padding = 15
        self.bind("<Configure>", lambda _event: self._draw())
        self.bind("<Button-1>", self._press)
        self.bind("<B1-Motion>", self._drag)
        self.bind("<ButtonRelease-1>", lambda _event: setattr(self, "_active_handle", None))
        self.after_idle(self._draw)

    def set_bounds(self, maximum, start=0.0, end=None):
        self.maximum = max(0.1, float(maximum or 1.0))
        self.start_value = max(0.0, min(float(start), self.maximum))
        self.end_value = self.maximum if end is None else max(
            self.start_value,
            min(float(end), self.maximum),
        )
        self._draw()

    def set_values(self, start, end, notify=False):
        self.start_value = max(0.0, min(float(start), self.maximum))
        self.end_value = max(self.start_value, min(float(end), self.maximum))
        self._draw()
        if notify and self.command:
            self.command(self.start_value, self.end_value)

    def get_values(self):
        return self.start_value, self.end_value

    def _value_to_x(self, value):
        usable = max(1, self.winfo_width() - self._padding * 2)
        return self._padding + (float(value) / self.maximum) * usable

    def _x_to_value(self, x):
        usable = max(1, self.winfo_width() - self._padding * 2)
        ratio = (float(x) - self._padding) / usable
        return max(0.0, min(self.maximum, ratio * self.maximum))

    def _draw(self):
        self.delete("all")
        width = max(self.winfo_width(), 60)
        y = max(14, self.winfo_height() // 2)
        left = self._padding
        right = width - self._padding
        start_x = self._value_to_x(self.start_value)
        end_x = self._value_to_x(self.end_value)
        self.create_line(left, y, right, y, fill="#60666d", width=6, capstyle="round")
        self.create_line(start_x, y, end_x, y, fill="#1f8bd1", width=7, capstyle="round")
        for x, tag in ((start_x, "start"), (end_x, "end")):
            self.create_oval(x - 9, y - 9, x + 9, y + 9, fill="#f2f4f7", outline="#1f8bd1", width=3, tags=tag)

    def _press(self, event):
        start_x = self._value_to_x(self.start_value)
        end_x = self._value_to_x(self.end_value)
        self._active_handle = "start" if abs(event.x - start_x) <= abs(event.x - end_x) else "end"
        self._drag(event)

    def _drag(self, event):
        if not self._active_handle:
            return
        value = self._x_to_value(event.x)
        minimum_gap = min(0.1, self.maximum)
        if self._active_handle == "start":
            self.start_value = min(value, max(0.0, self.end_value - minimum_gap))
        else:
            self.end_value = max(value, min(self.maximum, self.start_value + minimum_gap))
        self._draw()
        if self.command:
            self.command(self.start_value, self.end_value)


class AutoCapCutApp(ctk.CTk):
    def __init__(self):
        super().__init__()

        self._drag_drop_available = False
        if TkinterDnD is not None:
            try:
                TkinterDnD._require(self)
                self._drag_drop_available = True
            except RuntimeError:
                # Browse vẫn hoạt động nếu thư viện DnD không tải được trên
                # một máy Windows đặc biệt.
                pass

        try:
            self.iconbitmap(_resource_path("autocapcut_v43.ico"))
        except Exception:
            pass
        
        self.title("AutoCapCut - Tự động khớp media và âm thanh (Hỗ trợ: 0937659552) - 190k Vĩnh viễn")
        # Window scaling đang là 70%, nên dùng chiều cao logic 1050 để cửa
        # sổ thực tế đủ chỗ cho cả form và log mà không cần ghim log.
        self.geometry("900x1050")
        self.minsize(820, 700)
        self.license_manager = LicenseManager()
        self.payment_client = AutoCapCutPaymentClient()
        self._license_popup = None
        self._license_poll_after = None
        self._license_qr_image = None
        self._log_queue = queue.Queue()
        self._ui_queue = queue.Queue()
        self._generation_cancel_event = threading.Event()
        self._generation_running = False
        self._active_worker_process = None
        self._active_worker_lock = threading.Lock()
        self._generation_cleanup_context = None
        
        saved_settings = self.load_app_settings()
        saved_motion = saved_settings.get("motion", {})
        if not isinstance(saved_motion, dict):
            saved_motion = {}
        saved_assets = saved_settings.get("assets", {})
        if not isinstance(saved_assets, dict):
            saved_assets = {}

        def restore_asset_selection(group_name, valid_keys):
            group = saved_assets.get(group_name, {})
            if not isinstance(group, dict):
                group = {}
            selected = group.get("selected", [])
            if not isinstance(selected, list):
                selected = []
            restored = {
                key for key in selected
                if isinstance(key, str) and key in valid_keys
            }
            restored.discard("none")
            return group, (restored or {"none"})

        self.add_subtitles = ctk.BooleanVar(value=True)
        self.remove_gemini_watermark = ctk.BooleanVar(value=False)
        self.audio_files = []
        self.background_music_files = []
        self.background_music_clips = []
        self._music_editor_popup = None
        self._music_editor_rows = []
        self._music_preview_alias = None
        self._sound_preview_temp_path = None
        self.sort_combo = ctk.StringVar(value="Sắp xếp media theo ABC")
        self.motion_random = ctk.BooleanVar(
            value=bool(saved_motion.get("random", True))
        )
        saved_transition, selected_transitions = restore_asset_selection(
            "transition",
            {"none", *TRANSITION_PRESETS.keys()},
        )
        self.transition_random = ctk.BooleanVar(
            value=bool(saved_transition.get("random", False))
        )
        self.transition_vars = {
            "none": ctk.BooleanVar(value="none" in selected_transitions),
            **{
                key: ctk.BooleanVar(value=key in selected_transitions)
                for key in TRANSITION_PRESETS
            },
        }
        saved_effect, selected_effects = restore_asset_selection(
            "effect",
            {"none", *VIDEO_EFFECT_PRESETS.keys()},
        )
        self.effect_random = ctk.BooleanVar(
            value=bool(saved_effect.get("random", False))
        )
        self.effect_vars = {
            "none": ctk.BooleanVar(value="none" in selected_effects),
            **{
                key: ctk.BooleanVar(value=key in selected_effects)
                for key in VIDEO_EFFECT_PRESETS
            },
        }
        saved_sound, selected_sounds = restore_asset_selection(
            "sound_effect",
            {"none", *SOUND_EFFECT_PRESETS.keys()},
        )
        self.sound_effect_random = ctk.BooleanVar(
            value=bool(saved_sound.get("random", False))
        )
        self.sound_effect_vars = {
            "none": ctk.BooleanVar(value="none" in selected_sounds),
            **{
                key: ctk.BooleanVar(value=key in selected_sounds)
                for key in SOUND_EFFECT_PRESETS
            },
        }
        self.animation_registry = load_custom_animations()
        saved_animation = saved_assets.get("animation", {})
        if not isinstance(saved_animation, dict):
            saved_animation = {}
        saved_animation_slots = saved_animation.get("selected", {})
        if not isinstance(saved_animation_slots, dict):
            saved_animation_slots = {}
        self.animation_random = ctk.BooleanVar(
            value=bool(saved_animation.get("random", False))
        )
        self.animation_vars = {}
        for typ in ("in", "out", "group"):
            valid_keys = [
                key for key, item in self.animation_registry.items()
                if item.get("type") == typ
            ]
            valid_key_set = set(valid_keys)
            saved_keys = saved_animation_slots.get(typ, [])
            if not isinstance(saved_keys, list):
                saved_keys = []
            restored_keys = {
                key for key in saved_keys
                if isinstance(key, str) and key in valid_key_set
            }
            self.animation_vars[typ] = {
                "none": ctk.BooleanVar(value=not restored_keys),
                **{
                    key: ctk.BooleanVar(value=key in restored_keys)
                    for key in valid_keys
                },
            }
        saved_modes = saved_motion.get("modes", {})
        if not isinstance(saved_modes, dict):
            saved_modes = {}
        self.motion_mode_vars = {
            key: ctk.BooleanVar(value=bool(saved_modes.get(key, True)))
            for key in (
                "zoom_in", "zoom_out", "pan_up", "pan_down",
                "pan_left", "pan_right",
            )
        }
        saved_amounts = saved_motion.get("zoom_amounts", {})
        if not isinstance(saved_amounts, dict):
            saved_amounts = {}
        self.motion_amount_vars = {
            "zoom_in": ctk.StringVar(value=str(saved_amounts.get("zoom_in", "110"))),
            "zoom_out": ctk.StringVar(value=str(saved_amounts.get("zoom_out", "110"))),
        }
        saved_optional_amounts = saved_motion.get("zoom_optional_amounts", {})
        if not isinstance(saved_optional_amounts, dict):
            saved_optional_amounts = {}
        self.motion_optional_amount_vars = {
            "zoom_in": ctk.StringVar(value=str(saved_optional_amounts.get("zoom_in", ""))),
            "zoom_out": ctk.StringVar(value=str(saved_optional_amounts.get("zoom_out", ""))),
        }
        self.motion_zoom_entries = {}
        self._zoom_validation_tooltip = None
        self._zoom_hint_tooltip = None
        self._last_motion_error_entry = None
        pan_defaults = {
            "x": {"pan_up": "0", "pan_down": "0", "pan_left": "190", "pan_right": "190"},
            "y": {"pan_up": "108", "pan_down": "108", "pan_left": "0", "pan_right": "0"},
            "scale": {"pan_up": "110", "pan_down": "110", "pan_left": "110", "pan_right": "110"},
        }
        saved_pan = saved_motion.get("pan", {})
        if not isinstance(saved_pan, dict):
            saved_pan = {}

        def make_pan_vars(field):
            values = saved_pan.get(field, {})
            if not isinstance(values, dict):
                values = {}
            return {
                key: ctk.StringVar(value=str(values.get(key, default_value)))
                for key, default_value in pan_defaults[field].items()
            }

        self.pan_x_vars = make_pan_vars("x")
        self.pan_y_vars = make_pan_vars("y")
        self.pan_scale_vars = make_pan_vars("scale")
        self.match_mode_setting = ctk.StringVar(
            value="accurate"
        )
        self.capcut_project_dir_setting = ctk.StringVar(
            value=saved_settings.get("capcut_project_dir") or get_capcut_project_dir()
        )
        self.capcut_install_dir_setting = ctk.StringVar(
            value=saved_settings.get("capcut_install_dir") or self.detect_capcut_install_dir()
        )
        self.long_video_setting = ctk.StringVar(
            value=saved_settings.get("long_video_mode", "trim")
        )
        self.video_keyframe_setting = ctk.StringVar(
            value=saved_settings.get("video_keyframes", "no")
        )
        saved_subtitle_mode = saved_settings.get("subtitle_mode", "scene_full")
        if saved_subtitle_mode not in {"scene_full", "scene_chunks", "srt_original"}:
            saved_subtitle_mode = "scene_full"
        self.subtitle_mode_setting = ctk.StringVar(value=saved_subtitle_mode)
        saved_capcut_version = saved_settings.get(
            "capcut_version", "8.7.0 trở lên"
        )
        if saved_capcut_version not in {"5.9.1", "8.7.0 trở lên"}:
            saved_capcut_version = "8.7.0 trở lên"
        self.capcut_version_setting = ctk.StringVar(value=saved_capcut_version)
        
        self.build_ui()
        self._dropdown_reflow_job = None
        self.bind("<Configure>", self._schedule_open_dropdown_reflow, add="+")
        # Checkbox giữ keyboard focus sau khi được bấm. Dùng bind_all để phím
        # Delete vẫn tới trình xử lý khi người dùng đang thao tác trong dropdown.
        # Hàm xử lý bên dưới đã bỏ qua Entry/Text để không cản việc sửa văn bản.
        self.bind_all(
            "<Delete>",
            self._delete_selected_custom_dropdown_items,
            add="+",
        )
        self._log_min_height = 145
        self._log_base_window_height = None
        self._log_height_ratio = 1.0
        self._log_resize_job = None
        self._responsive_base_width = None
        self._responsive_base_height = None
        self._responsive_widget_scale = 0.70
        self._scale_resize_job = None
        self._last_window_snapshot = None
        self._resize_overlay = None
        self._resize_overlay_hide_job = None
        self.after(250, self._initialize_responsive_log)
        self.after(50, self._drain_log_queue)
        self.after(150, self.require_trial_consent)
        if is_packaged_exe():
            self.after(500, self._start_automatic_update_check)
        self.protocol("WM_DELETE_WINDOW", self._close_application)

    def _start_automatic_update_check(self):
        threading.Thread(
            target=auto_check_and_stage,
            args=(self.payment_client, APP_VERSION, self.log),
            daemon=True,
            name="AutoCapCutUpdateCheck",
        ).start()

    @staticmethod
    def get_settings_path():
        appdata = os.environ.get("LOCALAPPDATA") or os.path.expanduser("~")
        return os.path.join(appdata, "AutoCapCut", "settings.json")

    @staticmethod
    def detect_capcut_install_dir():
        try:
            from capcut_batch_engine import find_capcut_install_directory
            return str(find_capcut_install_directory())
        except (ImportError, OSError, RuntimeError):
            return ""

    def load_app_settings(self):
        try:
            with open(self.get_settings_path(), "r", encoding="utf-8") as handle:
                data = json.load(handle)
            if not isinstance(data, dict):
                return {}
            return data
        except (OSError, ValueError, TypeError):
            return {}

    def save_app_settings(self):
        settings_path = self.get_settings_path()
        os.makedirs(os.path.dirname(settings_path), exist_ok=True)
        previous_settings = self.load_app_settings()
        output_setting = getattr(self, "_batch_export_output_setting", None)
        data = {
            "match_mode": self.match_mode_setting.get(),
            "capcut_project_dir": (
                self.capcut_project_dir_setting.get().strip()
                or previous_settings.get("capcut_project_dir")
                or get_capcut_project_dir()
            ),
            "capcut_install_dir": self.capcut_install_dir_setting.get().strip(),
            "long_video_mode": self.long_video_setting.get(),
            "video_keyframes": self.video_keyframe_setting.get(),
            "subtitle_mode": self.subtitle_mode_setting.get(),
            "capcut_version": self.capcut_version_setting.get(),
            "batch_export_output_dir": (
                output_setting.get().strip() if output_setting is not None
                else previous_settings.get("batch_export_output_dir", "")
            ),
            "assets": {
                "transition": {
                    "selected": [
                        key for key, var in self.transition_vars.items()
                        if var.get()
                    ],
                    "random": bool(self.transition_random.get()),
                },
                "effect": {
                    "selected": [
                        key for key, var in self.effect_vars.items()
                        if var.get()
                    ],
                    "random": bool(self.effect_random.get()),
                },
                "animation": {
                    "selected": {
                        typ: [
                            key for key, var in variables.items()
                            if var.get()
                        ]
                        for typ, variables in self.animation_vars.items()
                    },
                    "random": bool(self.animation_random.get()),
                },
                "sound_effect": {
                    "selected": [
                        key for key, var in self.sound_effect_vars.items()
                        if var.get()
                    ],
                    "random": bool(self.sound_effect_random.get()),
                },
            },
            "motion": {
                "random": bool(self.motion_random.get()),
                "modes": {
                    key: bool(var.get())
                    for key, var in self.motion_mode_vars.items()
                },
                "zoom_amounts": {
                    key: var.get()
                    for key, var in self.motion_amount_vars.items()
                },
                "zoom_optional_amounts": {
                    key: var.get()
                    for key, var in self.motion_optional_amount_vars.items()
                },
                "pan": {
                    "x": {key: var.get() for key, var in self.pan_x_vars.items()},
                    "y": {key: var.get() for key, var in self.pan_y_vars.items()},
                    "scale": {
                        key: var.get()
                        for key, var in self.pan_scale_vars.items()
                    },
                },
            },
        }
        with open(settings_path, "w", encoding="utf-8") as handle:
            json.dump(data, handle, ensure_ascii=False, indent=2)

    def _close_application(self):
        popup = getattr(self, '_batch_export_popup', None)
        if popup is not None and popup.winfo_exists() and popup.running:
            popup.cancel()
            self.after(250, self._close_application)
            return
        if self._generation_running:
            self._generation_cancel_event.set()
            with self._active_worker_lock:
                process = self._active_worker_process
            if process is not None:
                try:
                    if process.is_alive():
                        process.terminate()
                except (OSError, ValueError):
                    pass
        try:
            self.save_app_settings()
        except OSError:
            # A settings write failure must not prevent the app from closing.
            pass
        try:
            launch_installer(APP_VERSION)
        except (OSError, ValueError) as exc:
            self.log(f"Chưa thể cài bản cập nhật tự động: {exc}")
        self.destroy()
        
    def build_ui(self):
        frame = ctk.CTkScrollableFrame(self)
        self.main_scroll_frame = frame
        frame.pack(pady=10, padx=10, fill="both", expand=True)
        
        title_row = ctk.CTkFrame(frame, fg_color="transparent")
        title_row.pack(fill="x", pady=10, padx=10)

        self.settings_btn = ctk.CTkButton(
            title_row,
            text="⚙",
            width=30,
            height=28,
            corner_radius=7,
            font=ctk.CTkFont(size=17),
            command=self.open_settings_popup,
        )
        # Dùng place để icon không làm thay đổi chiều cao/chiều rộng bố cục cũ.
        self.settings_btn.place(x=0, rely=0.5, anchor="w")

        ctk.CTkLabel(
            title_row,
            text="Tự động khớp ảnh/video và âm thanh",
            font=ctk.CTkFont(size=20, weight="bold")
        ).pack(side="left", expand=True)
        self.license_btn = ctk.CTkButton(
            title_row,
            text="Kích hoạt",
            width=66,
            height=26,
            font=ctk.CTkFont(size=11),
            command=self.open_license_popup
        )
        self.license_btn.pack(side="right")
        self.refresh_license_button()
        
        std_font = ctk.CTkFont(size=13)
        self.audio_path = self.create_audio_file_selector(
            frame,
            "Audio File:",
            [("Audio Files", "*.mp3 *.wav *.m4a *.aac *.flac *.ogg *.wma")],
            "Chọn một hoặc nhiều file audio",
            std_font,
        )
        self.srt_path = self.create_file_selector(
            frame,
            "SRT File:",
            [("Subtitle Files", "*.srt *.txt")],
            "Chọn file SRT hoặc TXT",
            std_font,
            help_url="https://youtu.be/1GcoSIIvU_U",
        )
        self.create_scenes_input(frame, std_font)
        self.image_dir = self.create_dir_selector(frame, "Media Folder:", "Chọn thư mục chứa ảnh hoặc video", std_font)
        self.background_music_entry = self.create_multi_file_selector(
            frame,
            "Nhạc nền:",
            [("Audio Files", "*.mp3 *.wav *.m4a *.aac *.flac *.ogg *.wma")],
            "Có thể chọn nhiều file nhạc nền",
            std_font,
        )
        
        # Project Name
        pn_frame = ctk.CTkFrame(frame, fg_color="transparent")
        pn_frame.pack(fill="x", pady=5, padx=10)
        ctk.CTkLabel(pn_frame, text="CapCut Name:", width=150, anchor="w").pack(side="left")
        self.project_name = ctk.CTkEntry(pn_frame, font=std_font)
        self.project_name.pack(side="left", fill="x", expand=True, padx=5)
        
        placeholder = "Đặt tên cho dự án CapCut"
        self.project_name.insert(0, placeholder)
        self.project_name.configure(text_color="gray60")
        def pn_focus_in(event):
            if self.project_name.get() == placeholder:
                self.project_name.delete(0, 'end')
                self.project_name.configure(text_color=("gray10", "gray90"))
        def pn_focus_out(event):
            if not self.project_name.get():
                self.project_name.insert(0, placeholder)
                self.project_name.configure(text_color="gray60")
        self.project_name.bind("<FocusIn>", pn_focus_in)
        self.project_name.bind("<FocusOut>", pn_focus_out)
        
        # Options
        opt_frame = ctk.CTkFrame(frame, fg_color="transparent")
        opt_frame.pack(fill="x", pady=10, padx=10)
        ctk.CTkCheckBox(opt_frame, text="Tự động chèn phụ đề vào video", variable=self.add_subtitles).pack(side="left")
        ctk.CTkCheckBox(
            opt_frame,
            text="Xóa watermark Gemini khỏi ảnh",
            variable=self.remove_gemini_watermark,
        ).pack(side="left", padx=(18, 0))
        
        sort_opts = ["Sắp xếp media theo ABC", "Sắp xếp media theo thời gian Cũ đến Mới", "Sắp xếp media theo thời gian Mới đến Cũ"]
        ctk.CTkOptionMenu(opt_frame, variable=self.sort_combo, values=sort_opts).pack(side="right")

        asset_grid = ctk.CTkFrame(frame, fg_color="transparent")
        asset_grid.pack(fill="x", pady=5, padx=10)
        asset_grid.grid_columnconfigure((0, 1), weight=1, uniform="asset_option")

        def create_asset_option_cell(
            row,
            column,
            label,
            button_text,
            button_command,
            random_variable,
            align_right=False,
        ):
            cell = ctk.CTkFrame(
                asset_grid,
                fg_color=("gray92", "gray17"),
                corner_radius=7,
            )
            cell.grid(
                row=row,
                column=column,
                sticky="ew",
                padx=(0, 4) if column == 0 else (4, 0),
                pady=4,
            )
            if align_right:
                cell.grid_columnconfigure(0, weight=1)
            ctk.CTkLabel(
                cell,
                text=label,
                width=82,
                anchor="w",
            ).grid(
                row=0,
                column=0,
                padx=(9, 3),
                pady=7,
                sticky="e" if align_right else "w",
            )
            # Fixed-size holder prevents long preset names from widening any
            # of the four blue selector buttons.
            button_slot = ctk.CTkFrame(
                cell,
                width=149,
                height=28,
                fg_color="transparent",
            )
            button_slot.grid(
                row=0,
                column=1,
                padx=3,
                pady=7,
                sticky="w",
            )
            button_slot.grid_propagate(False)
            button = ctk.CTkButton(
                button_slot,
                text=button_text,
                width=149,
                height=28,
                anchor="w",
                command=button_command,
            )
            button.place(x=0, y=0)
            ctk.CTkCheckBox(
                cell,
                text="Ngẫu nhiên",
                variable=random_variable,
                width=96,
            ).grid(row=0, column=2, padx=(7, 8), pady=7, sticky="e")
            return cell, button

        self.transition_row, self.transition_button = create_asset_option_cell(
            0,
            0,
            "Transition:",
            "Không transition  ▼",
            self.open_transition_dropdown,
            self.transition_random,
        )
        self.transition_row.grid_columnconfigure(1, weight=0)
        self.transition_dropdown_frame = None
        self._transition_click_bind_id = None
        self._transition_wheel_bind_id = None

        self.effect_row, self.effect_button = create_asset_option_cell(
            0,
            1,
            "Hiệu ứng:",
            "Không hiệu ứng  ▼",
            self.open_effect_dropdown,
            self.effect_random,
            True,
        )
        self.effect_dropdown_frame = None
        self._effect_click_bind_id = None
        self._effect_wheel_bind_id = None

        self.animation_row, self.animation_button = create_asset_option_cell(
            1,
            0,
            "Animation:",
            "Không animation  ▼",
            self.open_animation_dropdown,
            self.animation_random,
        )
        self.animation_row.grid_columnconfigure(1, weight=0)
        self.animation_dropdown_frame = None
        self._animation_click_bind_id = None
        self._animation_wheel_bind_id = None

        self.sound_effect_row, self.sound_effect_button = create_asset_option_cell(
            1,
            1,
            "Sound:",
            "Không sound effect  ▼",
            self.open_sound_effect_dropdown,
            self.sound_effect_random,
            True,
        )
        self.sound_effect_dropdown_frame = None
        self._sound_effect_click_bind_id = None
        self._sound_effect_wheel_bind_id = None

        self.update_transition_button_text()
        self.update_effect_button_text()
        self.update_animation_button_text()
        self.update_sound_effect_button_text()

        self.create_motion_options(frame, std_font)
        
        action_row = ctk.CTkFrame(frame, fg_color="transparent", height=40)
        action_row.pack(fill="x", pady=20)
        action_row.pack_propagate(False)
        self.generate_btn = ctk.CTkButton(action_row, text="TẠO PROJECT CAPCUT", width=220, height=40, font=ctk.CTkFont(size=14, weight="bold"), command=self.start_generation)
        self.generate_btn.place(relx=0.5, rely=0.0, anchor="n")
        self.batch_export_btn = ctk.CTkButton(
            action_row, text="Xuất hàng loạt", width=165, height=40,
            font=ctk.CTkFont(size=14, weight="bold"), command=self.open_batch_export_popup,
        )
        self.batch_export_btn.place(relx=1.0, x=-10, rely=0.0, anchor="ne")
        self._generate_button_default_fg = self.generate_btn.cget("fg_color")
        self._generate_button_default_hover = self.generate_btn.cget("hover_color")
        
        # Log nằm trong form và cuộn cùng toàn bộ giao diện.
        self.log_box = ctk.CTkTextbox(frame, height=145)
        self.log_box.pack(fill="both", expand=True, padx=10, pady=5)

    def _initialize_responsive_log(self):
        self.update_idletasks()
        # Remove unused space below the log at startup, using rendered pixels
        # so Windows DPI and CustomTkinter scaling are both accounted for.
        viewport = self.main_scroll_frame._parent_canvas
        log_bottom = self.log_box.winfo_rooty() + self.log_box.winfo_height()
        viewport_bottom = viewport.winfo_rooty() + viewport.winfo_height()
        spare_height = max(0, viewport_bottom - log_bottom - 10)
        if spare_height > 4:
            width = round(self._reverse_window_scaling(self.winfo_width()))
            height = round(self._reverse_window_scaling(
                self.winfo_height() - spare_height
            ))
            self.geometry(f"{width}x{height}")
            self.update_idletasks()
        self._log_base_window_height = self.winfo_height()
        self._responsive_base_width = max(self.winfo_width(), 1)
        self._responsive_base_height = max(self.winfo_height(), 1)
        self._last_window_snapshot = (
            self.state(),
            self._responsive_base_width,
            self._responsive_base_height,
        )
        actual_log_height = max(self.log_box.winfo_height(), 1)
        self._log_height_ratio = self._log_min_height / actual_log_height
        self.after(100, self._monitor_main_window)

    def _monitor_main_window(self):
        if not self.winfo_exists():
            return
        snapshot = (self.state(), self.winfo_width(), self.winfo_height())
        previous_snapshot = self._last_window_snapshot
        if snapshot != previous_snapshot:
            state_changed = previous_snapshot is not None and snapshot[0] != previous_snapshot[0]
            self._last_window_snapshot = snapshot
            if state_changed:
                self._show_resize_overlay()
                if self._log_resize_job is not None:
                    self.after_cancel(self._log_resize_job)
                    self._log_resize_job = None
                if self._scale_resize_job is not None:
                    self.after_cancel(self._scale_resize_job)
                # Do not debounce against every intermediate Windows animation
                # frame. A maximize/restore transition must always finish once.
                self._scale_resize_job = self.after(
                    180,
                    self._apply_current_responsive_widget_scale,
                )
            elif self._scale_resize_job is None:
                # Manual resizing only changes the expandable log area. Wait
                # until dragging settles so CustomTkinter is not redrawn on
                # every pixel-sized Configure event.
                if self._log_resize_job is not None:
                    self.after_cancel(self._log_resize_job)
                self._log_resize_job = self.after(
                    220,
                    lambda current_height=snapshot[2]: self._resize_log_to_window(
                        current_height
                    ),
                )
        self.after(100, self._monitor_main_window)

    def _apply_current_responsive_widget_scale(self):
        self._apply_responsive_widget_scale(
            self.winfo_width(),
            self.winfo_height(),
        )

    def _show_resize_overlay(self):
        if self._resize_overlay is not None and self._resize_overlay.winfo_exists():
            return
        overlay = tk.Frame(self, bg="#2b2b2b", bd=0, highlightthickness=0)
        overlay.place(x=0, y=0, relwidth=1, relheight=1)
        tk.Label(
            overlay,
            text="Đang điều chỉnh giao diện...",
            bg="#2b2b2b",
            fg="#dce4ee",
            font=("Segoe UI", 13, "bold"),
        ).place(relx=0.5, rely=0.5, anchor="center")
        overlay.lift()
        self._resize_overlay = overlay
        if self._resize_overlay_hide_job is not None:
            self.after_cancel(self._resize_overlay_hide_job)
        # Safety fallback: never leave the loading layer on screen indefinitely.
        self._resize_overlay_hide_job = self.after(1800, self._hide_resize_overlay)

    def _hide_resize_overlay(self):
        if self._resize_overlay_hide_job is not None:
            try:
                self.after_cancel(self._resize_overlay_hide_job)
            except (RuntimeError, tk.TclError):
                pass
            self._resize_overlay_hide_job = None
        overlay = self._resize_overlay
        self._resize_overlay = None
        if overlay is not None and overlay.winfo_exists():
            overlay.destroy()

    def _apply_responsive_widget_scale(self, window_width, window_height):
        self._scale_resize_job = None
        if not self._responsive_base_width or not self._responsive_base_height:
            return

        if self.state() == "zoomed":
            width_ratio = max(1.0, window_width / self._responsive_base_width)
            height_ratio = max(1.0, window_height / self._responsive_base_height)
            available_ratio = min(width_ratio, height_ratio)
            target_scale = min(
                0.95,
                max(0.82, round(0.70 * available_ratio, 2)),
            )
        else:
            target_scale = 0.70

        if abs(target_scale - self._responsive_widget_scale) < 0.02:
            self._resize_log_to_window(window_height)
            self.after(60, self._hide_resize_overlay)
            return

        # Hide the canvas tree while CustomTkinter replaces its scaled shapes.
        # Repacking in the same UI callback prevents partially drawn widgets
        # from becoming visible during Windows' maximize animation.
        self.main_scroll_frame.pack_forget()
        try:
            ctk.set_widget_scaling(target_scale)
            self._responsive_widget_scale = target_scale
            self._log_height_ratio = 1.0 / target_scale
            self._resize_log_to_window(window_height)
        finally:
            self.main_scroll_frame.pack(
                pady=10,
                padx=10,
                fill="both",
                expand=True,
            )

        self.update_idletasks()
        try:
            canvas = self.main_scroll_frame._parent_canvas
            scroll_region = canvas.bbox("all")
            if scroll_region:
                canvas.configure(scrollregion=scroll_region)
        except (AttributeError, RuntimeError):
            pass
        self.after(60, self._hide_resize_overlay)

    def _resize_log_to_window(self, window_height):
        self._log_resize_job = None
        extra_height = max(0, window_height - self._log_base_window_height)
        target_height = self._log_min_height + int(
            round(extra_height * self._log_height_ratio)
        )
        if int(self.log_box.cget("height")) != target_height:
            self.log_box.configure(height=target_height)

    def open_settings_popup(self):
        popup = ctk.CTkToplevel(self)
        popup.title("Cài đặt AutoCapCut")
        popup_height = min(995, max(650, popup.winfo_screenheight() - 100))
        popup.geometry(f"650x{popup_height}")
        popup.minsize(650, 600)
        popup.resizable(False, True)
        popup.transient(self)
        popup.grab_set()

        ctk.CTkLabel(
            popup,
            text="CÀI ĐẶT",
            font=ctk.CTkFont(size=20, weight="bold"),
        ).pack(pady=(20, 14))

        content = ctk.CTkScrollableFrame(
            popup,
            fg_color="transparent",
            corner_radius=0,
            scrollbar_button_color=("gray70", "gray35"),
            scrollbar_button_hover_color=("gray60", "gray45"),
        )
        content.pack(fill="both", expand=True, padx=22, pady=(0, 10))

        update_box = ctk.CTkFrame(content)
        update_box.pack(fill="x", pady=(0, 12))
        ctk.CTkLabel(
            update_box,
            text="Cập nhật AutoCapCut",
            font=ctk.CTkFont(size=14, weight="bold"),
            anchor="w",
        ).pack(fill="x", padx=16, pady=(13, 5))
        update_row = ctk.CTkFrame(update_box, fg_color="transparent")
        update_row.pack(fill="x", padx=16, pady=(0, 13))
        update_status = ctk.CTkLabel(
            update_row,
            text=f"Phiên bản hiện tại: {APP_VERSION}",
            anchor="w",
            text_color="gray70",
        )
        update_status.pack(side="left", fill="x", expand=True)

        def version_tuple(value):
            numbers = [int(item) for item in re.findall(r"\d+", str(value))]
            return tuple((numbers + [0, 0, 0])[:3])

        def check_for_updates():
            update_button.configure(state="disabled", text="ĐANG KIỂM TRA...")
            update_status.configure(
                text="Đang kiểm tra...",
                text_color="gray70",
            )

            def worker():
                release = self.payment_client.get_latest_release()

                def finish():
                    if not popup.winfo_exists():
                        return
                    latest = str(release.get("version") or "").strip()
                    download_url = str(release.get("download_url") or "").strip()
                    if release.get("error") or not latest:
                        update_status.configure(
                            text="Không thể kiểm tra cập nhật. Vui lòng thử lại.",
                            text_color="#E16B6B",
                        )
                        update_button.configure(
                            state="normal",
                            text="KIỂM TRA LẠI",
                            command=check_for_updates,
                        )
                        return
                    if version_tuple(latest) <= version_tuple(APP_VERSION):
                        update_status.configure(
                            text=f"Bạn đang dùng bản mới nhất ({APP_VERSION}).",
                            text_color="#5FB878",
                        )
                        update_button.configure(
                            state="normal",
                            text="KIỂM TRA LẠI",
                            command=check_for_updates,
                        )
                        return
                    update_status.configure(
                        text=f"Đã có phiên bản mới: {latest}",
                        text_color="#E6A94B",
                    )
                    if download_url.startswith(("https://", "http://")):
                        update_button.configure(
                            state="normal",
                            text="TẢI BẢN MỚI",
                            fg_color="#2E8B57",
                            hover_color="#256F46",
                            command=lambda: webbrowser.open(download_url),
                        )
                    else:
                        update_button.configure(
                            state="disabled",
                            text="CHƯA CÓ LINK TẢI",
                        )

                popup.after(0, finish)

            threading.Thread(target=worker, daemon=True).start()

        update_button = ctk.CTkButton(
            update_row,
            text="KIỂM TRA CẬP NHẬT",
            width=155,
            command=check_for_updates,
        )
        update_button.pack(side="right", padx=(10, 0))

        capcut_version_box = ctk.CTkFrame(content)
        capcut_version_box.pack(fill="x", pady=(0, 12))
        capcut_version_row = ctk.CTkFrame(
            capcut_version_box,
            fg_color="transparent",
        )
        capcut_version_row.pack(fill="x", padx=16, pady=13)
        ctk.CTkLabel(
            capcut_version_row,
            text="Phiên bản CapCut",
            font=ctk.CTkFont(size=14, weight="bold"),
            anchor="w",
        ).pack(side="left", fill="x", expand=True)
        ctk.CTkOptionMenu(
            capcut_version_row,
            values=["5.9.1", "8.7.0 trở lên"],
            variable=self.capcut_version_setting,
            width=170,
        ).pack(side="right")

        match_box = ctk.CTkFrame(content)
        match_box.pack(fill="x", pady=(0, 12))
        fast_checked = ctk.BooleanVar(
            value=self.match_mode_setting.get() == "fast"
        )
        accurate_checked = ctk.BooleanVar(
            value=self.match_mode_setting.get() == "accurate"
        )
        ultra_checked = ctk.BooleanVar(
            value=self.match_mode_setting.get() == "ultra"
        )

        def select_match_mode(mode):
            self.match_mode_setting.set(mode)
            fast_checked.set(mode == "fast")
            accurate_checked.set(mode == "accurate")
            ultra_checked.set(mode == "ultra")

        ctk.CTkLabel(
            match_box,
            text="Chế độ khớp ảnh/video và âm thanh",
            font=ctk.CTkFont(size=14, weight="bold"),
            anchor="w",
        ).pack(fill="x", padx=16, pady=(13, 7))
        ctk.CTkCheckBox(
            match_box,
            text="Khớp siêu nhanh (có thể sai lệch)",
            variable=fast_checked,
            command=lambda: select_match_mode("fast"),
        ).pack(anchor="w", padx=18, pady=5)
        ctk.CTkCheckBox(
            match_box,
            text="Khớp chính xác",
            variable=accurate_checked,
            command=lambda: select_match_mode("accurate"),
        ).pack(anchor="w", padx=18, pady=(5, 13))
        ultra_checkbox = ctk.CTkCheckBox(
            match_box,
            text="Khớp siêu chính xác (lâu hơn)",
            variable=ultra_checked,
            command=lambda: select_match_mode("ultra"),
        )
        # Keep the ultra mode and its control code, but do not show it in Settings.

        subtitle_box = ctk.CTkFrame(content)
        subtitle_box.pack(fill="x", pady=(0, 12))
        scene_full_checked = ctk.BooleanVar(
            value=self.subtitle_mode_setting.get() == "scene_full"
        )
        scene_chunks_checked = ctk.BooleanVar(
            value=self.subtitle_mode_setting.get() == "scene_chunks"
        )
        srt_original_checked = ctk.BooleanVar(
            value=self.subtitle_mode_setting.get() == "srt_original"
        )

        def select_subtitle_mode(mode):
            self.subtitle_mode_setting.set(mode)
            scene_full_checked.set(mode == "scene_full")
            scene_chunks_checked.set(mode == "scene_chunks")
            srt_original_checked.set(mode == "srt_original")

        ctk.CTkLabel(
            subtitle_box,
            text="Chế độ phụ đề",
            font=ctk.CTkFont(size=14, weight="bold"),
            anchor="w",
        ).pack(fill="x", padx=16, pady=(13, 7))
        ctk.CTkCheckBox(
            subtitle_box,
            text="Một phụ đề cho mỗi scene",
            variable=scene_full_checked,
            command=lambda: select_subtitle_mode("scene_full"),
        ).pack(anchor="w", padx=18, pady=5)
        ctk.CTkCheckBox(
            subtitle_box,
            text="Chia phụ đề mỗi scene thành nhiều đoạn ngắn",
            variable=scene_chunks_checked,
            command=lambda: select_subtitle_mode("scene_chunks"),
        ).pack(anchor="w", padx=18, pady=5)
        ctk.CTkCheckBox(
            subtitle_box,
            text="Phụ đề theo SRT gốc",
            variable=srt_original_checked,
            command=lambda: select_subtitle_mode("srt_original"),
        ).pack(anchor="w", padx=18, pady=(5, 13))
        project_box = ctk.CTkFrame(content)
        project_box.pack(fill="x", pady=(0, 12))
        ctk.CTkLabel(
            project_box,
            text="Vị trí lưu dự án CapCut (chỉ đổi nếu bạn thay đổi ở cài đặt CapCut)",
            font=ctk.CTkFont(size=14, weight="bold"),
            anchor="w",
        ).pack(fill="x", padx=16, pady=(13, 7))
        path_row = ctk.CTkFrame(project_box, fg_color="transparent")
        path_row.pack(fill="x", padx=16, pady=(0, 13))
        ctk.CTkEntry(
            path_row,
            textvariable=self.capcut_project_dir_setting,
        ).pack(side="left", fill="x", expand=True, padx=(0, 8))

        def browse_project_dir():
            selected = filedialog.askdirectory(
                title="Chọn vị trí lưu dự án CapCut",
                initialdir=self.capcut_project_dir_setting.get(),
                parent=popup,
            )
            if selected:
                self.capcut_project_dir_setting.set(selected)

        ctk.CTkButton(
            path_row,
            text="Browse",
            width=82,
            command=browse_project_dir,
        ).pack(side="left", padx=(0, 8))

        ctk.CTkButton(
            path_row,
            text="Reset",
            width=80,
            command=lambda: self.capcut_project_dir_setting.set(get_capcut_project_dir()),
        ).pack(side="left")

        install_box = ctk.CTkFrame(content)
        install_box.pack(fill="x", pady=(0, 12))
        ctk.CTkLabel(
            install_box, text="Thư mục cài CapCut",
            font=ctk.CTkFont(size=14, weight="bold"), anchor="w",
        ).pack(fill="x", padx=16, pady=(13, 5))
        ctk.CTkLabel(
            install_box,
            text="Chọn thư mục chứa các phiên bản để mở bản mới nhất. Reset để tìm lại tự động.",
            wraplength=540, anchor="w", justify="left", text_color="gray75",
        ).pack(fill="x", padx=16, pady=(0, 8))
        install_row = ctk.CTkFrame(install_box, fg_color="transparent")
        install_row.pack(fill="x", padx=16, pady=(0, 13))
        ctk.CTkEntry(
            install_row, textvariable=self.capcut_install_dir_setting,
            placeholder_text="Tự động tìm CapCut",
        ).pack(side="left", fill="x", expand=True, padx=(0, 8))

        def browse_install_dir():
            selected = filedialog.askdirectory(
                title="Chọn thư mục cài CapCut",
                initialdir=self.capcut_install_dir_setting.get() or os.environ.get("LOCALAPPDATA"),
                parent=popup,
            )
            if selected:
                self.capcut_install_dir_setting.set(selected)

        ctk.CTkButton(
            install_row, text="Chọn", width=70, command=browse_install_dir,
        ).pack(side="left", padx=(0, 8))

        def reset_install_dir():
            detected = self.detect_capcut_install_dir()
            self.capcut_install_dir_setting.set(detected)
            if not detected:
                messagebox.showwarning(
                    "CapCut", "Không tự tìm thấy CapCut. Hãy chọn thư mục cài CapCut.", parent=popup,
                )

        ctk.CTkButton(
            install_row, text="Reset", width=80, command=reset_install_dir,
        ).pack(side="left")

        video_box = ctk.CTkFrame(content)
        video_box.pack(fill="x", pady=(0, 12))
        trim_checked = ctk.BooleanVar(
            value=self.long_video_setting.get() == "trim"
        )
        speed_up_checked = ctk.BooleanVar(
            value=self.long_video_setting.get() == "speed_up"
        )

        def select_long_video_mode(mode):
            self.long_video_setting.set(mode)
            trim_checked.set(mode == "trim")
            speed_up_checked.set(mode == "speed_up")

        ctk.CTkLabel(
            video_box,
            text="Xử lý khi video dài hơn thời lượng audio của scene",
            font=ctk.CTkFont(size=14, weight="bold"),
            anchor="w",
        ).pack(fill="x", padx=16, pady=(13, 7))
        ctk.CTkCheckBox(
            video_box,
            text="Cắt ngắn",
            variable=trim_checked,
            command=lambda: select_long_video_mode("trim"),
        ).pack(anchor="w", padx=18, pady=5)
        ctk.CTkCheckBox(
            video_box,
            text="Tua nhanh video cho khớp thời gian audio",
            variable=speed_up_checked,
            command=lambda: select_long_video_mode("speed_up"),
        ).pack(anchor="w", padx=18, pady=(5, 13))

        video_keyframe_box = ctk.CTkFrame(content)
        video_keyframe_box.pack(fill="x", pady=(0, 12))
        video_keyframe_yes = ctk.BooleanVar(
            value=self.video_keyframe_setting.get() == "yes"
        )
        video_keyframe_no = ctk.BooleanVar(
            value=self.video_keyframe_setting.get() != "yes"
        )

        def select_video_keyframes(value):
            self.video_keyframe_setting.set(value)
            video_keyframe_yes.set(value == "yes")
            video_keyframe_no.set(value == "no")

        ctk.CTkLabel(
            video_keyframe_box,
            text="Áp dụng keyframe cho video",
            font=ctk.CTkFont(size=14, weight="bold"),
            anchor="w",
        ).pack(fill="x", padx=16, pady=(13, 7))
        ctk.CTkCheckBox(
            video_keyframe_box,
            text="Có",
            variable=video_keyframe_yes,
            command=lambda: select_video_keyframes("yes"),
        ).pack(anchor="w", padx=18, pady=5)
        ctk.CTkCheckBox(
            video_keyframe_box,
            text="Không",
            variable=video_keyframe_no,
            command=lambda: select_video_keyframes("no"),
        ).pack(anchor="w", padx=18, pady=(5, 13))

        button_row = ctk.CTkFrame(content, fg_color="transparent")
        button_row.pack(fill="x", pady=(3, 0))
        def save_and_close():
            project_dir = self.capcut_project_dir_setting.get().strip()
            if not project_dir:
                messagebox.showerror(
                    "Lỗi",
                    "Vui lòng nhập vị trí lưu dự án CapCut.",
                    parent=popup,
                )
                return
            try:
                install_dir = self.capcut_install_dir_setting.get().strip()
                if install_dir:
                    from capcut_batch_engine import find_capcut_executable
                    find_capcut_executable(install_dir=install_dir)
                self.save_app_settings()
            except (OSError, RuntimeError) as exc:
                messagebox.showerror(
                    "Lỗi",
                    f"Không thể lưu cài đặt:\n{exc}",
                    parent=popup,
                )
                return
            popup.destroy()

        ctk.CTkButton(
            button_row,
            text="ĐÓNG",
            width=120,
            fg_color="gray35",
            hover_color="gray28",
            command=popup.destroy,
        ).pack(side="right", padx=(8, 0))
        ctk.CTkButton(
            button_row,
            text="LƯU CÀI ĐẶT",
            width=145,
            command=save_and_close,
        ).pack(side="right")

        popup.after(100, popup.focus_force)

    def refresh_license_button(self):
        status = self.license_manager.status(update_trial=False)
        if status["licensed"]:
            self.license_btn.configure(fg_color="#2E8B57", hover_color="#256F46")
        elif status["allowed"]:
            self.license_btn.configure(fg_color="#B7791F", hover_color="#946318")
        else:
            self.license_btn.configure(fg_color="#B23A3A", hover_color="#8F2E2E")

    def require_trial_consent(self):
        status = self.license_manager.status(update_trial=False)
        if status["licensed"] or status["state"] != "not_started":
            return

        popup = ctk.CTkToplevel(self)
        popup.title("Kích hoạt dùng thử AutoCapCut")
        popup.geometry("460x220")
        popup.resizable(False, False)
        popup.transient(self)
        popup.grab_set()

        ctk.CTkLabel(
            popup,
            text="KÍCH HOẠT DÙNG THỬ",
            font=ctk.CTkFont(size=19, weight="bold"),
        ).pack(pady=(28, 14))
        ctk.CTkLabel(
            popup,
            text=(
                "Bạn được dùng thử AutoCapCut trong 24 giờ.\n"
                "Thời gian chỉ bắt đầu tính sau khi bạn bấm OK."
            ),
            justify="center",
            text_color="gray75",
        ).pack(pady=5)

        def confirm_trial():
            trial_status = self.license_manager.start_trial()
            if not trial_status["allowed"]:
                messagebox.showerror(
                    "Lỗi",
                    trial_status["message"],
                    parent=popup,
                )
                return
            popup.grab_release()
            popup.destroy()
            self.refresh_license_button()

        ctk.CTkButton(
            popup,
            text="OK",
            width=130,
            height=38,
            font=ctk.CTkFont(size=14, weight="bold"),
            command=confirm_trial,
        ).pack(pady=18)

        def close_application():
            try:
                popup.grab_release()
            except Exception:
                pass
            self._close_application()

        # User có thể thoát ứng dụng, nhưng không thể đóng riêng
        # popup để truy cập tool mà chưa chấp nhận bắt đầu trial.
        popup.protocol("WM_DELETE_WINDOW", close_application)
        popup.bind("<Escape>", lambda _event: "break")
        popup.after(100, popup.focus_force)

    def open_license_popup(self):
        if self._license_popup is not None and self._license_popup.winfo_exists():
            self._license_popup.focus_force()
            return

        popup = ctk.CTkToplevel(self)
        self._license_popup = popup
        popup.title("Kích hoạt AutoCapCut")
        popup.geometry("680x700")
        popup.minsize(620, 600)
        popup.resizable(True, True)
        popup.transient(self)
        popup.grab_set()
        popup.grid_columnconfigure(0, weight=1)

        ctk.CTkLabel(
            popup,
            text="KÍCH HOẠT AUTOCAPCUT",
            font=ctk.CTkFont(size=18, weight="bold")
        ).grid(row=0, column=0, pady=(18, 8))

        status_label = ctk.CTkLabel(popup, text="", text_color="gray70")
        status_label.grid(row=1, column=0, pady=(0, 8))

        hwid_row = ctk.CTkFrame(popup, fg_color="transparent")
        hwid_row.grid(row=2, column=0, sticky="ew", padx=20, pady=5)
        hwid_row.grid_columnconfigure(1, weight=1)
        ctk.CTkLabel(hwid_row, text="User ID:", width=75, anchor="w").pack(side="left")
        hwid_entry = ctk.CTkEntry(hwid_row)
        hwid_entry.pack(side="left", fill="x", expand=True, padx=(0, 7))
        hwid_entry.insert(0, self.license_manager.hwid)
        hwid_entry.configure(state="readonly")

        def copy_hwid():
            popup.clipboard_clear()
            popup.clipboard_append(self.license_manager.hwid)
            status_label.configure(text="Đã copy User ID.", text_color="#5FB878")

        ctk.CTkButton(hwid_row, text="Copy", width=65, command=copy_hwid).pack(side="right")

        payment_description = ctk.CTkLabel(
            popup,
            text="Thanh toán tự động và nhận key vĩnh viễn theo User ID này.",
            text_color="gray65",
            anchor="center",
            justify="center",
            wraplength=560,
        )
        payment_description.grid(
            row=3, column=0, sticky="ew", padx=20, pady=(0, 8)
        )

        # Gộp lời kêu gọi vào nút để tổng số dòng và chiều cao popup không đổi.
        # Canvas phía sau tạo nét sáng chạy quanh viền nhằm thu hút sự chú ý.
        purchase_shell = ctk.CTkFrame(
            popup,
            width=445,
            height=72,
            fg_color=popup.cget("fg_color"),
            corner_radius=13,
        )
        purchase_shell.grid(row=4, column=0, pady=(4, 10))
        purchase_shell.grid_propagate(False)
        shell_background = purchase_shell._apply_appearance_mode(
            purchase_shell.cget("fg_color")
        )
        purchase_border = tk.Canvas(
            purchase_shell,
            bd=0,
            highlightthickness=0,
            background=shell_background,
        )
        purchase_border.place(relx=0, rely=0, relwidth=1, relheight=1)
        purchase_border_line = None
        purchase_border_offset = 0
        purchase_border_job = None
        purchase_border_colors = (
            "#00C8FF",
            "#3478FF",
            "#815BFF",
            "#D94DFF",
            "#FF4FA3",
            "#FF6257",
            "#FFB52E",
            "#36D98B",
        )

        def rounded_border_points(width, height, radius=13, margin=2):
            left, top = margin, margin
            right, bottom = width - margin, height - margin
            radius = min(radius, (right - left) / 2, (bottom - top) / 2)
            return [
                left + radius, top,
                right - radius, top,
                right, top,
                right, top + radius,
                right, bottom - radius,
                right, bottom,
                right - radius, bottom,
                left + radius, bottom,
                left, bottom,
                left, bottom - radius,
                left, top + radius,
                left, top,
                left + radius, top,
            ]

        def redraw_purchase_border(event=None):
            nonlocal purchase_border_line
            width = max(10, int(purchase_border.winfo_width()))
            height = max(10, int(purchase_border.winfo_height()))
            purchase_border.delete("all")
            purchase_border.create_line(
                rounded_border_points(width, height),
                fill="#174F78",
                width=4,
                smooth=True,
                splinesteps=18,
                joinstyle="round",
            )
            purchase_border_line = purchase_border.create_line(
                rounded_border_points(width, height),
                fill=purchase_border_colors[
                    (purchase_border_offset // 4) % len(purchase_border_colors)
                ],
                width=3,
                dash=(18, 18),
                dashoffset=purchase_border_offset,
                smooth=True,
                splinesteps=18,
                joinstyle="round",
            )

        def animate_purchase_border():
            nonlocal purchase_border_offset, purchase_border_job
            if not popup.winfo_exists():
                purchase_border_job = None
                return
            purchase_border_offset = (purchase_border_offset + 2) % 72
            color_index = (
                purchase_border_offset // 4
            ) % len(purchase_border_colors)
            active_color = purchase_border_colors[color_index]
            if purchase_border_line is not None:
                try:
                    purchase_border.itemconfigure(
                        purchase_border_line,
                        dashoffset=purchase_border_offset,
                        fill=active_color,
                    )
                    purchase_button.configure(border_color=active_color)
                except tk.TclError:
                    purchase_border_job = None
                    return
            purchase_border_job = popup.after(55, animate_purchase_border)

        purchase_border.bind("<Configure>", redraw_purchase_border)
        purchase_button = ctk.CTkButton(
            purchase_shell,
            text=(
                f"MUA VĨNH VIỄN · {PRICE_LIFETIME:,} VNĐ\n"
                "Nhấn vào đây để chuyển khoản và kích hoạt ngay"
            ).replace(",", "."),
            width=433,
            height=60,
            corner_radius=10,
            border_width=3,
            border_color=purchase_border_colors[0],
            font=ctk.CTkFont(size=14, weight="bold"),
        )
        purchase_button.place(relx=0.5, rely=0.5, anchor="center")
        purchase_border_job = popup.after(100, animate_purchase_border)

        # Reserve enough room for the QR image, bank details, and payment note.
        # Without this, the expandable row can shrink and the license textbox
        # is drawn over the payment information on smaller screens.
        payment_frame = ctk.CTkFrame(popup, height=285)
        payment_frame.grid(row=6, column=0, sticky="nsew", padx=20, pady=(0, 10))
        payment_frame.grid_columnconfigure(0, weight=1)
        payment_frame.grid_propagate(False)
        qr_label = ctk.CTkLabel(
            payment_frame,
            text="QR thanh toán sẽ xuất hiện tại đây",
            text_color="gray60",
        )
        qr_label.grid(row=0, column=0, padx=10, pady=10)
        payment_info_var = ctk.StringVar(value="")
        ctk.CTkLabel(
            payment_frame,
            textvariable=payment_info_var,
            justify="center",
        ).grid(row=1, column=0, padx=10, pady=(0, 10))
        payment_frame.grid_remove()

        license_box = ctk.CTkTextbox(
            popup,
            height=95,
            wrap="word",
            border_width=2,
            border_color="#2B83C6",
            activate_scrollbars=False,
        )
        license_box.grid(row=7, column=0, sticky="ew", padx=20, pady=5)
        stored_token = self.license_manager.get_stored_token()
        if stored_token:
            license_box.insert("1.0", stored_token)

        def activate_license():
            token = license_box.get("1.0", "end").strip()
            if not token:
                messagebox.showerror("Lỗi", "Vui lòng dán license vào ô bên trên.", parent=popup)
                return
            ok, message = self.license_manager.activate(token)
            if not ok:
                status_label.configure(text=message, text_color="#E16B6B")
                return
            self.refresh_license_button()
            status_label.configure(text=message, text_color="#5FB878")
            messagebox.showinfo("Thành công", message, parent=popup)
            purchase_shell.grid_remove()

        button_row = ctk.CTkFrame(popup, fg_color="transparent")
        button_row.grid(row=8, column=0, pady=(10, 18))
        ctk.CTkButton(
            button_row,
            text="KÍCH HOẠT",
            width=150,
            command=activate_license,
        ).pack(side="left", padx=6)

        def deactivate_local_license():
            if not messagebox.askyesno(
                "Hủy kích hoạt",
                "Bạn muốn hủy kích hoạt license trên máy này?\n\n"
                "Key đã cấp vẫn còn hiệu lực và có thể nhập lại sau.",
                parent=popup,
            ):
                return
            ok, message = self.license_manager.deactivate_local()
            status_label.configure(
                text=message,
                text_color="#5FB878" if ok else "#E16B6B",
            )
            if ok:
                license_box.delete("1.0", "end")
                purchase_button.configure(state="normal")
                purchase_shell.grid()
                deactivate_button.configure(state="disabled")
                self.refresh_license_button()

        deactivate_button = ctk.CTkButton(
            button_row,
            text="HỦY KÍCH HOẠT",
            width=135,
            fg_color="#9E3B3B",
            hover_color="#7F3030",
            command=deactivate_local_license,
        )
        deactivate_button.pack(side="left", padx=6)

        support_frame = ctk.CTkFrame(popup, fg_color="transparent")
        support_frame.grid(row=9, column=0, sticky="w", padx=24, pady=(14, 18))
        support_title = ctk.CTkLabel(
            support_frame,
            text="HỖ TRỢ & HƯỚNG DẪN",
            font=ctk.CTkFont(size=14, weight="bold"),
            text_color="#D8D8D8",
        )
        support_title.pack(anchor="w", pady=(0, 5))
        support_message = ctk.CTkLabel(
            support_frame,
            text=(
                "Liên hệ Admin 0937 659 552 nếu cần hỗ trợ sử dụng, góp ý, "
                "thanh toán lỗi hoặc không kích hoạt được."
            ),
            justify="left",
            anchor="w",
            text_color="gray70",
            font=ctk.CTkFont(size=15),
            wraplength=520,
        )
        support_message.pack(anchor="w", fill="x")
        zalo_link_row = ctk.CTkFrame(support_frame, fg_color="transparent")
        zalo_link_row.pack(anchor="w", pady=(5, 0))
        zalo_icon = ctk.CTkLabel(
            zalo_link_row,
            text="Z",
            width=22,
            height=22,
            corner_radius=6,
            fg_color="#0068FF",
            text_color="white",
            cursor="hand2",
            font=ctk.CTkFont(size=13, weight="bold"),
        )
        zalo_icon.pack(side="left", padx=(0, 7))
        zalo_group_link = ctk.CTkLabel(
            zalo_link_row,
            text="Tham gia Group Zalo AutoCapCut",
            text_color="#56A9E8",
            cursor="hand2",
            font=ctk.CTkFont(size=15),
        )
        zalo_group_link.pack(side="left")
        open_zalo_group = lambda _event: __import__("webbrowser").open(
            "https://beacons.ai/autocapcut"
        )
        zalo_icon.bind("<Button-1>", open_zalo_group)
        zalo_group_link.bind("<Button-1>", open_zalo_group)

        youtube_link_row = ctk.CTkFrame(support_frame, fg_color="transparent")
        youtube_link_row.pack(anchor="w", pady=(5, 0))
        youtube_icon = ctk.CTkLabel(
            youtube_link_row,
            text="▶",
            width=25,
            height=19,
            corner_radius=5,
            fg_color="#FF0033",
            text_color="white",
            cursor="hand2",
            font=ctk.CTkFont(size=11, weight="bold"),
        )
        youtube_icon.pack(side="left", padx=(0, 7))
        help_link = ctk.CTkLabel(
            youtube_link_row,
            text="Xem hướng dẫn sử dụng trên YouTube",
            text_color="#56A9E8",
            cursor="hand2",
            font=ctk.CTkFont(size=15),
        )
        help_link.pack(side="left")
        open_youtube_help = lambda _event: __import__("webbrowser").open(
            "https://www.youtube.com/watch?v=MVETExI5rgI&t=6s"
        )
        youtube_icon.bind("<Button-1>", open_youtube_help)
        help_link.bind("<Button-1>", open_youtube_help)

        normal_license_height = 700
        payment_panel_height = 285

        def resize_license_popup(show_payment=False):
            height = normal_license_height
            if show_payment:
                height += payment_panel_height
            popup.geometry(f"680x{height}")

        def clear_payment_panel():
            """Remove an old QR so it cannot be paid after its order expires."""
            self._license_qr_image = None
            qr_label.configure(
                image=None,
                text="QR thanh toán sẽ xuất hiện tại đây",
            )
            payment_info_var.set("")
            payment_frame.grid_remove()
            resize_license_popup(False)

        def expire_payment_order():
            clear_payment_panel()
            purchase_button.configure(state="normal")
            purchase_shell.grid()
            status_label.configure(
                text="Mã thanh toán đã hết hạn. Hãy bấm nút mua để tạo mã QR mới.",
                text_color="#E16B6B",
            )

        def show_error(message):
            if not popup.winfo_exists():
                return
            status_label.configure(text=message, text_color="#E16B6B")
            purchase_button.configure(state="normal")

        def finish_paid(token, recovered=False):
            if not popup.winfo_exists():
                return
            license_box.delete("1.0", "end")
            license_box.insert("1.0", token)
            ok, message = self.license_manager.activate(token)
            if not ok:
                show_error("Đã nhận key nhưng kích hoạt thất bại: " + message)
                return
            self.refresh_license_button()
            purchase_shell.grid_remove()
            clear_payment_panel()
            support_frame.grid()
            license_box.configure(height=95)
            prefix = "Đã khôi phục key cũ. " if recovered else "Thanh toán thành công. "
            status_label.configure(text=prefix + message, text_color="#5FB878")
            messagebox.showinfo(
                "Thành công",
                prefix + message + "\n\nKey đã được tự động điền vào ô license.",
                parent=popup,
            )

        def poll_order(order_id, poll_token):
            def worker():
                result = self.payment_client.poll_order(order_id, poll_token)

                def finish():
                    if not popup.winfo_exists():
                        return
                    if result.get("status") == "paid" and result.get("license"):
                        finish_paid(str(result["license"]))
                        return
                    if result.get("status") == "expired":
                        expire_payment_order()
                        return
                    if result.get("error") == "server_unavailable":
                        status_label.configure(
                            text="Mất kết nối tạm thời, đang thử lại...",
                            text_color="#E6A94B",
                        )
                        self._license_poll_after = popup.after(
                            5000,
                            lambda: poll_order(order_id, poll_token),
                        )
                        return
                    if result.get("error"):
                        show_error("Không kiểm tra được thanh toán: " + str(result["error"]))
                        return
                    self._license_poll_after = popup.after(
                        3000,
                        lambda: poll_order(order_id, poll_token),
                    )

                popup.after(0, finish)

            threading.Thread(target=worker, daemon=True).start()

        def show_qr(order):
            try:
                import io
                import urllib.request
                from PIL import Image

                with urllib.request.urlopen(str(order["qr_url"]), timeout=15) as response:
                    image_bytes = response.read()
                image = Image.open(io.BytesIO(image_bytes)).convert("RGB")
                image.thumbnail((210, 210))
            except Exception as exc:
                popup.after(0, lambda: show_error(f"Không tải được QR: {exc}"))
                return

            def apply_qr():
                if not popup.winfo_exists():
                    return
                self._license_qr_image = ctk.CTkImage(
                    light_image=image,
                    dark_image=image,
                    size=image.size,
                )
                qr_label.configure(image=self._license_qr_image, text="")
                bank = order.get("bank") or {}
                payment_info_var.set(
                    (
                        f"MB Bank · {bank.get('account', '')} · {bank.get('account_name', '')}\n"
                        f"Số tiền: {int(order['amount']):,} VNĐ · Nội dung: {order['payment_code']}\n"
                        "Lưu ý: Không thay đổi nội dung chuyển khoản"
                    ).replace(",", ".")
                )
                popup.after_idle(lambda: resize_license_popup(True))
                status_label.configure(
                    text="Đang chờ ngân hàng xác nhận thanh toán...",
                    text_color="#E6A94B",
                )
                poll_order(str(order["order_id"]), str(order["poll_token"]))

            popup.after(0, apply_qr)

        def create_order():
            if not self.payment_client.configured:
                show_error("Máy chủ thanh toán chưa được cấu hình.")
                return
            purchase_button.configure(state="disabled")
            payment_frame.grid()
            popup.grid_rowconfigure(6, weight=0)
            support_frame.grid()
            license_box.configure(height=95)
            resize_license_popup(True)
            qr_label.configure(image=None, text="Đang tạo mã QR...")
            payment_info_var.set("")
            status_label.configure(text="Đang tạo đơn hàng...", text_color="gray70")

            def worker():
                order = self.payment_client.create_order(self.license_manager.hwid)

                def finish():
                    if not popup.winfo_exists():
                        return
                    if order.get("status") == "paid" and order.get("license"):
                        finish_paid(str(order["license"]), recovered=bool(order.get("recovered")))
                        return
                    if order.get("error"):
                        show_error("Không tạo được đơn: " + str(order["error"]))
                        return
                    threading.Thread(target=show_qr, args=(order,), daemon=True).start()

                popup.after(0, finish)

            threading.Thread(target=worker, daemon=True).start()

        purchase_button.configure(command=create_order)

        status = self.license_manager.status(update_trial=False)
        status_label.configure(
            text=status["message"],
            text_color="#5FB878" if status["licensed"] else ("#E6A94B" if status["allowed"] else "#E16B6B")
        )
        if status["licensed"]:
            purchase_shell.grid_remove()
        else:
            deactivate_button.configure(state="disabled")

        def close_popup():
            nonlocal purchase_border_job
            if purchase_border_job is not None:
                try:
                    popup.after_cancel(purchase_border_job)
                except Exception:
                    pass
                purchase_border_job = None
            if self._license_poll_after is not None:
                try:
                    popup.after_cancel(self._license_poll_after)
                except Exception:
                    pass
                self._license_poll_after = None
            self._license_popup = None
            try:
                popup.grab_release()
            except Exception:
                pass
            popup.destroy()

        popup.protocol("WM_DELETE_WINDOW", close_popup)
        popup.after_idle(lambda: resize_license_popup(False))
        popup.after(100, popup.focus_force)
    def _hide_zoom_validation_tooltip(self):
        tooltip = getattr(self, "_zoom_validation_tooltip", None)
        self._zoom_validation_tooltip = None
        if tooltip is not None:
            try:
                tooltip.destroy()
            except tk.TclError:
                pass

    def _show_zoom_validation_tooltip(self, entry, message):
        self._hide_zoom_validation_tooltip()
        tooltip = tk.Toplevel(self)
        tooltip.withdraw()
        tooltip.overrideredirect(True)
        tooltip.attributes("-topmost", True)
        label = tk.Label(
            tooltip,
            text=message,
            bg="#4A1F1F",
            fg="#FFD7D7",
            padx=8,
            pady=4,
            font=("Segoe UI", 9),
        )
        label.pack()
        tooltip.update_idletasks()
        x = entry.winfo_rootx()
        y = entry.winfo_rooty() + entry.winfo_height() + 4
        tooltip.geometry(f"+{x}+{y}")
        self._zoom_validation_tooltip = tooltip
        tooltip.deiconify()
        tooltip.lift()

        def expire():
            if self._zoom_validation_tooltip is tooltip:
                self._hide_zoom_validation_tooltip()

        self.after(3000, expire)
    def _hide_zoom_hint_tooltip(self):
        tooltip = getattr(self, "_zoom_hint_tooltip", None)
        self._zoom_hint_tooltip = None
        if tooltip is not None:
            try:
                tooltip.destroy()
            except tk.TclError:
                pass

    def _show_zoom_hint_tooltip(self, entry, message):
        self._hide_zoom_hint_tooltip()
        tooltip = tk.Toplevel(self)
        tooltip.withdraw()
        tooltip.overrideredirect(True)
        tooltip.attributes("-topmost", True)
        label = tk.Label(
            tooltip,
            text=message,
            justify="left",
            bg="#303030",
            fg="#F2F2F2",
            padx=9,
            pady=6,
            font=("Segoe UI", 9),
        )
        label.pack()
        tooltip.update_idletasks()
        x = entry.winfo_rootx()
        y = entry.winfo_rooty() + entry.winfo_height() + 4
        tooltip.geometry(f"+{x}+{y}")
        self._zoom_hint_tooltip = tooltip
        tooltip.deiconify()
        tooltip.lift()


    def _clear_zoom_entry_errors(self, mode):
        info = self.motion_zoom_entries.get(mode, {})
        for side in ("left", "right"):
            entry = info.get(side)
            default_border = info.get(f"{side}_border")
            if entry is not None and default_border is not None:
                entry.configure(border_color=default_border)
        self._last_motion_error_entry = None
        self._hide_zoom_validation_tooltip()

    def _mark_zoom_entry_error(self, mode, side, message, show_tooltip=False):
        info = self.motion_zoom_entries.get(mode, {})
        entry = info.get(side)
        if entry is not None:
            entry.configure(border_color="#E05A5A")
            self._last_motion_error_entry = entry
            if show_tooltip:
                self._show_zoom_validation_tooltip(entry, message)

    def _read_zoom_range(self, mode, mark_error=False, show_tooltip=False):
        fixed_raw = self.motion_amount_vars[mode].get().strip().replace(",", ".")
        optional_raw = (
            self.motion_optional_amount_vars[mode].get().strip().replace(",", ".")
        )
        required_side = "right" if mode == "zoom_in" else "left"
        optional_side = "left" if mode == "zoom_in" else "right"

        if not fixed_raw:
            message = (
                "Vui lòng nhập mức zoom ở ô bên phải."
                if mode == "zoom_in"
                else "Vui lòng nhập mức zoom ở ô bên trái."
            )
            if mark_error:
                self._mark_zoom_entry_error(
                    mode, required_side, message, show_tooltip
                )
            raise ValueError(message)
        try:
            fixed_value = float(fixed_raw)
        except ValueError as exc:
            message = "Chỉ được nhập số."
            if mark_error:
                self._mark_zoom_entry_error(
                    mode, required_side, message, show_tooltip
                )
            raise ValueError(message) from exc
        if fixed_value <= 0:
            message = "Giá trị zoom phải lớn hơn 0."
            if mark_error:
                self._mark_zoom_entry_error(
                    mode, required_side, message, show_tooltip
                )
            raise ValueError(message)

        if not optional_raw:
            self._clear_zoom_entry_errors(mode)
            return {"min": fixed_value, "max": fixed_value}

        try:
            optional_value = float(optional_raw)
        except ValueError as exc:
            message = "Chỉ được nhập số."
            if mark_error:
                self._mark_zoom_entry_error(
                    mode, optional_side, message, show_tooltip
                )
            raise ValueError(message) from exc
        if optional_value <= 0:
            message = "Giá trị zoom phải lớn hơn 0."
            if mark_error:
                self._mark_zoom_entry_error(
                    mode, optional_side, message, show_tooltip
                )
            raise ValueError(message)

        if mode == "zoom_in" and optional_value > fixed_value:
            message = "Giá trị bên trái phải nhỏ hơn hoặc bằng bên phải."
            if mark_error:
                self._mark_zoom_entry_error(
                    mode, optional_side, message, show_tooltip
                )
            raise ValueError(message)
        if mode == "zoom_out" and fixed_value < optional_value:
            message = "Giá trị bên trái phải lớn hơn hoặc bằng bên phải."
            if mark_error:
                self._mark_zoom_entry_error(
                    mode, required_side, message, show_tooltip
                )
            raise ValueError(message)

        self._clear_zoom_entry_errors(mode)
        return {
            "min": min(fixed_value, optional_value),
            "max": max(fixed_value, optional_value),
        }

    def _validate_zoom_on_focus_out(self, mode):
        try:
            self._read_zoom_range(mode, mark_error=True, show_tooltip=True)
        except ValueError:
            pass

    def _validate_zoom_while_typing(self, mode):
        try:
            self._read_zoom_range(mode)
        except ValueError:
            return
        self._clear_zoom_entry_errors(mode)


    def create_motion_options(self, parent, font=None):
        box = ctk.CTkFrame(parent)
        self.motion_box = box
        box.pack(fill="x", pady=5, padx=10)

        top = ctk.CTkFrame(box, fg_color="transparent")
        top.pack(fill="x", padx=10, pady=(5, 2))
        ctk.CTkLabel(
            top,
            text="Auto keyframe chuyển động cho ảnh/video",
            font=font,
        ).pack(side="left")
        ctk.CTkCheckBox(
            top,
            text="Trộn ngẫu nhiên Keyframe",
            variable=self.motion_random,
            width=210,
        ).pack(side="right")

        grid = ctk.CTkFrame(box, fg_color="transparent")
        grid.pack(fill="x", padx=6, pady=(0, 5))
        zoom_items = [
            ("zoom_in", "Zoom in"),
            ("zoom_out", "Zoom out"),
        ]
        pan_items = [
            ("pan_up", "Pan up"),
            ("pan_down", "Pan down"),
            ("pan_left", "Pan left"),
            ("pan_right", "Pan right"),
        ]
        for idx, (key, label) in enumerate(zoom_items):
            cell = ctk.CTkFrame(grid, fg_color="transparent")
            cell.grid(row=0, column=idx, sticky="ew", padx=3, pady=2)
            grid.grid_columnconfigure(idx, weight=1)
            ctk.CTkCheckBox(
                cell,
                text=label,
                variable=self.motion_mode_vars[key],
                width=95
            ).pack(side="left")
            if key == "zoom_in":
                left_var = self.motion_optional_amount_vars[key]
                right_var = self.motion_amount_vars[key]
            else:
                left_var = self.motion_amount_vars[key]
                right_var = self.motion_optional_amount_vars[key]

            ctk.CTkLabel(
                cell,
                text="X",
                text_color=box.cget("fg_color"),
            ).pack(side="left", padx=(3, 1))
            left_entry = ctk.CTkEntry(
                cell,
                textvariable=left_var,
                width=52,
                font=font,
            )
            left_entry.pack(side="left")
            ctk.CTkLabel(
                cell, text="–", text_color="gray65"
            ).pack(side="left", padx=(4, 1))
            right_entry = ctk.CTkEntry(
                cell,
                textvariable=right_var,
                width=52,
                font=font,
            )
            right_entry.pack(side="left")
            ctk.CTkLabel(
                cell, text="%", text_color="gray65"
            ).pack(side="left", padx=(2, 0))

            self.motion_zoom_entries[key] = {
                "left": left_entry,
                "right": right_entry,
                "left_border": left_entry.cget("border_color"),
                "right_border": right_entry.cget("border_color"),
            }
            for entry in (left_entry, right_entry):
                entry.bind(
                    "<FocusIn>",
                    lambda _event: self._hide_zoom_validation_tooltip(),
                    add="+",
                )
                entry.bind(
                    "<FocusOut>",
                    lambda _event, mode=key: self._validate_zoom_on_focus_out(mode),
                    add="+",
                )
                entry.bind(
                    "<KeyRelease>",
                    lambda _event, mode=key: self._validate_zoom_while_typing(mode),
                    add="+",
                )
            if key == "zoom_in":
                hint_entry = left_entry
                hint_text = (
                    "Để trống ô này: tất cả media dùng mức Zoom in ở ô thứ hai.\n"
                    "Muốn Zoom in ngẫu nhiên: nhập giới hạn vào cả hai ô."
                )
            else:
                hint_entry = right_entry
                hint_text = (
                    "Để trống ô này: tất cả media dùng mức Zoom out ở ô thứ nhất.\n"
                    "Muốn Zoom out ngẫu nhiên: nhập giới hạn vào cả hai ô."
                )
            hint_entry.bind(
                "<Enter>",
                lambda _event, entry=hint_entry, message=hint_text:
                    self._show_zoom_hint_tooltip(entry, message),
                add="+",
            )
            hint_entry.bind(
                "<Leave>",
                lambda _event: self._hide_zoom_hint_tooltip(),
                add="+",
            )


        for idx, (key, label) in enumerate(pan_items):
            cell = ctk.CTkFrame(grid, fg_color="transparent")
            cell.grid(row=1 + idx // 2, column=idx % 2, sticky="ew", padx=3, pady=2)
            grid.grid_columnconfigure(idx % 2, weight=1)
            ctk.CTkCheckBox(
                cell,
                text=label,
                variable=self.motion_mode_vars[key],
                width=95
            ).pack(side="left")
            ctk.CTkLabel(cell, text="X", text_color="gray65").pack(side="left", padx=(3, 1))
            ctk.CTkEntry(cell, textvariable=self.pan_x_vars[key], width=52, font=font).pack(side="left")
            ctk.CTkLabel(cell, text="Y", text_color="gray65").pack(side="left", padx=(4, 1))
            ctk.CTkEntry(cell, textvariable=self.pan_y_vars[key], width=52, font=font).pack(side="left")
            ctk.CTkLabel(cell, text="Scale", text_color="gray65").pack(side="left", padx=(4, 1))
            ctk.CTkEntry(cell, textvariable=self.pan_scale_vars[key], width=52, font=font).pack(side="left")
            ctk.CTkLabel(cell, text="%", text_color="gray65").pack(side="left", padx=(2, 0))

    @staticmethod
    def number_scene_lines(text):
        """Đánh số lại các dòng scene, kể cả khi nội dung đã có số thứ tự."""
        numbered_lines = []
        for line in text.splitlines():
            line = line.strip()
            if not line:
                continue
            line = re.sub(
                r'^\s*(?:scene\s*)?\d+\s*[\.\):\-]\s*',
                '',
                line,
                flags=re.IGNORECASE
            )
            if line:
                numbered_lines.append(f"{len(numbered_lines) + 1}. {line}")
        return "\n".join(numbered_lines)

    def create_scenes_input(self, parent, font=None):
        f = ctk.CTkFrame(parent, fg_color="transparent")
        f.pack(fill="x", pady=5, padx=10)

        label_column = ctk.CTkFrame(f, fg_color="transparent", width=150)
        label_column.pack(side="left", anchor="n")
        ctk.CTkLabel(
            label_column, text="Scenes (Phân cảnh):", width=150, anchor="w"
        ).pack(anchor="w", pady=(0, 2))

        sample_prompt = (
            "Chia đoạn văn dưới đây thành từng câu, mỗi câu một dòng, "
            "không thay đổi nội dung, đánh số thứ tự 1. 2. 3. 4. .. "
            "định dạng file txt."
        )
        tooltip_state = {
            "window": None,
            "watch_job": None,
            "creating": False,
        }

        def copy_sample_prompt():
            self.clipboard_clear()
            self.clipboard_append(sample_prompt)
            self.update_idletasks()
            copy_prompt_btn.configure(text="✓")
            self.after(1200, lambda: copy_prompt_btn.configure(text="Copy"))

        def pointer_is_over_copy_button():
            pointer_x, pointer_y = self.winfo_pointerxy()
            left = copy_prompt_btn.winfo_rootx()
            top = copy_prompt_btn.winfo_rooty()
            return (
                left <= pointer_x < left + copy_prompt_btn.winfo_width()
                and top <= pointer_y < top + copy_prompt_btn.winfo_height()
            )

        def hide_prompt_tooltip(_event=None):
            watch_job = tooltip_state["watch_job"]
            tooltip_state["watch_job"] = None
            if watch_job is not None:
                try:
                    self.after_cancel(watch_job)
                except (RuntimeError, tk.TclError):
                    pass

            tooltip = tooltip_state["window"]
            tooltip_state["window"] = None
            tooltip_state["creating"] = False
            if tooltip is not None:
                try:
                    tooltip.destroy()
                except tk.TclError:
                    pass

        def monitor_prompt_tooltip():
            tooltip_state["watch_job"] = None
            tooltip = tooltip_state["window"]
            if tooltip is None:
                return
            try:
                tooltip_exists = bool(tooltip.winfo_exists())
            except tk.TclError:
                tooltip_exists = False
            if not tooltip_exists or not pointer_is_over_copy_button():
                hide_prompt_tooltip()
                return
            tooltip_state["watch_job"] = self.after(60, monitor_prompt_tooltip)

        def show_prompt_tooltip(_event=None):
            if tooltip_state["window"] is not None or tooltip_state["creating"]:
                return
            if not pointer_is_over_copy_button():
                return

            # Set the guard before creating the native window because a CTkButton
            # can emit nested Enter events while its canvas changes hover colour.
            tooltip_state["creating"] = True
            try:
                tooltip = tk.Toplevel(self)
                tooltip.withdraw()
                tooltip.overrideredirect(True)
                tooltip.attributes("-topmost", True)
                tk.Label(
                    tooltip,
                    text="Copy câu lệnh chia dòng này và mở AI lên dán vào kèm kịch bản của bạn",
                    bg="#343638",
                    fg="#f2f2f2",
                    padx=9,
                    pady=5,
                    font=("Segoe UI", 9),
                ).pack()

                left = copy_prompt_btn.winfo_rootx()
                top = copy_prompt_btn.winfo_rooty()
                tooltip.geometry(
                    f"+{left + copy_prompt_btn.winfo_width() + 8}+{top}"
                )
                tooltip_state["window"] = tooltip
                tooltip.bind("<Enter>", hide_prompt_tooltip)
                tooltip.deiconify()
                tooltip.lift()
                tooltip_state["watch_job"] = self.after(
                    60, monitor_prompt_tooltip
                )
            finally:
                tooltip_state["creating"] = False

        copy_prompt_btn = ctk.CTkButton(
            label_column,
            text="Copy",
            width=46,
            height=20,
            font=ctk.CTkFont(size=9, weight="bold"),
            fg_color=("gray78", "gray68"),
            hover_color=("gray70", "gray60"),
            text_color=("gray15", "gray10"),
            border_width=1,
            border_color=("gray60", "gray80"),
            corner_radius=5,
            command=copy_sample_prompt,
        )
        copy_prompt_btn.pack(anchor="w")
        copy_prompt_btn.bind("<Enter>", show_prompt_tooltip)
        copy_prompt_btn.bind("<Leave>", hide_prompt_tooltip)
        self.scenes_text = ctk.CTkTextbox(
            f, height=150, font=ctk.CTkFont(size=14), wrap="word"
        )
        self.scenes_text.pack(side="left", fill="both", expand=True, padx=5)
        self.scenes_placeholder = (
            "Chia kịch bản thành từng câu, mỗi câu một dòng rồi paste vào đây\n"
            "Mỗi dòng không bắt buộc phải là một câu, có thể là vài chữ, nửa đoạn hoặc nhiều câu.\n"
            "Mỗi dòng cần có 1 ảnh hoặc video tương ứng.\n"
            "Tool sẽ tự căn thời gian media theo đúng thời gian đọc nội dung của dòng đó"
        )
        self.scenes_text.insert("1.0", self.scenes_placeholder)
        self.scenes_text.configure(text_color="gray90")
        self.scenes_browse_button = ctk.CTkButton(
            f,
            text="Browse",
            width=80,
            command=self.load_scenes_file
        )
        self.scenes_browse_button.pack(side="left", anchor="n", pady=5)
        self._scenes_browse_normal_style = {
            "fg_color": self.scenes_browse_button.cget("fg_color"),
            "hover_color": self.scenes_browse_button.cget("hover_color"),
            "text_color": self.scenes_browse_button.cget("text_color"),
        }

        self.scenes_text.bind("<Control-v>", self.paste_scenes)
        self.scenes_text.bind("<Control-V>", self.paste_scenes)
        self.scenes_text.bind("<Shift-Insert>", self.paste_scenes)
        self.scenes_text.bind("<Return>", self.add_scene_line)
        self.scenes_text.bind("<KeyRelease>", self.ensure_first_scene_number)
        self.scenes_text.bind("<FocusIn>", self.clear_scenes_placeholder)
        self.scenes_text.bind("<FocusOut>", self.restore_scenes_placeholder)
        self._register_single_file_drop(
            self.scenes_text,
            {".txt"},
            "Scenes TXT",
            self._load_scenes_path,
        )

    def set_scenes_text(self, text):
        self.scenes_text.delete("1.0", "end")
        self.scenes_text.insert("1.0", self.number_scene_lines(text))
        self.scenes_text.configure(text_color=("gray10", "gray90"))

    def clear_scenes_placeholder(self, event=None):
        if self.scenes_text.get("1.0", "end-1c") == self.scenes_placeholder:
            self.scenes_text.delete("1.0", "end")
            self.scenes_text.configure(text_color=("gray10", "gray90"))

    def restore_scenes_placeholder(self, event=None):
        if not self.scenes_text.get("1.0", "end-1c").strip():
            self.scenes_text.delete("1.0", "end")
            self.scenes_text.insert("1.0", self.scenes_placeholder)
            self.scenes_text.configure(text_color="gray90")

    def paste_scenes(self, event=None):
        try:
            self.set_scenes_text(self.clipboard_get())
        except Exception:
            messagebox.showwarning(
                "Không thể dán", "Clipboard hiện không có nội dung văn bản."
            )
        return "break"

    def add_scene_line(self, event=None):
        """Enter tạo một dòng mới với số thứ tự kế tiếp."""
        content = self.number_scene_lines(self.get_scenes_content())
        self.set_scenes_text(content)
        count = len(content.splitlines()) if content else 0
        if count:
            self.scenes_text.insert("end-1c", f"\n{count + 1}. ")
        else:
            self.scenes_text.insert("1.0", "1. ")
        self.scenes_text.mark_set("insert", "end-1c")
        self.scenes_text.see("end")
        return "break"

    def ensure_first_scene_number(self, event=None):
        """Khi nhập tay vào ô trống, tự thêm số 1 cho dòng đầu tiên."""
        if event and event.keysym in {
            "Return", "BackSpace", "Delete", "Left", "Right", "Up", "Down",
            "Home", "End", "Prior", "Next", "Control_L", "Control_R",
            "Shift_L", "Shift_R"
        }:
            return
        text = self.scenes_text.get("1.0", "end-1c")
        if text.strip() and not re.match(
            r'^\s*(?:scene\s*)?\d+\s*[\.\):\-]\s*',
            text,
            flags=re.IGNORECASE
        ):
            self.scenes_text.insert("1.0", "1. ")

    def load_scenes_file(self):
        if len(self.audio_files) > 1:
            self._show_multi_audio_skip_message()
            return
        filepath = filedialog.askopenfilename(
            filetypes=[("Text Files", "*.txt")]
        )
        if not filepath:
            return
        self._load_scenes_path(filepath)

    def _load_scenes_path(self, filepath):
        if len(self.audio_files) > 1:
            self._show_multi_audio_skip_message()
            return
        try:
            with open(filepath, "r", encoding="utf-8-sig") as f:
                self.set_scenes_text(f.read())
        except Exception as e:
            messagebox.showerror("Lỗi", f"Không thể đọc file scenes:\n{e}")

    def get_scenes_content(self):
        content = self.scenes_text.get("1.0", "end").strip()
        return "" if content == self.scenes_placeholder else content

    @staticmethod
    def natural_sort_key(path):
        name = os.path.basename(path).lower()
        return [
            int(part) if part.isdigit() else part
            for part in re.split(r'(\d+)', name)
        ]

    def get_motion_settings(self):
        modes = [
            key for key, var in self.motion_mode_vars.items()
            if var.get()
        ]
        if not modes:
            return {"enabled": False}

        amounts = {}
        zoom_ranges = {}
        pan = {}

        for key in self.motion_amount_vars:
            if key not in modes:
                continue
            try:
                zoom_range = self._read_zoom_range(key, mark_error=True)
            except ValueError as exc:
                label = "Zoom in" if key == "zoom_in" else "Zoom out"
                raise Exception(f"{label}: {exc}") from exc
            zoom_ranges[key] = zoom_range
            amounts[key] = zoom_range["max"]

        for key in self.pan_x_vars:
            if key not in modes:
                continue
            values = {}
            for label, source in [
                ("x", self.pan_x_vars[key]),
                ("y", self.pan_y_vars[key]),
                ("scale", self.pan_scale_vars[key]),
            ]:
                raw = source.get().strip().replace(",", ".")
                try:
                    value = float(raw)
                except ValueError:
                    raise Exception(f"Thông số {label.upper()} của {key} không hợp lệ: {raw}")
                if label == "scale" and value <= 0:
                    raise Exception(f"Scale của {key} phải lớn hơn 0.")
                values[label] = value
            pan[key] = values

        return {
            "enabled": True,
            "random": self.motion_random.get(),
            "apply_to_video": self.video_keyframe_setting.get() == "yes",
            "modes": modes,
            "amounts": amounts,
            "zoom_ranges": zoom_ranges,
            "pan": pan,
        }

    def _selected_transition_keys(self):
        order = ["none", *TRANSITION_PRESETS.keys()]
        return [
            key for key in order
            if key in self.transition_vars and self.transition_vars[key].get()
        ]

    def _transition_dropdown_is_visible(self):
        frame = self.transition_dropdown_frame
        if frame is None:
            return False
        # CTkScrollableFrame delegates place/place_forget to its private outer
        # frame. Its own winfo_manager() remains "grid" even while hidden.
        geometry_widget = getattr(frame, "_parent_frame", frame)
        try:
            return bool(geometry_widget.winfo_manager())
        except tk.TclError:
            return False

    def _scroll_transition_dropdown_only(self, event):
        if not self._transition_dropdown_is_visible():
            return None
        frame = self.transition_dropdown_frame
        geometry_widget = getattr(frame, "_parent_frame", frame)
        if not self._point_inside_widget(
            geometry_widget,
            event.x_root,
            event.y_root,
        ):
            return None
        canvas = getattr(frame, "_parent_canvas", None)
        if canvas is not None and canvas.yview() != (0.0, 1.0):
            steps = -int(event.delta / 6) if event.delta else 0
            if steps:
                canvas.yview_scroll(steps, "units")
        # Stop the outer CTkScrollableFrame's bind_all handler from receiving
        # the same wheel event.
        return "break"

    def _place_dropdown_inside_visible_area(
        self,
        dropdown,
        button,
        maximum_height=360,
    ):
        """Fit a dropdown around its button inside the visible canvas."""
        self.update_idletasks()
        viewport = getattr(self.main_scroll_frame, "_parent_canvas", self)
        available_pixels = None
        try:
            window_top = self.winfo_rooty()
            window_bottom = window_top + self.winfo_height()
            window_left = self.winfo_rootx()
            window_right = window_left + self.winfo_width()
            viewport_left = viewport.winfo_rootx()
            viewport_right = viewport_left + viewport.winfo_width()
            viewport_top = viewport.winfo_rooty()
            viewport_bottom = viewport_top + viewport.winfo_height()
            visible_top = max(0, window_top + 8, viewport_top + 8)
            visible_bottom = min(
                self.winfo_screenheight() - 12,
                window_bottom - 12,
                viewport_bottom - 8,
            )
            visible_left = max(0, window_left + 8, viewport_left + 8)
            visible_right = min(
                self.winfo_screenwidth() - 12,
                window_right - 12,
                viewport_right - 8,
            )
            button_left = button.winfo_rootx()
            button_right = button_left + button.winfo_width()
            desired_width = dropdown._apply_widget_scaling(
                float(dropdown.cget("width"))
            )
            align_left = button_left + desired_width <= visible_right
            if not align_left and button_right - desired_width < visible_left:
                align_left = (
                    visible_right - button_left
                    >= button_right - visible_left
                )
            button_top = button.winfo_rooty()
            button_bottom = button_top + button.winfo_height()
            space_below = max(0, visible_bottom - button_bottom)
            space_above = max(0, button_top - visible_top)
            desired_pixels = dropdown._apply_widget_scaling(maximum_height)
            if space_below >= desired_pixels:
                open_below = True
            elif space_above >= desired_pixels:
                open_below = False
            else:
                open_below = space_below >= space_above
            available_pixels = space_below if open_below else space_above
            fitted_pixels = max(45, min(desired_pixels, available_pixels))
            fitted_height = max(
                45,
                int(round(dropdown._reverse_widget_scaling(fitted_pixels))),
            )
        except (AttributeError, RuntimeError, tk.TclError):
            open_below = True
            align_left = True
            fitted_height = maximum_height

        dropdown.configure(height=fitted_height)
        horizontal_anchor = "w" if align_left else "e"
        horizontal_position = 0 if align_left else 1
        if open_below:
            dropdown.place(
                in_=button,
                relx=horizontal_position,
                rely=1,
                x=0,
                y=0,
                anchor="n" + horizontal_anchor,
            )
        else:
            dropdown.place(
                in_=button,
                relx=horizontal_position,
                rely=0,
                x=0,
                y=0,
                anchor="s" + horizontal_anchor,
            )
        dropdown.lift()
        try:
            dropdown.update_idletasks()
            outer = getattr(dropdown, "_parent_frame", dropdown)
            actual_height = outer.winfo_height()
            if available_pixels is not None and actual_height > available_pixels:
                overflow = actual_height - available_pixels
                corrected_height = max(
                    1,
                    int(round(
                        fitted_height
                        - dropdown._reverse_widget_scaling(overflow)
                    )),
                )
                dropdown.configure(height=corrected_height)
                dropdown.update_idletasks()
            canvas = dropdown._parent_canvas
            scroll_region = canvas.bbox("all")
            if scroll_region:
                canvas.configure(scrollregion=scroll_region)
        except (AttributeError, RuntimeError, tk.TclError):
            pass

    def _schedule_open_dropdown_reflow(self, event=None):
        # Ignore Configure events belonging to child widgets. Only a change
        # to the main window's edges should resize the floating dropdown.
        if event is not None and getattr(event, "widget", self) is not self:
            return
        if self._dropdown_reflow_job is not None:
            try:
                self.after_cancel(self._dropdown_reflow_job)
            except (RuntimeError, tk.TclError):
                pass
        self._dropdown_reflow_job = self.after(
            15,
            self._reflow_open_dropdown,
        )

    def _reflow_open_dropdown(self):
        self._dropdown_reflow_job = None
        if self._transition_dropdown_is_visible():
            self._place_dropdown_inside_visible_area(
                self.transition_dropdown_frame,
                self.transition_button,
            )
        if self._effect_dropdown_is_visible():
            self._place_dropdown_inside_visible_area(
                self.effect_dropdown_frame,
                self.effect_button,
            )
        if self._sound_effect_dropdown_is_visible():
            self._place_dropdown_inside_visible_area(
                self.sound_effect_dropdown_frame,
                self.sound_effect_button,
            )
        if self._animation_dropdown_is_visible():
            self._place_dropdown_inside_visible_area(
                self.animation_dropdown_frame,
                self.animation_button,
            )

    def _animation_dropdown_is_visible(self):
        frame = self.animation_dropdown_frame
        if frame is None:
            return False
        geometry_widget = getattr(frame, "_parent_frame", frame)
        try:
            return bool(geometry_widget.winfo_manager())
        except tk.TclError:
            return False

    def _scroll_animation_dropdown_only(self, event):
        if not self._animation_dropdown_is_visible():
            return None
        frame = self.animation_dropdown_frame
        geometry_widget = getattr(frame, "_parent_frame", frame)
        if not self._point_inside_widget(geometry_widget, event.x_root, event.y_root):
            return None
        canvas = getattr(frame, "_parent_canvas", None)
        if canvas is not None:
            steps = -int(event.delta / 6) if event.delta else 0
            if steps:
                canvas.yview_scroll(steps, "units")
        return "break"

    def _close_animation_on_outside_click(self, event):
        if not self._animation_dropdown_is_visible():
            return None
        frame = getattr(self.animation_dropdown_frame, "_parent_frame", self.animation_dropdown_frame)
        if self._point_inside_widget(self.animation_button, event.x_root, event.y_root) or self._point_inside_widget(frame, event.x_root, event.y_root):
            return None
        self.hide_animation_dropdown()

    def hide_animation_dropdown(self):
        if self.animation_dropdown_frame is not None:
            self.animation_dropdown_frame.place_forget()
        if getattr(self, "_animation_click_bind_id", None) is not None:
            self.unbind("<Button-1>", self._animation_click_bind_id)
            self._animation_click_bind_id = None
        if getattr(self, "_animation_wheel_bind_id", None) is not None:
            self.unbind("<MouseWheel>", self._animation_wheel_bind_id)
            self._animation_wheel_bind_id = None
        self.update_animation_button_text()

    def _delete_selected_custom_dropdown_items(self, _event=None):
        focused = self.focus_get()
        if focused is not None:
            try:
                if focused.winfo_class() in {
                    "Entry", "TEntry", "Text", "Spinbox", "TSpinbox",
                }:
                    return None
            except tk.TclError:
                pass

        if self._sound_effect_dropdown_is_visible():
            preset_map = SOUND_EFFECT_PRESETS
            variable_map = self.sound_effect_vars
            deleter = delete_custom_sound_effect_presets
            hide_dropdown = self.hide_sound_effect_dropdown
            update_button = self.update_sound_effect_button_text
            frame_attribute = "sound_effect_dropdown_frame"
            item_name = "sound effect"
        elif self._effect_dropdown_is_visible():
            preset_map = VIDEO_EFFECT_PRESETS
            variable_map = self.effect_vars
            deleter = delete_custom_video_effect_presets
            hide_dropdown = self.hide_effect_dropdown
            update_button = self.update_effect_button_text
            frame_attribute = "effect_dropdown_frame"
            item_name = "hiệu ứng"
        elif self._transition_dropdown_is_visible():
            preset_map = TRANSITION_PRESETS
            variable_map = self.transition_vars
            deleter = delete_custom_transition_presets
            hide_dropdown = self.hide_transition_dropdown
            update_button = self.update_transition_button_text
            frame_attribute = "transition_dropdown_frame"
            item_name = "transition"
        elif self._animation_dropdown_is_visible():
            selected_keys = [key for typ in ("in", "out", "group") for key, var in self.animation_vars[typ].items() if key != "none" and var.get()]
            if selected_keys:
                try:
                    deleted = delete_custom_animations(selected_keys)
                except OSError as error:
                    messagebox.showerror(
                        "Không thể xóa",
                        f"Không thể cập nhật thư viện animation:\n{error}",
                        parent=self,
                    )
                    return "break"
                self.animation_registry = load_custom_animations()
                for typ in ("in", "out", "group"):
                    old = self.animation_vars[typ]
                    remaining = [
                        key
                        for key in old
                        if key != "none"
                        and key not in deleted
                        and key in self.animation_registry
                    ]
                    selected_remaining = {
                        key for key in remaining if old[key].get()
                    }
                    self.animation_vars[typ] = {
                        "none": ctk.BooleanVar(value=not selected_remaining),
                        **{
                            key: ctk.BooleanVar(value=key in selected_remaining)
                            for key in remaining
                        },
                    }
                self.hide_animation_dropdown()
                self.animation_dropdown_frame.destroy()
                self.animation_dropdown_frame = None
                self.update_animation_button_text()
                messagebox.showinfo("Đã xóa animation", f"Đã xóa {len(deleted)} animation custom.", parent=self)
            return "break"
        else:
            return None

        selected_keys = [
            key
            for key, variable in variable_map.items()
            if key != "none"
            and variable.get()
            and key in preset_map
            and preset_map[key].get("custom")
        ]
        if not selected_keys:
            return None
        selected_names = [preset_map[key]["name"] for key in selected_keys]

        hide_dropdown()
        try:
            deleted_keys = deleter(selected_keys)
        except OSError as error:
            messagebox.showerror(
                "Không thể xóa",
                f"Không thể cập nhật thư viện {item_name}:\n{error}",
                parent=self,
            )
            return "break"
        if not deleted_keys:
            return "break"

        if item_name == "sound effect":
            self._stop_music_preview()
        dropdown = getattr(self, frame_attribute, None)
        if dropdown is not None:
            dropdown.destroy()
            setattr(self, frame_attribute, None)
        for key in deleted_keys:
            variable_map.pop(key, None)
        if not any(variable.get() for variable in variable_map.values()):
            variable_map["none"].set(True)
        update_button()
        messagebox.showinfo(
            "Đã xóa",
            f"Đã xóa {len(deleted_keys)} {item_name} tự thêm:\n• "
            + "\n• ".join(selected_names),
            parent=self,
        )
        return "break"

    def update_transition_button_text(self):
        selected = self._selected_transition_keys()
        if not selected:
            text = "Chưa chọn transition"
        elif selected == ["none"]:
            text = "Không transition"
        elif len(selected) == 1:
            text = TRANSITION_PRESETS[selected[0]]["name"]
        else:
            text = f"Đã chọn {len(selected)} mục"
        text = self._fit_asset_button_label(text)
        is_open = self._transition_dropdown_is_visible()
        self.transition_button.configure(text=text + ("  ▲" if is_open else "  ▼"))

    def open_transition_dropdown(self):
        if self._transition_dropdown_is_visible():
            self.hide_transition_dropdown()
            return

        if self.transition_dropdown_frame is None:
            options = ctk.CTkScrollableFrame(
                self.main_scroll_frame,
                width=210,
                height=360,
            )
            # CTkScrollbar mặc định tự yêu cầu chiều cao lớn; hạ kích thước
            # tối thiểu để dropdown có thể co theo cạnh dưới cửa sổ.
            options._scrollbar.configure(height=1)
            self.transition_dropdown_frame = options

            def on_change():
                self.update_transition_button_text()

            ctk.CTkButton(
                options,
                text="Nạp thêm từ CapCut",
                height=30,
                command=self.import_transitions_from_project,
            ).pack(fill="x", padx=10, pady=(10, 8))
            ctk.CTkCheckBox(
                options,
                text="Không transition",
                variable=self.transition_vars["none"],
                command=on_change,
            ).pack(anchor="w", padx=12, pady=(10, 6))
            for key, preset in TRANSITION_PRESETS.items():
                ctk.CTkCheckBox(
                    options,
                    text=(
                        preset["name"] + "  (tự thêm)"
                        if preset.get("custom")
                        else preset["name"]
                    ),
                    variable=self.transition_vars[key],
                    command=on_change,
                ).pack(anchor="w", padx=12, pady=6)
        self._place_dropdown_inside_visible_area(
            self.transition_dropdown_frame,
            self.transition_button,
        )
        if self._transition_click_bind_id is None:
            self._transition_click_bind_id = self.bind(
                "<Button-1>",
                self._close_transition_on_outside_click,
                add="+",
            )
        if self._transition_wheel_bind_id is None:
            self._transition_wheel_bind_id = self.bind(
                "<MouseWheel>",
                self._scroll_transition_dropdown_only,
                add="+",
            )
        self.transition_button.configure(
            text=self.transition_button.cget("text").replace("▼", "▲")
        )

    def import_transitions_from_project(self):
        self.hide_transition_dropdown()
        popup = ctk.CTkToplevel(self)
        popup.title("Thêm transition từ project CapCut")
        popup.geometry("650x470")
        popup.minsize(590, 430)
        popup.transient(self)
        popup.grab_set()
        popup.grid_columnconfigure(0, weight=1)

        ctk.CTkLabel(
            popup,
            text="THÊM TRANSITION TỪ PROJECT CAPCUT",
            font=ctk.CTkFont(size=20, weight="bold"),
        ).grid(row=0, column=0, padx=28, pady=(24, 12))

        guide = (
            "1. Mở CapCut và mở một project bất kỳ.\n"
            "2. Tìm và thêm transition bạn muốn giữa hai media bất kỳ.\n"
            "3. Nhập đúng tên project vào ô bên dưới."
        )
        ctk.CTkLabel(
            popup,
            text=guide,
            justify="left",
            anchor="w",
            font=ctk.CTkFont(size=15),
        ).grid(row=1, column=0, sticky="ew", padx=42, pady=(6, 22))

        ctk.CTkLabel(
            popup,
            text="Tên project CapCut:",
            anchor="w",
            font=ctk.CTkFont(size=15, weight="bold"),
        ).grid(row=2, column=0, sticky="ew", padx=42, pady=(0, 7))
        project_name_entry = ctk.CTkEntry(
            popup,
            height=42,
            border_width=2,
            placeholder_text="Ví dụ: Project transition mẫu",
            font=ctk.CTkFont(size=15),
        )
        project_name_entry.grid(row=3, column=0, sticky="ew", padx=42)

        status_label = ctk.CTkLabel(
            popup,
            text="",
            justify="left",
            anchor="w",
            wraplength=560,
        )
        status_label.grid(row=4, column=0, sticky="ew", padx=42, pady=(10, 4))

        def check_project(_event=None):
            project_name = project_name_entry.get().strip()
            if not project_name:
                status_label.configure(
                    text="Hãy nhập tên project CapCut.",
                    text_color="#ff6b6b",
                )
                project_name_entry.focus_set()
                return
            project_root = self.capcut_project_dir_setting.get().strip()
            if not os.path.isdir(project_root):
                project_root = get_capcut_project_dir()
            if not os.path.isdir(project_root):
                status_label.configure(
                    text=(
                        "Không tìm thấy vị trí lưu project CapCut. Hãy kiểm tra "
                        "lại mục Vị trí lưu dự án CapCut trong Cài đặt."
                    ),
                    text_color="#ff6b6b",
                )
                return
            matches = find_capcut_projects_by_name(project_root, project_name)
            if not matches:
                status_label.configure(
                    text=(
                        "Không tìm thấy project này. Hãy kiểm tra đúng tên và "
                        "nhớ thoát khỏi project trong CapCut trước."
                    ),
                    text_color="#ff6b6b",
                )
                return
            popup.grab_release()
            popup.destroy()
            if len(matches) == 1:
                self._read_transitions_from_project(matches[0]["path"])
            else:
                self._show_matching_project_selector(matches, import_kind="transition")

        ctk.CTkButton(
            popup,
            text="KIỂM TRA VÀ THÊM TRANSITION",
            height=42,
            width=260,
            command=check_project,
        ).grid(row=5, column=0, pady=(16, 10))
        ctk.CTkButton(
            popup,
            text="HỦY",
            width=100,
            fg_color="#555555",
            hover_color="#666666",
            command=popup.destroy,
        ).grid(row=6, column=0, pady=(0, 20))
        project_name_entry.bind("<Return>", check_project)
        popup.after(100, project_name_entry.focus_set)

    def _read_transitions_from_project(self, project_path):
        try:
            presets = extract_transition_presets_from_project(project_path)
        except ValueError as exc:
            messagebox.showerror("Không thể đọc transition", str(exc), parent=self)
            return
        if not presets:
            messagebox.showinfo(
                "Không tìm thấy transition",
                "Project này chưa có transition hợp lệ giữa các ảnh/video.\n\n"
                "Hãy thêm transition trong CapCut, thoát khỏi project để CapCut "
                "lưu lại rồi thử lần nữa.",
                parent=self,
            )
            return
        if len(presets) == 1:
            self._save_imported_transitions(presets)
            return
        self._show_transition_import_selector(project_path, presets)

    def _show_matching_project_selector(self, matches, import_kind="transition"):
        popup = ctk.CTkToplevel(self)
        popup.title("Chọn đúng project CapCut")
        popup.geometry(f"620x{min(600, max(310, 190 + len(matches) * 55))}")
        popup.minsize(540, 300)
        popup.transient(self)
        popup.grab_set()
        popup.grid_columnconfigure(0, weight=1)
        popup.grid_rowconfigure(2, weight=1)

        ctk.CTkLabel(
            popup,
            text="CÓ NHIỀU PROJECT TRÙNG TÊN",
            font=ctk.CTkFont(size=18, weight="bold"),
        ).grid(row=0, column=0, padx=20, pady=(20, 7))
        ctk.CTkLabel(
            popup,
            text="Chọn project đúng theo thời gian sửa gần nhất:",
        ).grid(row=1, column=0, padx=20, pady=(0, 8))

        list_frame = ctk.CTkScrollableFrame(popup)
        list_frame.grid(row=2, column=0, sticky="nsew", padx=18, pady=8)
        selected_path = ctk.StringVar(value=matches[0]["path"])
        for match in matches:
            modified_text = (
                time.strftime("%d/%m/%Y %H:%M", time.localtime(match["modified"]))
                if match["modified"]
                else "không rõ thời gian"
            )
            ctk.CTkRadioButton(
                list_frame,
                text=(
                    f"{match['name']}  —  sửa lúc {modified_text}\n"
                    f"Thư mục: {match['folder_name']}"
                ),
                variable=selected_path,
                value=match["path"],
            ).pack(anchor="w", fill="x", padx=10, pady=9)

        def use_selected():
            project_path = selected_path.get()
            popup.grab_release()
            popup.destroy()
            if import_kind == "sound_effect":
                self._read_sound_effects_from_project(project_path)
            elif import_kind == "effect":
                self._read_effects_from_project(project_path)
            elif import_kind == "animation":
                self._read_animations_from_project(project_path)
            else:
                self._read_transitions_from_project(project_path)

        ctk.CTkButton(
            popup,
            text="DÙNG PROJECT NÀY",
            width=190,
            command=use_selected,
        ).grid(row=3, column=0, pady=(8, 18))

    def _show_transition_import_selector(self, project_path, presets):
        popup = ctk.CTkToplevel(self)
        popup.title("Chọn transition cần thêm")
        popup.geometry(f"520x{min(620, max(300, 190 + len(presets) * 48))}")
        popup.minsize(460, 280)
        popup.transient(self)
        popup.grab_set()
        popup.grid_columnconfigure(0, weight=1)
        popup.grid_rowconfigure(2, weight=1)

        ctk.CTkLabel(
            popup,
            text="TRANSITION TRONG PROJECT",
            font=ctk.CTkFont(size=18, weight="bold"),
        ).grid(row=0, column=0, padx=20, pady=(18, 6))
        ctk.CTkLabel(
            popup,
            text=os.path.basename(os.path.normpath(project_path)),
            text_color="#b8b8b8",
        ).grid(row=1, column=0, padx=20, pady=(0, 8))

        list_frame = ctk.CTkScrollableFrame(popup)
        list_frame.grid(row=2, column=0, sticky="nsew", padx=18, pady=8)
        variables = []
        for preset in presets:
            selected = ctk.BooleanVar(value=True)
            variables.append((selected, preset))
            seconds = preset["duration"] / 1_000_000
            ctk.CTkCheckBox(
                list_frame,
                text=f"{preset['name']}   ({seconds:.2f} giây)",
                variable=selected,
            ).pack(anchor="w", fill="x", padx=10, pady=8)

        def save_selected():
            chosen = [preset for selected, preset in variables if selected.get()]
            if not chosen:
                messagebox.showinfo(
                    "Chưa chọn transition",
                    "Hãy chọn ít nhất một transition cần thêm.",
                    parent=popup,
                )
                return
            popup.grab_release()
            popup.destroy()
            self._save_imported_transitions(chosen)

        button_row = ctk.CTkFrame(popup, fg_color="transparent")
        button_row.grid(row=3, column=0, pady=(8, 18))
        ctk.CTkButton(
            button_row,
            text="THÊM ĐÃ CHỌN",
            width=170,
            command=save_selected,
        ).pack(side="left", padx=6)
        ctk.CTkButton(
            button_row,
            text="HỦY",
            width=90,
            fg_color="#555555",
            hover_color="#666666",
            command=popup.destroy,
        ).pack(side="left", padx=6)

    def _save_imported_transitions(self, presets):
        try:
            saved_keys = save_custom_transition_presets(presets)
        except OSError as exc:
            messagebox.showerror(
                "Không thể lưu transition",
                f"Không thể lưu thư viện transition:\n{exc}",
                parent=self,
            )
            return
        if not saved_keys:
            messagebox.showerror(
                "Không thể thêm transition",
                "Không có transition hợp lệ để lưu.",
                parent=self,
            )
            return

        self.hide_transition_dropdown()
        if self.transition_dropdown_frame is not None:
            self.transition_dropdown_frame.destroy()
            self.transition_dropdown_frame = None
        for key in saved_keys:
            if key not in self.transition_vars:
                self.transition_vars[key] = ctk.BooleanVar(value=True)
            else:
                self.transition_vars[key].set(True)
        self.transition_vars["none"].set(False)
        self.update_transition_button_text()
        names = [TRANSITION_PRESETS[key]["name"] for key in saved_keys]
        messagebox.showinfo(
            "Đã thêm transition",
            "Đã lưu vào tool:\n• " + "\n• ".join(names),
            parent=self,
        )

    @staticmethod
    def _point_inside_widget(widget, x_root, y_root):
        if widget is None or not widget.winfo_exists():
            return False
        left = widget.winfo_rootx()
        top = widget.winfo_rooty()
        return (
            left <= x_root < left + widget.winfo_width()
            and top <= y_root < top + widget.winfo_height()
        )

    @staticmethod
    def _fit_asset_button_label(label, max_chars=18):
        """Shorten long names while keeping the full name in the dropdown."""
        label = str(label or "")
        if len(label) <= max_chars:
            return label
        return label[: max_chars - 1].rstrip() + "…"

    def _close_transition_on_outside_click(self, event):
        if (
            self.transition_dropdown_frame is None
            or not self._transition_dropdown_is_visible()
        ):
            return
        if self._point_inside_widget(
            self.transition_button, event.x_root, event.y_root
        ):
            return
        outer = getattr(
            self.transition_dropdown_frame,
            "_parent_frame",
            self.transition_dropdown_frame,
        )
        if self._point_inside_widget(outer, event.x_root, event.y_root):
            return
        self.hide_transition_dropdown()

    def hide_transition_dropdown(self):
        if self.transition_dropdown_frame is not None:
            self.transition_dropdown_frame.place_forget()
        if self._transition_click_bind_id is not None:
            self.unbind("<Button-1>", self._transition_click_bind_id)
            self._transition_click_bind_id = None
        if self._transition_wheel_bind_id is not None:
            self.unbind("<MouseWheel>", self._transition_wheel_bind_id)
            self._transition_wheel_bind_id = None
        self.update_transition_button_text()

    def get_transition_settings(self):
        selected = self._selected_transition_keys()
        if not selected:
            selected = ["none"]
        return {
            "selected": selected,
            "random": self.transition_random.get(),
        }

    def _animation_selected(self, typ):
        return [key for key, var in self.animation_vars[typ].items() if var.get()]

    def update_animation_button_text(self):
        selected = [key for typ in ("in", "out", "group") for key in self._animation_selected(typ) if key != "none"]
        label = "Không animation" if not selected else (self.animation_registry.get(selected[0], {}).get("name", "Animation") if len(selected) == 1 else f"Đã chọn {len(selected)} animation")
        label = self._fit_asset_button_label(label)
        arrow = "▲" if self._animation_dropdown_is_visible() else "▼"
        self.animation_button.configure(text=f"{label}  {arrow}")

    def _on_animation_toggle(self, typ, key):
        if key == "none" and self.animation_vars[typ][key].get():
            for other_key, variable in self.animation_vars[typ].items():
                if other_key != "none":
                    variable.set(False)
        elif key != "none" and self.animation_vars[typ][key].get():
            self.animation_vars[typ]["none"].set(False)
        self.update_animation_button_text()

    def open_animation_dropdown(self):
        if self._animation_dropdown_is_visible():
            self.hide_animation_dropdown()
            return
        if self.animation_dropdown_frame is None:
            frame = ctk.CTkScrollableFrame(self.main_scroll_frame, width=300, height=300)
            self.animation_dropdown_frame = frame
            ctk.CTkButton(frame, text="Nạp thêm từ CapCut", command=self.import_animations_from_project).pack(fill="x", padx=8, pady=8)
            labels = {"in": "Animation In", "out": "Animation Out", "group": "Animation Combo"}
            for typ in ("in", "out", "group"):
                ctk.CTkLabel(frame, text=labels[typ], anchor="w", font=ctk.CTkFont(weight="bold")).pack(fill="x", padx=8, pady=(8, 2))
                for key, var in self.animation_vars[typ].items():
                    text = "Không animation" if key == "none" else self.animation_registry[key].get("name", key)
                    ctk.CTkCheckBox(frame, text=text, variable=var, command=lambda t=typ, k=key: self._on_animation_toggle(t, k)).pack(anchor="w", padx=12, pady=2)
        self._place_dropdown_inside_visible_area(self.animation_dropdown_frame, self.animation_button)
        self.animation_dropdown_frame.lift()
        self._animation_click_bind_id = self.bind("<Button-1>", self._close_animation_on_outside_click, add="+")
        self._animation_wheel_bind_id = self.bind("<MouseWheel>", self._scroll_animation_dropdown_only, add="+")
        self.update_animation_button_text()

    def get_animation_settings(self):
        slots = {typ: self._animation_selected(typ) for typ in ("in", "out", "group")}
        return {"slots": slots, "selected": slots, "random": bool(self.animation_random.get()), "registry": dict(self.animation_registry)}

    def import_animations_from_project(self):
        self.hide_animation_dropdown()
        popup = ctk.CTkToplevel(self); popup.title("Thêm Animation từ project CapCut"); popup.geometry("650x430"); popup.transient(self); popup.grab_set()
        ctk.CTkLabel(popup, text="THÊM ANIMATION TỪ PROJECT CAPCUT", font=ctk.CTkFont(size=19, weight="bold")).pack(pady=(22, 10))
        ctk.CTkLabel(
            popup,
            text="1. Mở CapCut và mở một project bất kỳ.\n2. Tìm và áp dụng animation muốn lưu vào ảnh hoặc video bất kỳ.\n3. Nhập đúng tên project.",
            justify="left",
            anchor="w",
            font=ctk.CTkFont(size=15),
        ).pack(fill="x", padx=40, pady=8)
        entry = ctk.CTkEntry(popup, placeholder_text="Tên project CapCut", height=40); entry.pack(fill="x", padx=40, pady=8)
        status = ctk.CTkLabel(popup, text="", anchor="w"); status.pack(fill="x", padx=40)
        def check():
            root = self.capcut_project_dir_setting.get().strip() or get_capcut_project_dir(); matches = find_capcut_projects_by_name(root, entry.get().strip())
            if not matches: status.configure(text="Không tìm thấy project.", text_color="#ff6b6b"); return
            popup.destroy()
            if len(matches) == 1:
                self._read_animations_from_project(matches[0]["path"])
            else:
                self._show_matching_project_selector(matches, import_kind="animation")
        ctk.CTkButton(popup, text="KIỂM TRA VÀ THÊM ANIMATION", command=check).pack(pady=14)
        ctk.CTkButton(popup, text="HỦY", fg_color="#555555", command=popup.destroy).pack()
        entry.bind("<Return>", lambda _e: check()); entry.focus_set()

    def _read_animations_from_project(self, project_path):
        try:
            presets = extract_animation_presets_from_project(project_path)
        except (OSError, ValueError, TypeError) as exc:
            messagebox.showerror("Không thể đọc animation", str(exc), parent=self)
            return
        if not presets: messagebox.showinfo("Không tìm thấy animation", "Project chưa có animation được gắn vào ảnh/video.", parent=self); return
        popup = ctk.CTkToplevel(self); popup.title("Chọn animation cần lưu"); popup.geometry("520x460"); popup.transient(self); popup.grab_set()
        ctk.CTkLabel(popup, text="ANIMATION TRONG PROJECT", font=ctk.CTkFont(size=18, weight="bold")).pack(pady=15)
        box = ctk.CTkScrollableFrame(popup); box.pack(fill="both", expand=True, padx=15, pady=8); vars_=[]
        for item in presets:
            type_label = "COMBO" if item["type"] == "group" else item["type"].upper()
            v=ctk.BooleanVar(value=True); vars_.append((v,item)); ctk.CTkCheckBox(box, text=f"[{type_label}] {item.get('name','Animation')}", variable=v).pack(anchor="w", padx=8, pady=5)
        def save():
            chosen = [item for v, item in vars_ if v.get()]
            if not chosen:
                messagebox.showinfo("Chưa chọn animation", "Hãy chọn ít nhất một animation.", parent=popup)
                return
            try:
                imported_keys = save_custom_animations(chosen)
            except OSError as exc:
                messagebox.showerror("Không thể lưu animation", str(exc), parent=popup)
                return
            old_selected = {
                typ: set(self._animation_selected(typ))
                for typ in ("in", "out", "group")
            }
            self.animation_registry = load_custom_animations()
            imported_keys = set(imported_keys)
            for typ in ("in", "out", "group"):
                selected = (old_selected[typ] | {
                    key for key in imported_keys
                    if self.animation_registry.get(key, {}).get("type") == typ
                }) - {"none"}
                self.animation_vars[typ] = {
                    "none": ctk.BooleanVar(value=not selected),
                    **{
                        key: ctk.BooleanVar(value=key in selected)
                        for key, item in self.animation_registry.items()
                        if item.get("type") == typ
                    },
                }
            if self.animation_dropdown_frame is not None: self.animation_dropdown_frame.destroy(); self.animation_dropdown_frame=None
            popup.destroy(); self.update_animation_button_text()
            messagebox.showinfo("Đã thêm animation", "Đã lưu vào tool:\n• " + "\n• ".join(item.get("name", "Animation") for item in chosen), parent=self)
        ctk.CTkButton(popup, text="LƯU ĐÃ CHỌN", command=save).pack(pady=12)

    def _selected_effect_keys(self):
        order = ["none", *VIDEO_EFFECT_PRESETS.keys()]
        return [
            key for key in order
            if key in self.effect_vars and self.effect_vars[key].get()
        ]

    def _effect_dropdown_is_visible(self):
        frame = self.effect_dropdown_frame
        if frame is None:
            return False
        geometry_widget = getattr(frame, "_parent_frame", frame)
        try:
            return bool(geometry_widget.winfo_manager())
        except tk.TclError:
            return False

    def _scroll_effect_dropdown_only(self, event):
        if not self._effect_dropdown_is_visible():
            return None
        frame = self.effect_dropdown_frame
        geometry_widget = getattr(frame, "_parent_frame", frame)
        if not self._point_inside_widget(
            geometry_widget,
            event.x_root,
            event.y_root,
        ):
            return None
        canvas = getattr(frame, "_parent_canvas", None)
        if canvas is not None and canvas.yview() != (0.0, 1.0):
            steps = -int(event.delta / 6) if event.delta else 0
            if steps:
                canvas.yview_scroll(steps, "units")
        return "break"

    def update_effect_button_text(self):
        selected = self._selected_effect_keys()
        if not selected:
            label = "Chưa chọn hiệu ứng"
        elif selected == ["none"]:
            label = "Không hiệu ứng"
        elif len(selected) == 1:
            label = VIDEO_EFFECT_PRESETS[selected[0]]["name"]
        else:
            label = f"Đã chọn {len(selected)} mục"
        label = self._fit_asset_button_label(label)
        arrow = "▲" if self._effect_dropdown_is_visible() else "▼"
        self.effect_button.configure(text=f"{label}  {arrow}")

    def open_effect_dropdown(self):
        if self._effect_dropdown_is_visible():
            self.hide_effect_dropdown()
            return

        if self.effect_dropdown_frame is None:
            options = ctk.CTkScrollableFrame(
                self.main_scroll_frame,
                width=210,
                height=360,
            )
            options._scrollbar.configure(height=1)
            self.effect_dropdown_frame = options

            def on_change():
                self.update_effect_button_text()

            ctk.CTkButton(
                options,
                text="Nạp thêm từ CapCut",
                height=30,
                command=self.import_effects_from_project,
            ).pack(fill="x", padx=10, pady=(10, 8))
            ctk.CTkCheckBox(
                options,
                text="Không hiệu ứng",
                variable=self.effect_vars["none"],
                command=on_change,
            ).pack(anchor="w", padx=12, pady=(10, 6))
            for key, preset in VIDEO_EFFECT_PRESETS.items():
                ctk.CTkCheckBox(
                    options,
                    text=(
                        preset["name"] + "  (tự thêm)"
                        if preset.get("custom")
                        else preset["name"]
                    ),
                    variable=self.effect_vars[key],
                    command=on_change,
                ).pack(anchor="w", padx=12, pady=6)

        self._place_dropdown_inside_visible_area(
            self.effect_dropdown_frame,
            self.effect_button,
        )
        if self._effect_click_bind_id is None:
            self._effect_click_bind_id = self.bind(
                "<Button-1>",
                self._close_effect_on_outside_click,
                add="+",
            )
        if self._effect_wheel_bind_id is None:
            self._effect_wheel_bind_id = self.bind(
                "<MouseWheel>",
                self._scroll_effect_dropdown_only,
                add="+",
            )
        self.update_effect_button_text()

    def import_effects_from_project(self):
        self.hide_effect_dropdown()
        popup = ctk.CTkToplevel(self)
        popup.title("Thêm hiệu ứng từ project CapCut")
        popup.geometry("650x470")
        popup.minsize(590, 430)
        popup.transient(self)
        popup.grab_set()
        popup.grid_columnconfigure(0, weight=1)

        ctk.CTkLabel(
            popup,
            text="THÊM HIỆU ỨNG TỪ PROJECT CAPCUT",
            font=ctk.CTkFont(size=20, weight="bold"),
        ).grid(row=0, column=0, padx=28, pady=(24, 12))
        guide = (
            "1. Mở CapCut và mở một project bất kỳ.\n"
            "2. Tìm và áp dụng hiệu ứng muốn lưu vào ảnh hoặc video bất kỳ.\n"
            "3. Nhập đúng tên project vào ô bên dưới."
        )
        ctk.CTkLabel(
            popup,
            text=guide,
            justify="left",
            anchor="w",
            font=ctk.CTkFont(size=15),
        ).grid(row=1, column=0, sticky="ew", padx=42, pady=(6, 22))
        ctk.CTkLabel(
            popup,
            text="Tên project CapCut:",
            anchor="w",
            font=ctk.CTkFont(size=15, weight="bold"),
        ).grid(row=2, column=0, sticky="ew", padx=42, pady=(0, 7))
        project_name_entry = ctk.CTkEntry(
            popup,
            height=42,
            border_width=2,
            placeholder_text="Ví dụ: Project hiệu ứng mẫu",
            font=ctk.CTkFont(size=15),
        )
        project_name_entry.grid(row=3, column=0, sticky="ew", padx=42)
        status_label = ctk.CTkLabel(
            popup,
            text="",
            justify="left",
            anchor="w",
            wraplength=560,
        )
        status_label.grid(row=4, column=0, sticky="ew", padx=42, pady=(10, 4))

        def check_project(_event=None):
            project_name = project_name_entry.get().strip()
            if not project_name:
                status_label.configure(
                    text="Hãy nhập tên project CapCut.",
                    text_color="#ff6b6b",
                )
                project_name_entry.focus_set()
                return
            project_root = self.capcut_project_dir_setting.get().strip()
            if not os.path.isdir(project_root):
                project_root = get_capcut_project_dir()
            if not os.path.isdir(project_root):
                status_label.configure(
                    text=(
                        "Không tìm thấy vị trí lưu project CapCut. Hãy kiểm tra "
                        "lại mục Vị trí lưu dự án CapCut trong Cài đặt."
                    ),
                    text_color="#ff6b6b",
                )
                return
            matches = find_capcut_projects_by_name(project_root, project_name)
            if not matches:
                status_label.configure(
                    text=(
                        "Không tìm thấy project này. Hãy kiểm tra đúng tên và "
                        "nhớ thoát khỏi project trong CapCut trước."
                    ),
                    text_color="#ff6b6b",
                )
                return
            popup.grab_release()
            popup.destroy()
            if len(matches) == 1:
                self._read_effects_from_project(matches[0]["path"])
            else:
                self._show_matching_project_selector(matches, import_kind="effect")

        ctk.CTkButton(
            popup,
            text="KIỂM TRA VÀ THÊM HIỆU ỨNG",
            height=42,
            width=260,
            command=check_project,
        ).grid(row=5, column=0, pady=(16, 10))
        ctk.CTkButton(
            popup,
            text="HỦY",
            width=100,
            fg_color="#555555",
            hover_color="#666666",
            command=popup.destroy,
        ).grid(row=6, column=0, pady=(0, 20))
        project_name_entry.bind("<Return>", check_project)
        popup.after(100, project_name_entry.focus_set)

    def _read_effects_from_project(self, project_path):
        try:
            presets = extract_video_effect_presets_from_project(project_path)
        except ValueError as exc:
            messagebox.showerror("Không thể đọc hiệu ứng", str(exc), parent=self)
            return
        if not presets:
            messagebox.showinfo(
                "Không tìm thấy hiệu ứng",
                "Project này chưa có hiệu ứng hợp lệ được gắn vào ảnh/video.\n\n"
                "Hãy thêm hiệu ứng trong CapCut, thoát khỏi project để CapCut "
                "lưu lại rồi thử lần nữa.",
                parent=self,
            )
            return
        if len(presets) == 1:
            self._save_imported_effects(presets)
            return
        self._show_effect_import_selector(project_path, presets)

    def _show_effect_import_selector(self, project_path, presets):
        popup = ctk.CTkToplevel(self)
        popup.title("Chọn hiệu ứng cần thêm")
        popup.geometry(f"520x{min(650, max(300, 190 + len(presets) * 48))}")
        popup.minsize(460, 280)
        popup.transient(self)
        popup.grab_set()
        popup.grid_columnconfigure(0, weight=1)
        popup.grid_rowconfigure(2, weight=1)

        ctk.CTkLabel(
            popup,
            text="HIỆU ỨNG TRONG PROJECT",
            font=ctk.CTkFont(size=18, weight="bold"),
        ).grid(row=0, column=0, padx=20, pady=(18, 6))
        ctk.CTkLabel(
            popup,
            text=os.path.basename(os.path.normpath(project_path)),
            text_color="#b8b8b8",
        ).grid(row=1, column=0, padx=20, pady=(0, 8))
        list_frame = ctk.CTkScrollableFrame(popup)
        list_frame.grid(row=2, column=0, sticky="nsew", padx=18, pady=8)
        variables = []
        for preset in presets:
            selected = ctk.BooleanVar(value=True)
            variables.append((selected, preset))
            ctk.CTkCheckBox(
                list_frame,
                text=preset["name"],
                variable=selected,
            ).pack(anchor="w", fill="x", padx=10, pady=8)

        def save_selected():
            chosen = [preset for selected, preset in variables if selected.get()]
            if not chosen:
                messagebox.showinfo(
                    "Chưa chọn hiệu ứng",
                    "Hãy chọn ít nhất một hiệu ứng cần thêm.",
                    parent=popup,
                )
                return
            popup.grab_release()
            popup.destroy()
            self._save_imported_effects(chosen)

        button_row = ctk.CTkFrame(popup, fg_color="transparent")
        button_row.grid(row=3, column=0, pady=(8, 18))
        ctk.CTkButton(
            button_row,
            text="THÊM ĐÃ CHỌN",
            width=170,
            command=save_selected,
        ).pack(side="left", padx=6)
        ctk.CTkButton(
            button_row,
            text="HỦY",
            width=90,
            fg_color="#555555",
            hover_color="#666666",
            command=popup.destroy,
        ).pack(side="left", padx=6)

    def _save_imported_effects(self, presets):
        try:
            saved_keys = save_custom_video_effect_presets(presets)
        except OSError as exc:
            messagebox.showerror(
                "Không thể lưu hiệu ứng",
                f"Không thể lưu thư viện hiệu ứng:\n{exc}",
                parent=self,
            )
            return
        if not saved_keys:
            messagebox.showerror(
                "Không thể thêm hiệu ứng",
                "Không có hiệu ứng hợp lệ để lưu.",
                parent=self,
            )
            return

        self.hide_effect_dropdown()
        if self.effect_dropdown_frame is not None:
            self.effect_dropdown_frame.destroy()
            self.effect_dropdown_frame = None
        for key in saved_keys:
            if key not in self.effect_vars:
                self.effect_vars[key] = ctk.BooleanVar(value=True)
            else:
                self.effect_vars[key].set(True)
        self.effect_vars["none"].set(False)
        self.update_effect_button_text()
        names = [VIDEO_EFFECT_PRESETS[key]["name"] for key in saved_keys]
        messagebox.showinfo(
            "Đã thêm hiệu ứng",
            "Đã lưu vào tool:\n• " + "\n• ".join(names),
            parent=self,
        )

    def _close_effect_on_outside_click(self, event):
        if not self._effect_dropdown_is_visible():
            return
        if self._point_inside_widget(
            self.effect_button, event.x_root, event.y_root
        ):
            return
        outer = getattr(
            self.effect_dropdown_frame,
            "_parent_frame",
            self.effect_dropdown_frame,
        )
        if self._point_inside_widget(outer, event.x_root, event.y_root):
            return
        self.hide_effect_dropdown()

    def hide_effect_dropdown(self):
        if self.effect_dropdown_frame is not None:
            self.effect_dropdown_frame.place_forget()
        if self._effect_click_bind_id is not None:
            self.unbind("<Button-1>", self._effect_click_bind_id)
            self._effect_click_bind_id = None
        if self._effect_wheel_bind_id is not None:
            self.unbind("<MouseWheel>", self._effect_wheel_bind_id)
            self._effect_wheel_bind_id = None
        self.update_effect_button_text()

    def get_effect_settings(self):
        selected = self._selected_effect_keys()
        if not selected:
            selected = ["none"]
        return {
            "selected": selected,
            "random": self.effect_random.get(),
        }

    def _selected_sound_effect_keys(self):
        order = ["none", *SOUND_EFFECT_PRESETS.keys()]
        return [
            key for key in order
            if key in self.sound_effect_vars and self.sound_effect_vars[key].get()
        ]

    def _sound_effect_dropdown_is_visible(self):
        frame = self.sound_effect_dropdown_frame
        if frame is None:
            return False
        geometry_widget = getattr(frame, "_parent_frame", frame)
        try:
            return bool(geometry_widget.winfo_manager())
        except tk.TclError:
            return False

    def _scroll_sound_effect_dropdown_only(self, event):
        if not self._sound_effect_dropdown_is_visible():
            return None
        frame = self.sound_effect_dropdown_frame
        geometry_widget = getattr(frame, "_parent_frame", frame)
        if not self._point_inside_widget(
            geometry_widget,
            event.x_root,
            event.y_root,
        ):
            return None
        canvas = getattr(frame, "_parent_canvas", None)
        if canvas is not None and canvas.yview() != (0.0, 1.0):
            steps = -int(event.delta / 6) if event.delta else 0
            if steps:
                canvas.yview_scroll(steps, "units")
        return "break"

    def update_sound_effect_button_text(self):
        selected = self._selected_sound_effect_keys()
        if not selected:
            label = "Chưa chọn sound effect"
        elif selected == ["none"]:
            label = "Không sound effect"
        elif len(selected) == 1:
            label = SOUND_EFFECT_PRESETS[selected[0]]["name"]
        else:
            label = f"Đã chọn {len(selected)} mục"
        label = self._fit_asset_button_label(label)
        arrow = "▲" if self._sound_effect_dropdown_is_visible() else "▼"
        self.sound_effect_button.configure(text=f"{label}  {arrow}")

    def open_sound_effect_dropdown(self):
        if self._sound_effect_dropdown_is_visible():
            self.hide_sound_effect_dropdown()
            return

        if self.sound_effect_dropdown_frame is None:
            options = ctk.CTkScrollableFrame(
                self.main_scroll_frame,
                width=300,
                height=360,
            )
            options._scrollbar.configure(height=1)
            self.sound_effect_dropdown_frame = options

            def on_change():
                self.update_sound_effect_button_text()

            ctk.CTkButton(
                options,
                text="Nạp thêm từ CapCut",
                height=30,
                command=self.import_sound_effects_from_project,
            ).pack(fill="x", padx=10, pady=(10, 8))
            ctk.CTkCheckBox(
                options,
                text="Không sound effect",
                variable=self.sound_effect_vars["none"],
                command=on_change,
            ).pack(anchor="w", padx=12, pady=(10, 6))
            for key, preset in SOUND_EFFECT_PRESETS.items():
                item_row = ctk.CTkFrame(options, fg_color="transparent")
                item_row.pack(fill="x", padx=(8, 6), pady=3)
                ctk.CTkButton(
                    item_row,
                    text="🔊",
                    width=42,
                    height=32,
                    font=ctk.CTkFont(size=18),
                    command=lambda selected=preset: self._preview_sound_effect(
                        selected
                    ),
                ).pack(side="right", padx=(5, 1), pady=3)
                ctk.CTkCheckBox(
                    item_row,
                    text=(
                        preset["name"] + "  (tự thêm)"
                        if preset.get("custom")
                        else preset["name"]
                    ),
                    variable=self.sound_effect_vars[key],
                    command=on_change,
                    width=1,
                ).pack(
                    side="left",
                    fill="x",
                    expand=True,
                    padx=(4, 0),
                    pady=3,
                )

        self._place_dropdown_inside_visible_area(
            self.sound_effect_dropdown_frame,
            self.sound_effect_button,
        )
        if self._sound_effect_click_bind_id is None:
            self._sound_effect_click_bind_id = self.bind(
                "<Button-1>",
                self._close_sound_effect_on_outside_click,
                add="+",
            )
        if self._sound_effect_wheel_bind_id is None:
            self._sound_effect_wheel_bind_id = self.bind(
                "<MouseWheel>",
                self._scroll_sound_effect_dropdown_only,
                add="+",
            )
        self.update_sound_effect_button_text()

    def _preview_sound_effect(self, preset):
        path = str(preset.get("resource_path") or "")
        if os.name != "nt":
            messagebox.showinfo(
                "Nghe thử",
                "Nghe thử hiện chỉ hỗ trợ trên Windows.",
            )
            return
        if not os.path.isfile(path):
            messagebox.showerror(
                "Nghe thử",
                "Không tìm thấy file sound effect.",
            )
            return
        try:
            self._stop_music_preview()
            import ctypes
            sender = ctypes.windll.winmm.mciSendStringW
            last_error = 0
            for attempt, suffix in enumerate((".aac", ".m4a", ".mp3"), start=1):
                handle, preview_path = tempfile.mkstemp(
                    prefix="autocapcut_sound_preview_",
                    suffix=suffix,
                )
                os.close(handle)
                shutil.copyfile(path, preview_path)
                alias = f"accsound{os.getpid()}{attempt}{time.time_ns()}"
                open_error = sender(
                    f'open "{preview_path}" type mpegvideo alias {alias}',
                    None,
                    0,
                    None,
                )
                if open_error:
                    last_error = open_error
                    try:
                        os.remove(preview_path)
                    except OSError:
                        pass
                    continue
                self._music_preview_alias = alias
                self._sound_preview_temp_path = preview_path
                self._set_music_preview_volume(0.0)
                play_error = sender(f"play {alias} from 0", None, 0, None)
                if not play_error:
                    return
                last_error = play_error
                self._stop_music_preview()

            # CapCut thường lưu AAC/M4A nhưng đặt tên file là .mp3. Nếu chỉ
            # đổi ba đuôi vẫn không đủ cho MCI, giải mã sang WAV tạm bằng PyAV.
            handle, preview_path = tempfile.mkstemp(
                prefix="autocapcut_sound_preview_",
                suffix=".wav",
            )
            os.close(handle)
            os.remove(preview_path)
            self._sound_preview_temp_path = preview_path
            self._convert_sound_preview_to_wav(path, preview_path)
            alias = f"accsound{os.getpid()}wav{time.time_ns()}"
            open_error = sender(
                f'open "{preview_path}" type waveaudio alias {alias}',
                None,
                0,
                None,
            )
            if open_error:
                raise RuntimeError(
                    "Windows không thể mở bản WAV nghe thử "
                    f"(mã lỗi {open_error}; lỗi trước đó {last_error})."
                )
            self._music_preview_alias = alias
            self._set_music_preview_volume(0.0)
            play_error = sender(f"play {alias} from 0", None, 0, None)
            if play_error:
                raise RuntimeError(
                    f"Windows không thể phát bản WAV nghe thử (mã lỗi {play_error})."
                )
        except Exception as error:
            self._stop_music_preview()
            messagebox.showerror("Nghe thử", str(error))

    @staticmethod
    def _convert_sound_preview_to_wav(source_path, output_path):
        import av

        source = av.open(source_path)
        output = av.open(output_path, mode="w")
        try:
            output_stream = output.add_stream("pcm_s16le", rate=44100)
            output_stream.layout = "stereo"
            resampler = av.AudioResampler(
                format="s16",
                layout="stereo",
                rate=44100,
            )
            for frame in source.decode(audio=0):
                for converted in resampler.resample(frame):
                    for packet in output_stream.encode(converted):
                        output.mux(packet)
            for converted in resampler.resample(None):
                for packet in output_stream.encode(converted):
                    output.mux(packet)
            for packet in output_stream.encode(None):
                output.mux(packet)
        finally:
            output.close()
            source.close()

    def import_sound_effects_from_project(self):
        self.hide_sound_effect_dropdown()
        popup = ctk.CTkToplevel(self)
        popup.title("Thêm sound effect từ project CapCut")
        popup.geometry("650x490")
        popup.minsize(590, 450)
        popup.transient(self)
        popup.grab_set()
        popup.grid_columnconfigure(0, weight=1)

        ctk.CTkLabel(
            popup,
            text="THÊM SOUND EFFECT TỪ PROJECT CAPCUT",
            font=ctk.CTkFont(size=20, weight="bold"),
        ).grid(row=0, column=0, padx=28, pady=(24, 12))
        guide = (
            "1. Mở CapCut và mở một project bất kỳ.\n"
            "2. Thêm sound effect vào vị trí bất kỳ trên timeline.\n"
            "3. Nhập đúng tên project vào ô bên dưới."
        )
        ctk.CTkLabel(
            popup,
            text=guide,
            justify="left",
            anchor="w",
            font=ctk.CTkFont(size=15),
        ).grid(row=1, column=0, sticky="ew", padx=42, pady=(6, 22))
        ctk.CTkLabel(
            popup,
            text="Tên project CapCut:",
            anchor="w",
            font=ctk.CTkFont(size=15, weight="bold"),
        ).grid(row=2, column=0, sticky="ew", padx=42, pady=(0, 7))
        project_name_entry = ctk.CTkEntry(
            popup,
            height=42,
            border_width=2,
            placeholder_text="Ví dụ: test hiệu ứng",
            font=ctk.CTkFont(size=15),
        )
        project_name_entry.grid(row=3, column=0, sticky="ew", padx=42)
        status_label = ctk.CTkLabel(
            popup,
            text="",
            justify="left",
            anchor="w",
            wraplength=560,
        )
        status_label.grid(row=4, column=0, sticky="ew", padx=42, pady=(10, 4))

        def check_project(_event=None):
            project_name = project_name_entry.get().strip()
            if not project_name:
                status_label.configure(
                    text="Hãy nhập tên project CapCut.",
                    text_color="#ff6b6b",
                )
                project_name_entry.focus_set()
                return
            project_root = self.capcut_project_dir_setting.get().strip()
            if not os.path.isdir(project_root):
                project_root = get_capcut_project_dir()
            if not os.path.isdir(project_root):
                status_label.configure(
                    text=(
                        "Không tìm thấy vị trí lưu project CapCut. Hãy kiểm tra "
                        "lại mục Vị trí lưu dự án CapCut trong Cài đặt."
                    ),
                    text_color="#ff6b6b",
                )
                return
            matches = find_capcut_projects_by_name(project_root, project_name)
            if not matches:
                status_label.configure(
                    text=(
                        "Không tìm thấy project này. Hãy kiểm tra đúng tên và "
                        "nhớ thoát khỏi project trong CapCut trước."
                    ),
                    text_color="#ff6b6b",
                )
                return
            popup.grab_release()
            popup.destroy()
            if len(matches) == 1:
                self._read_sound_effects_from_project(matches[0]["path"])
            else:
                self._show_matching_project_selector(
                    matches,
                    import_kind="sound_effect",
                )

        ctk.CTkButton(
            popup,
            text="KIỂM TRA VÀ THÊM SOUND EFFECT",
            height=42,
            width=280,
            command=check_project,
        ).grid(row=5, column=0, pady=(16, 10))
        ctk.CTkButton(
            popup,
            text="HỦY",
            width=100,
            fg_color="#555555",
            hover_color="#666666",
            command=popup.destroy,
        ).grid(row=6, column=0, pady=(0, 20))
        project_name_entry.bind("<Return>", check_project)
        popup.after(100, project_name_entry.focus_set)

    def _read_sound_effects_from_project(self, project_path):
        try:
            presets = extract_sound_effect_presets_from_project(project_path)
        except ValueError as exc:
            messagebox.showerror(
                "Không thể đọc sound effect",
                str(exc),
                parent=self,
            )
            return
        if not presets:
            messagebox.showinfo(
                "Không tìm thấy sound effect",
                "Project này chưa có sound effect hợp lệ trên timeline.\n\n"
                "Hãy thêm sound effect trong CapCut, thoát khỏi project để "
                "CapCut lưu lại rồi thử lần nữa.",
                parent=self,
            )
            return
        if len(presets) == 1:
            self._save_imported_sound_effects(presets)
            return
        self._show_sound_effect_import_selector(project_path, presets)

    def _show_sound_effect_import_selector(self, project_path, presets):
        popup = ctk.CTkToplevel(self)
        popup.title("Chọn sound effect cần thêm")
        popup.geometry(f"540x{min(650, max(300, 190 + len(presets) * 48))}")
        popup.minsize(480, 280)
        popup.transient(self)
        popup.grab_set()
        popup.grid_columnconfigure(0, weight=1)
        popup.grid_rowconfigure(2, weight=1)

        ctk.CTkLabel(
            popup,
            text="SOUND EFFECT TRONG PROJECT",
            font=ctk.CTkFont(size=18, weight="bold"),
        ).grid(row=0, column=0, padx=20, pady=(18, 6))
        ctk.CTkLabel(
            popup,
            text=os.path.basename(os.path.normpath(project_path)),
            text_color="#b8b8b8",
        ).grid(row=1, column=0, padx=20, pady=(0, 8))
        list_frame = ctk.CTkScrollableFrame(popup)
        list_frame.grid(row=2, column=0, sticky="nsew", padx=18, pady=8)
        variables = []
        for preset in presets:
            selected = ctk.BooleanVar(value=True)
            variables.append((selected, preset))
            ctk.CTkCheckBox(
                list_frame,
                text=preset["name"],
                variable=selected,
            ).pack(anchor="w", fill="x", padx=10, pady=8)

        def save_selected():
            chosen = [preset for selected, preset in variables if selected.get()]
            if not chosen:
                messagebox.showinfo(
                    "Chưa chọn sound effect",
                    "Hãy chọn ít nhất một sound effect cần thêm.",
                    parent=popup,
                )
                return
            popup.grab_release()
            popup.destroy()
            self._save_imported_sound_effects(chosen)

        button_row = ctk.CTkFrame(popup, fg_color="transparent")
        button_row.grid(row=3, column=0, pady=(8, 18))
        ctk.CTkButton(
            button_row,
            text="THÊM ĐÃ CHỌN",
            width=170,
            command=save_selected,
        ).pack(side="left", padx=6)
        ctk.CTkButton(
            button_row,
            text="HỦY",
            width=90,
            fg_color="#555555",
            hover_color="#666666",
            command=popup.destroy,
        ).pack(side="left", padx=6)

    def _save_imported_sound_effects(self, presets):
        try:
            saved_keys = save_custom_sound_effect_presets(presets)
        except OSError as exc:
            messagebox.showerror(
                "Không thể lưu sound effect",
                f"Không thể lưu thư viện sound effect:\n{exc}",
                parent=self,
            )
            return
        if not saved_keys:
            messagebox.showerror(
                "Không thể thêm sound effect",
                "Không có sound effect hợp lệ để lưu.",
                parent=self,
            )
            return

        self.hide_sound_effect_dropdown()
        if self.sound_effect_dropdown_frame is not None:
            self.sound_effect_dropdown_frame.destroy()
            self.sound_effect_dropdown_frame = None
        for key in saved_keys:
            if key not in self.sound_effect_vars:
                self.sound_effect_vars[key] = ctk.BooleanVar(value=True)
            else:
                self.sound_effect_vars[key].set(True)
        self.sound_effect_vars["none"].set(False)
        self.update_sound_effect_button_text()
        names = [SOUND_EFFECT_PRESETS[key]["name"] for key in saved_keys]
        messagebox.showinfo(
            "Đã thêm sound effect",
            "Đã lưu vào tool:\n• " + "\n• ".join(names),
            parent=self,
        )

    def _close_sound_effect_on_outside_click(self, event):
        if not self._sound_effect_dropdown_is_visible():
            return
        if self._point_inside_widget(
            self.sound_effect_button,
            event.x_root,
            event.y_root,
        ):
            return
        outer = getattr(
            self.sound_effect_dropdown_frame,
            "_parent_frame",
            self.sound_effect_dropdown_frame,
        )
        if self._point_inside_widget(outer, event.x_root, event.y_root):
            return
        self.hide_sound_effect_dropdown()

    def hide_sound_effect_dropdown(self):
        if self.sound_effect_dropdown_frame is not None:
            self.sound_effect_dropdown_frame.place_forget()
        if self._sound_effect_click_bind_id is not None:
            self.unbind("<Button-1>", self._sound_effect_click_bind_id)
            self._sound_effect_click_bind_id = None
        if self._sound_effect_wheel_bind_id is not None:
            self.unbind("<MouseWheel>", self._sound_effect_wheel_bind_id)
            self._sound_effect_wheel_bind_id = None
        self.update_sound_effect_button_text()

    def get_sound_effect_settings(self):
        selected = self._selected_sound_effect_keys()
        if not selected:
            selected = ["none"]
        return {
            "selected": selected,
            "random": self.sound_effect_random.get(),
        }

    def _show_multi_audio_skip_message(self):
        messagebox.showinfo(
            "Chế độ nhiều audio",
            "Mỗi audio tương ứng một media.\n\n"
            "Bạn cần chọn thư mục Media Folder. Không cần chọn SRT hoặc "
            "Scenes; hãy bỏ qua bước này.",
            parent=self,
        )

    def _update_multi_audio_controls(self):
        locked = len(self.audio_files) > 1
        controls = (
            (
                getattr(self, "srt_browse_button", None),
                getattr(self, "_srt_browse_normal_style", None),
            ),
            (
                getattr(self, "scenes_browse_button", None),
                getattr(self, "_scenes_browse_normal_style", None),
            ),
        )
        for button, normal_style in controls:
            if button is None or normal_style is None:
                continue
            if locked:
                button.configure(
                    fg_color=("gray70", "gray35"),
                    hover_color=("gray65", "gray32"),
                    text_color=("gray45", "gray65"),
                )
            else:
                button.configure(**normal_style)
        music_edit_button = getattr(self, "background_music_edit_button", None)
        if music_edit_button is not None:
            music_edit_button.configure(
                state="normal" if self.audio_files else "disabled"
            )

    def _parse_drop_paths(self, raw_data):
        """Parse Windows drag data without breaking paths containing spaces."""
        try:
            return [str(path) for path in self.tk.splitlist(str(raw_data or ""))]
        except tk.TclError:
            value = str(raw_data or "").strip().strip("{}")
            return [value] if value else []

    def _register_single_file_drop(
        self,
        widget,
        allowed_extensions,
        description,
        on_accept,
    ):
        if not self._drag_drop_available or not DND_FILES:
            return
        allowed = {str(extension).lower() for extension in allowed_extensions}

        def handle_drop(event):
            paths = self._parse_drop_paths(event.data)
            if len(paths) != 1:
                messagebox.showwarning(
                    "Chỉ kéo một file",
                    f"Mỗi lần chỉ được kéo một file {description}.",
                    parent=self,
                )
                return DND_COPY
            path = os.path.abspath(paths[0])
            if not os.path.isfile(path):
                messagebox.showwarning(
                    "File không hợp lệ",
                    "Mục đã kéo không phải là một file hợp lệ.",
                    parent=self,
                )
                return DND_COPY
            extension = os.path.splitext(path)[1].lower()
            if extension not in allowed:
                formats = ", ".join(sorted(allowed))
                messagebox.showwarning(
                    "Sai định dạng",
                    f"Hãy kéo file {description}. Định dạng hỗ trợ: {formats}",
                    parent=self,
                )
                return DND_COPY
            on_accept(path)
            return DND_COPY

        targets = [widget]
        for attribute in ("_entry", "_textbox"):
            inner = getattr(widget, attribute, None)
            if inner is not None:
                targets.append(inner)
        seen_widgets = set()
        for target in targets:
            widget_name = str(target)
            if widget_name in seen_widgets:
                continue
            seen_widgets.add(widget_name)
            target.drop_target_register(DND_FILES)
            target.dnd_bind("<<Drop>>", handle_drop)

    def create_audio_file_selector(
        self,
        parent,
        label_text,
        filetypes,
        placeholder="",
        font=None,
    ):
        """Select one or more narration files and keep them in natural-name order."""
        row = ctk.CTkFrame(parent, fg_color="transparent")
        row.pack(fill="x", pady=5, padx=10)
        ctk.CTkLabel(row, text=label_text, width=150, anchor="w").pack(side="left")
        entry = ctk.CTkEntry(row, font=font)
        entry.pack(side="left", fill="x", expand=True, padx=5)
        entry.configure(state="readonly")

        def show_value(value, placeholder_color=False):
            entry.configure(state="normal")
            entry.delete(0, "end")
            entry.insert(0, value)
            entry.configure(
                text_color="gray60" if placeholder_color else ("gray10", "gray90")
            )
            entry.configure(state="readonly")

        show_value(placeholder, placeholder_color=True)

        def set_selected(selected, append=False):
            combined = list(self.audio_files) if append else []
            known = {os.path.normcase(os.path.abspath(path)) for path in combined}
            for path in selected:
                normalized = os.path.normcase(os.path.abspath(path))
                if normalized not in known:
                    combined.append(path)
                    known.add(normalized)
            self.audio_files = sorted(combined, key=self.natural_sort_key)
            if len(self.audio_files) == 1:
                display = self.audio_files[0]
            else:
                names = [os.path.basename(path) for path in self.audio_files]
                display = f"Đã chọn {len(names)} audio: " + "; ".join(names)
            show_value(display)
            self._update_multi_audio_controls()

        def browse():
            selected = filedialog.askopenfilenames(filetypes=filetypes)
            if selected:
                set_selected(selected)

        ctk.CTkButton(row, text="Browse", width=80, command=browse).pack(side="left")
        self._register_single_file_drop(
            entry,
            {".mp3", ".wav", ".m4a", ".aac", ".flac", ".ogg", ".wma"},
            "audio",
            lambda path: set_selected([path], append=True),
        )
        return entry

    def create_file_selector(
        self,
        parent,
        label_text,
        filetypes,
        placeholder="",
        font=None,
        help_url=None,
    ):
        f = ctk.CTkFrame(parent, fg_color="transparent")
        f.pack(fill="x", pady=5, padx=10)

        if help_url:
            label_area = ctk.CTkFrame(
                f,
                fg_color="transparent",
                width=150,
                height=28,
            )
            label_area.pack(side="left")
            label_area.pack_propagate(False)
            ctk.CTkLabel(label_area, text=label_text, anchor="w").pack(
                side="left"
            )
            ctk.CTkButton(
                label_area,
                text="?",
                width=20,
                height=20,
                corner_radius=10,
                font=ctk.CTkFont(size=11, weight="bold"),
                fg_color=("gray65", "gray35"),
                hover_color=("#1f6aa5", "#1f6aa5"),
                command=lambda: webbrowser.open(help_url, new=2),
            ).pack(side="left", padx=(5, 0))
        else:
            ctk.CTkLabel(
                f, text=label_text, width=150, anchor="w"
            ).pack(side="left")

        entry = ctk.CTkEntry(f, font=font)
        entry.pack(side="left", fill="x", expand=True, padx=5)

        if placeholder:
            entry.insert(0, placeholder)
            entry.configure(text_color="gray60")

        entry.configure(state="readonly")

        def set_selected_file(filepath):
            entry.configure(state="normal")
            entry.delete(0, 'end')
            entry.insert(0, filepath)
            entry.configure(text_color=("gray10", "gray90"))
            entry.configure(state="readonly")

        def browse():
            if label_text == "SRT File:" and len(self.audio_files) > 1:
                self._show_multi_audio_skip_message()
                return
            filepath = filedialog.askopenfilename(filetypes=filetypes)
            if filepath:
                set_selected_file(filepath)
        browse_button = ctk.CTkButton(
            f, text="Browse", width=80, command=browse
        )
        browse_button.pack(side="left")
        if label_text == "SRT File:":
            self.srt_browse_button = browse_button
            self._srt_browse_normal_style = {
                "fg_color": browse_button.cget("fg_color"),
                "hover_color": browse_button.cget("hover_color"),
                "text_color": browse_button.cget("text_color"),
            }
            def accept_srt_drop(path):
                if len(self.audio_files) > 1:
                    self._show_multi_audio_skip_message()
                    return
                set_selected_file(path)

            self._register_single_file_drop(
                entry,
                {".srt", ".txt"},
                "SRT hoặc TXT",
                accept_srt_drop,
            )
        return entry


    def create_multi_file_selector(self, parent, label_text, filetypes, placeholder="", font=None):
        row = ctk.CTkFrame(parent, fg_color="transparent")
        row.pack(fill="x", pady=5, padx=10)
        ctk.CTkLabel(row, text=label_text, width=150, anchor="w").pack(side="left")
        entry = ctk.CTkEntry(row, font=font)
        entry.pack(side="left", fill="x", expand=True, padx=5)
        entry.configure(state="readonly")

        def show_value(value, placeholder_color=False):
            entry.configure(state="normal")
            entry.delete(0, "end")
            entry.insert(0, value)
            entry.configure(text_color="gray60" if placeholder_color else ("gray10", "gray90"))
            entry.configure(state="readonly")

        show_value(placeholder, placeholder_color=True)

        def set_selected(selected, append=False):
            combined = list(self.background_music_files) if append else []
            known = {os.path.normcase(os.path.abspath(path)) for path in combined}
            for path in selected:
                normalized = os.path.normcase(os.path.abspath(path))
                if normalized not in known:
                    combined.append(path)
                    known.add(normalized)
            self.background_music_files = combined
            # Browse giữ hành vi playlist cũ. Muốn đặt đoạn chi tiết dùng Edit.
            self.background_music_clips = []
            names = [os.path.basename(path) for path in self.background_music_files]
            display = names[0] if len(names) == 1 else f"Đã chọn {len(names)} file: " + "; ".join(names)
            show_value(display)

        def browse():
            selected = filedialog.askopenfilenames(filetypes=filetypes)
            if selected:
                set_selected(selected)

        def clear():
            self._stop_music_preview()
            self.background_music_files = []
            self.background_music_clips = []
            show_value(placeholder, placeholder_color=True)

        ctk.CTkButton(row, text="Xóa", width=55, command=clear).pack(side="left", padx=(0, 5))
        edit_button = ctk.CTkButton(
            row,
            text="Edit",
            width=55,
            command=lambda: self.open_background_music_editor(show_value),
            state="normal" if self.audio_files else "disabled",
        )
        edit_button.pack(side="left", padx=(0, 5))
        self.background_music_edit_button = edit_button
        ctk.CTkButton(row, text="Browse", width=80, command=browse).pack(side="left")
        self._register_single_file_drop(
            entry,
            {".mp3", ".wav", ".m4a", ".aac", ".flac", ".ogg", ".wma"},
            "nhạc nền",
            lambda path: set_selected([path], append=True),
        )
        return entry

    @staticmethod
    def _parse_music_time(value):
        """Nhận giây, MM:SS hoặc HH:MM:SS và trả về số giây."""
        text = str(value or "").strip().replace(",", ".")
        if not text:
            raise ValueError("Thời gian không được để trống.")
        parts = text.split(":")
        if len(parts) > 3 or any(not part.strip() for part in parts):
            raise ValueError(f'Thời gian "{text}" không đúng định dạng.')
        try:
            numbers = [float(part) for part in parts]
        except ValueError as exc:
            raise ValueError(f'Thời gian "{text}" không đúng định dạng.') from exc
        if any(number < 0 for number in numbers):
            raise ValueError("Thời gian không được là số âm.")
        if len(numbers) >= 2 and numbers[-1] >= 60:
            raise ValueError(
                f'Thời gian "{text}" không hợp lệ: phần giây phải từ 0 đến 59.'
            )
        if len(numbers) == 3 and numbers[-2] >= 60:
            raise ValueError(
                f'Thời gian "{text}" không hợp lệ: phần phút phải từ 0 đến 59.'
            )
        seconds = 0.0
        for number in numbers:
            seconds = seconds * 60.0 + number
        return seconds

    @staticmethod
    def _format_music_time(seconds):
        value = max(0.0, float(seconds or 0))
        whole = int(value)
        fraction = value - whole
        hours, remainder = divmod(whole, 3600)
        minutes, secs = divmod(remainder, 60)
        if fraction:
            sec_text = f"{secs + fraction:05.2f}".rstrip("0").rstrip(".")
        else:
            sec_text = f"{secs:02d}"
        if hours:
            return f"{hours}:{minutes:02d}:{sec_text}"
        return f"{minutes}:{sec_text}"

    def _stop_music_preview(self):
        alias = getattr(self, "_music_preview_alias", None)
        if alias and os.name == "nt":
            try:
                import ctypes
                sender = ctypes.windll.winmm.mciSendStringW
                sender(f"stop {alias}", None, 0, None)
                sender(f"close {alias}", None, 0, None)
            except Exception:
                pass
        self._music_preview_alias = None
        preview_path = getattr(self, "_sound_preview_temp_path", None)
        self._sound_preview_temp_path = None
        if preview_path:
            try:
                os.remove(preview_path)
            except OSError:
                pass

    def _set_music_preview_volume(self, volume_db):
        """Đổi âm lượng nghe thử ngay trong lúc MCI đang phát."""
        alias = getattr(self, "_music_preview_alias", None)
        if not alias or os.name != "nt":
            return
        try:
            import ctypes
            # MCI nhận 0..1000 và không khuếch đại quá 0 dB. Giá trị dương
            # vẫn được áp dụng đầy đủ trong CapCut, còn nghe thử đạt mức tối đa.
            amplitude = 10.0 ** (max(-60.0, min(0.0, float(volume_db))) / 20.0)
            mci_volume = max(0, min(1000, int(round(amplitude * 1000))))
            ctypes.windll.winmm.mciSendStringW(
                f"setaudio {alias} volume to {mci_volume}",
                None,
                0,
                None,
            )
        except Exception:
            pass

    def _preview_music_clip(self, path, source_start, source_end, volume_db=0.0):
        if os.name != "nt":
            messagebox.showinfo("Nghe thử", "Nghe thử hiện chỉ hỗ trợ trên Windows.")
            return
        if not os.path.isfile(path):
            messagebox.showerror("Nghe thử", "Không tìm thấy file nhạc đã chọn.")
            return
        try:
            start_seconds = self._parse_music_time(source_start)
            end_seconds = self._parse_music_time(source_end)
            if end_seconds <= start_seconds:
                raise ValueError("Thời gian kết thúc bài hát phải lớn hơn thời gian bắt đầu.")
            self._stop_music_preview()
            import ctypes
            alias = f"accmusic{os.getpid()}"
            sender = ctypes.windll.winmm.mciSendStringW
            error = sender(
                f'open "{os.path.abspath(path)}" type mpegvideo alias {alias}',
                None,
                0,
                None,
            )
            if error:
                raise RuntimeError("Windows không thể mở định dạng nhạc này để nghe thử.")
            self._music_preview_alias = alias
            self._set_music_preview_volume(volume_db)
            start_ms = int(round(start_seconds * 1000))
            end_ms = int(round(end_seconds * 1000))
            error = sender(f"play {alias} from {start_ms} to {end_ms}", None, 0, None)
            if error:
                raise RuntimeError("Không thể phát đoạn nhạc đã chọn.")
        except Exception as error:
            self._stop_music_preview()
            messagebox.showerror("Nghe thử", str(error))

    def _collect_music_editor_rows(self, validate=False):
        clips = []
        for index, row in enumerate(self._music_editor_rows, start=1):
            path = row["path"].get().strip()
            if not path:
                if validate:
                    raise ValueError(f"Nhạc {index}: chưa chọn file nhạc.")
                continue
            try:
                timeline_start = self._parse_music_time(row["timeline_start"].get())
                timeline_end = self._parse_music_time(row["timeline_end"].get())
                source_start = self._parse_music_time(row["source_start"].get())
                source_end = self._parse_music_time(row["source_end"].get())
            except ValueError as error:
                raise ValueError(f"Nhạc {index}: {error}") from error
            if validate and not os.path.isfile(path):
                raise ValueError(f"Nhạc {index}: không tìm thấy file {path}")
            if timeline_end <= timeline_start:
                raise ValueError(f"Nhạc {index}: thời gian timeline kết thúc phải lớn hơn bắt đầu.")
            timeline_limit = float(getattr(self, "_music_timeline_duration", 0) or 0)
            if validate and timeline_limit and timeline_end > timeline_limit + 0.05:
                raise ValueError(
                    f"Nhạc {index}: thời gian timeline vượt quá Audio File chính "
                    f"({self._format_music_time(timeline_limit)})."
                )
            if source_end <= source_start:
                raise ValueError(f"Nhạc {index}: thời gian bài hát kết thúc phải lớn hơn bắt đầu.")
            duration = float(row.get("duration") or 0)
            if duration and source_end > duration + 0.05:
                raise ValueError(
                    f"Nhạc {index}: đoạn lấy từ bài hát vượt quá thời lượng "
                    f"{self._format_music_time(duration)}."
                )
            clips.append({
                "path": os.path.abspath(path),
                "timeline_start": timeline_start,
                "timeline_end": timeline_end,
                "source_start": source_start,
                "source_end": source_end,
                "volume_db": max(-60.0, min(20.0, float(row["volume"].get()))),
            })
        if validate:
            ordered = sorted(enumerate(clips, start=1), key=lambda item: item[1]["timeline_start"])
            for previous, current in zip(ordered, ordered[1:]):
                previous_number, previous_clip = previous
                current_number, current_clip = current
                if current_clip["timeline_start"] < previous_clip["timeline_end"] - 0.001:
                    raise ValueError(
                        f"Nhạc {previous_number} và nhạc {current_number} đang chồng thời gian trên timeline."
                    )
        return clips

    def _snapshot_music_editor(self):
        try:
            self._music_editor_working = self._collect_music_editor_rows(validate=False)
        except ValueError:
            # Khi người dùng đang nhập dở, giữ dữ liệu thô để không làm mất ô.
            working = []
            for row in self._music_editor_rows:
                working.append({
                    "path": row["path"].get().strip(),
                    "timeline_start_text": row["timeline_start"].get(),
                    "timeline_end_text": row["timeline_end"].get(),
                    "source_start_text": row["source_start"].get(),
                    "source_end_text": row["source_end"].get(),
                    "volume_db": float(row["volume"].get()),
                    "duration": row.get("duration", 0),
                })
            self._music_editor_working = working

    def _music_editor_add_file(self):
        self._snapshot_music_editor()
        path = filedialog.askopenfilename(
            parent=self._music_editor_popup,
            filetypes=[("Audio Files", "*.mp3 *.wav *.m4a *.aac *.flac *.ogg *.wma")],
        )
        if not path:
            return
        try:
            duration = get_audio_duration_us(path) / 1000000.0
        except Exception as error:
            messagebox.showerror("Thêm nhạc", str(error), parent=self._music_editor_popup)
            return
        timeline_start = 0.0
        if self._music_editor_working:
            previous = self._music_editor_working[-1]
            try:
                timeline_start = float(previous.get("timeline_end", 0))
            except (TypeError, ValueError):
                timeline_start = 0.0
        timeline_limit = float(getattr(self, "_music_timeline_duration", 0) or 0)
        if timeline_limit and timeline_start >= timeline_limit:
            timeline_start = 0.0
        timeline_end = timeline_start + duration
        if timeline_limit:
            timeline_end = min(timeline_end, timeline_limit)
        self._music_editor_working.append({
            "path": path,
            "timeline_start": timeline_start,
            "timeline_end": timeline_end,
            "source_start": 0.0,
            "source_end": duration,
            "volume_db": 0.0,
            "duration": duration,
        })
        self._create_music_editor_card(
            len(self._music_editor_working) - 1,
            self._music_editor_working[-1],
        )
        self._music_editor_popup.after_idle(
            lambda: self._music_editor_list._parent_canvas.yview_moveto(1.0)
        )

    def _music_editor_delete(self, index):
        self._stop_music_preview()
        self._snapshot_music_editor()
        if 0 <= index < len(self._music_editor_working):
            del self._music_editor_working[index]
        self._render_music_editor_rows()

    def _render_music_editor_rows(self):
        container = self._music_editor_list
        for child in container.winfo_children():
            child.destroy()
        self._music_editor_rows = []
        for index, clip in enumerate(self._music_editor_working):
            self._create_music_editor_card(index, clip)

    def _create_music_editor_card(self, index, clip):
        container = self._music_editor_list
        card = ctk.CTkFrame(
            container,
            fg_color=("gray90", "gray18"),
            border_width=1,
            border_color=("gray65", "gray38"),
            corner_radius=9,
        )
        card.pack(fill="x", padx=5, pady=7)
        header = ctk.CTkFrame(card, fg_color="transparent")
        header.pack(fill="x", padx=10, pady=(9, 4))
        ctk.CTkLabel(
            header,
            text=f"Nhạc {index + 1}",
            font=ctk.CTkFont(size=15, weight="bold"),
        ).pack(side="left")
        ctk.CTkButton(
            header,
            text="Xóa",
            width=55,
            fg_color="#b74343",
            hover_color="#963636",
            command=lambda item_index=index: self._music_editor_delete(item_index),
        ).pack(side="right")
        path_var = ctk.StringVar(value=str(clip.get("path") or ""))
        path_row = ctk.CTkFrame(card, fg_color="transparent")
        path_row.pack(fill="x", padx=10, pady=3)
        ctk.CTkLabel(path_row, text="File:", width=95, anchor="w").pack(side="left")
        ctk.CTkEntry(path_row, textvariable=path_var).pack(side="left", fill="x", expand=True)

        def time_var(key, default=0):
            value = clip.get(key + "_text", clip.get(key, default))
            if isinstance(value, str) and ":" in value:
                return ctk.StringVar(value=value)
            try:
                return ctk.StringVar(value=self._format_music_time(float(value)))
            except (TypeError, ValueError):
                return ctk.StringVar(value=str(value or ""))

        timeline_start_var = time_var("timeline_start", 0)
        timeline_end_var = time_var("timeline_end", 0)
        source_start_var = time_var("source_start", 0)
        source_end_var = time_var("source_end", 0)
        duration = float(clip.get("duration") or 0)
        if not duration and os.path.isfile(path_var.get()):
            try:
                duration = get_audio_duration_us(path_var.get()) / 1000000.0
            except Exception:
                duration = 0
        volume_value = float(clip.get("volume_db", 0.0))
        volume_var = ctk.DoubleVar(value=max(-60.0, min(20.0, volume_value)))

        timeline_row = ctk.CTkFrame(card, fg_color="transparent")
        timeline_row.pack(fill="x", padx=10, pady=3)
        ctk.CTkLabel(timeline_row, text="Trên timeline:", width=95, anchor="w").pack(side="left")
        ctk.CTkLabel(timeline_row, text="Từ").pack(side="left", padx=(0, 4))
        ctk.CTkEntry(timeline_row, textvariable=timeline_start_var, width=90).pack(side="left")
        ctk.CTkLabel(timeline_row, text="đến").pack(side="left", padx=5)
        ctk.CTkEntry(timeline_row, textvariable=timeline_end_var, width=90).pack(side="left")
        ctk.CTkLabel(timeline_row, text="(MM:SS hoặc HH:MM:SS)", text_color="gray65").pack(side="left", padx=8)

        source_row = ctk.CTkFrame(card, fg_color="transparent")
        source_row.pack(fill="x", padx=10, pady=3)
        ctk.CTkLabel(source_row, text="Đoạn bài hát:", width=95, anchor="w").pack(side="left")
        ctk.CTkLabel(source_row, text="Từ").pack(side="left", padx=(0, 4))
        source_start_entry = ctk.CTkEntry(source_row, textvariable=source_start_var, width=90)
        source_start_entry.pack(side="left")
        ctk.CTkLabel(source_row, text="đến").pack(side="left", padx=5)
        source_end_entry = ctk.CTkEntry(source_row, textvariable=source_end_var, width=90)
        source_end_entry.pack(side="left")
        ctk.CTkButton(
            source_row,
            text="Nghe thử",
            width=75,
            command=lambda p=path_var, s=source_start_var, e=source_end_var, v=volume_var: self._preview_music_clip(p.get(), s.get(), e.get(), v.get()),
        ).pack(side="left", padx=(8, 4))
        ctk.CTkButton(source_row, text="Dừng", width=55, command=self._stop_music_preview).pack(side="left")
        fit_button = ctk.CTkButton(
            source_row,
            text="Khớp Timeline",
            width=105,
        )
        fit_button.pack(side="left", padx=(5, 0))

        slider_max = max(duration, 1.0)
        try:
            initial_start = self._parse_music_time(source_start_var.get())
            initial_end = self._parse_music_time(source_end_var.get())
        except ValueError:
            initial_start, initial_end = 0.0, slider_max

        slider_row = ctk.CTkFrame(card, fg_color="transparent")
        slider_row.pack(fill="x", padx=10, pady=3)
        ctk.CTkLabel(slider_row, text="Kéo điểm lấy:", width=95, anchor="w").pack(side="left")
        ctk.CTkLabel(slider_row, text="0:00", width=38, anchor="e").pack(side="left", padx=(0, 5))

        def range_changed(start, end):
            source_start_var.set(self._format_music_time(start))
            source_end_var.set(self._format_music_time(end))

        range_slider = DualRangeSlider(
            slider_row,
            maximum=slider_max,
            start=initial_start,
            end=initial_end,
            command=range_changed,
            width=480,
        )
        range_slider.pack(side="left", fill="x", expand=True)
        ctk.CTkLabel(
            slider_row,
            text=self._format_music_time(duration),
            width=55,
            anchor="w",
        ).pack(side="left", padx=(5, 0))

        def sync_range_from_entries(_event=None):
            try:
                range_slider.set_values(
                    self._parse_music_time(source_start_var.get()),
                    self._parse_music_time(source_end_var.get()),
                )
            except ValueError:
                pass

        source_start_entry.bind("<FocusOut>", sync_range_from_entries)
        source_end_entry.bind("<FocusOut>", sync_range_from_entries)

        def fit_source_to_timeline():
            try:
                timeline_start = self._parse_music_time(timeline_start_var.get())
                timeline_end = self._parse_music_time(timeline_end_var.get())
                source_start = self._parse_music_time(source_start_var.get())
                timeline_duration = timeline_end - timeline_start
                if timeline_duration <= 0:
                    raise ValueError("Thời gian kết thúc timeline phải lớn hơn thời gian bắt đầu.")
                fitted_end = source_start + timeline_duration
                if fitted_end > duration + 0.05:
                    remaining = max(0.0, duration - source_start)
                    raise ValueError(
                        "Phần còn lại của bài hát không đủ để Khớp Timeline. "
                        f"Còn {self._format_music_time(remaining)}, cần "
                        f"{self._format_music_time(timeline_duration)}."
                    )
                source_end_var.set(self._format_music_time(fitted_end))
                range_slider.set_values(source_start, fitted_end)
            except ValueError as error:
                messagebox.showerror("Khớp Timeline", str(error), parent=self._music_editor_popup)

        fit_button.configure(command=fit_source_to_timeline)

        def format_db(value):
            rounded = int(round(float(value)))
            return f"{rounded:+d} dB" if rounded > 0 else f"{rounded} dB"

        volume_text = ctk.StringVar(value=format_db(volume_var.get()))
        volume_row = ctk.CTkFrame(card, fg_color="transparent")
        volume_row.pack(fill="x", padx=10, pady=(3, 9))
        ctk.CTkLabel(volume_row, text="Âm lượng:", width=95, anchor="w").pack(side="left")

        def volume_changed(value):
            volume_var.set(float(value))
            volume_text.set(format_db(value))
            self._set_music_preview_volume(value)

        ctk.CTkSlider(
            volume_row,
            from_=-60,
            to=20,
            number_of_steps=80,
            width=480,
            variable=volume_var,
            command=volume_changed,
        ).pack(side="left", fill="x", expand=True)
        ctk.CTkLabel(volume_row, textvariable=volume_text, width=55).pack(side="left", padx=(8, 0))

        row_data = {
            "card": card,
            "path": path_var,
            "timeline_start": timeline_start_var,
            "timeline_end": timeline_end_var,
            "source_start": source_start_var,
            "source_end": source_end_var,
            "volume": volume_var,
            "duration": duration,
            "range_slider": range_slider,
        }
        self._music_editor_rows.append(row_data)

        def select_replacement(target_var=path_var, data=row_data):
            path = filedialog.askopenfilename(
                parent=self._music_editor_popup,
                filetypes=[("Audio Files", "*.mp3 *.wav *.m4a *.aac *.flac *.ogg *.wma")],
            )
            if not path:
                return
            try:
                duration_value = get_audio_duration_us(path) / 1000000.0
            except Exception as error:
                messagebox.showerror("Chọn nhạc", str(error), parent=self._music_editor_popup)
                return
            target_var.set(path)
            data["duration"] = duration_value
            data["source_start"].set("0:00")
            data["source_end"].set(self._format_music_time(duration_value))
            data["range_slider"].set_bounds(duration_value, 0.0, duration_value)

        ctk.CTkButton(path_row, text="Chọn", width=60, command=select_replacement).pack(side="left", padx=(5, 0))

    def _open_music_structure_import(self):
        dialog = ctk.CTkToplevel(self._music_editor_popup)
        dialog.title("Import danh sách nhạc")
        dialog.geometry("650x430")
        dialog.transient(self._music_editor_popup)
        dialog.grab_set()
        ctk.CTkLabel(
            dialog,
            text="Mỗi bài một dòng: tên-file/đoạn-trên-timeline/đoạn-lấy-từ-bài-hát/âm-lượng-dB",
            font=ctk.CTkFont(size=14, weight="bold"),
        ).pack(anchor="w", padx=15, pady=(15, 4))
        ctk.CTkLabel(
            dialog,
            text="Ví dụ: name1.mp3/3:50-4:40/1:40-1:50/-20  hoặc bỏ dB để dùng 0 dB",
            text_color="gray65",
        ).pack(anchor="w", padx=15, pady=(0, 8))
        folder_var = ctk.StringVar(value=(os.path.dirname(self.background_music_files[0]) if self.background_music_files else ""))
        folder_row = ctk.CTkFrame(dialog, fg_color="transparent")
        folder_row.pack(fill="x", padx=15, pady=4)
        ctk.CTkLabel(folder_row, text="Thư mục nhạc:", width=100, anchor="w").pack(side="left")
        ctk.CTkEntry(folder_row, textvariable=folder_var).pack(side="left", fill="x", expand=True)

        def choose_folder():
            selected = filedialog.askdirectory(parent=dialog)
            if selected:
                folder_var.set(selected)

        ctk.CTkButton(folder_row, text="Browse", width=75, command=choose_folder).pack(side="left", padx=(5, 0))
        textbox = ctk.CTkTextbox(
            dialog,
            height=220,
            font=ctk.CTkFont(size=16),
        )
        textbox.pack(fill="both", expand=True, padx=15, pady=8)

        def do_import():
            imported = []
            base_folder = folder_var.get().strip()
            try:
                for line_number, raw_line in enumerate(textbox.get("1.0", "end").splitlines(), start=1):
                    line = raw_line.strip()
                    if not line:
                        continue
                    parts = [part.strip() for part in line.rsplit("/", 3)]
                    if len(parts) not in (3, 4):
                        raise ValueError(
                            f"Dòng {line_number}: nhập theo mẫu "
                            "tên-file/đoạn-trên-timeline/đoạn-lấy-từ-bài-hát/âm-lượng-dB."
                        )
                    if len(parts) == 3:
                        name, timeline_range, source_range = parts
                        volume_db = 0.0
                    else:
                        name, timeline_range, source_range, volume_text = parts
                        try:
                            volume_db = float(volume_text)
                        except ValueError:
                            raise ValueError(f"Dòng {line_number}: âm lượng phải là số dB, ví dụ -20 hoặc 5.")
                        if volume_db < -60 or volume_db > 20:
                            raise ValueError(f"Dòng {line_number}: âm lượng phải nằm trong khoảng -60 đến 20 dB.")
                    timeline_parts = timeline_range.split("-", 1)
                    source_parts = source_range.split("-", 1)
                    if len(timeline_parts) != 2 or len(source_parts) != 2:
                        raise ValueError(f"Dòng {line_number}: khoảng thời gian phải có dấu -.")
                    path = name if os.path.isabs(name) else os.path.join(base_folder, name)
                    path = os.path.abspath(path)
                    if not os.path.isfile(path):
                        raise ValueError(f"Dòng {line_number}: không tìm thấy file {path}")
                    duration = get_audio_duration_us(path) / 1000000.0
                    timeline_start = self._parse_music_time(timeline_parts[0])
                    timeline_end = self._parse_music_time(timeline_parts[1])
                    source_start = self._parse_music_time(source_parts[0])
                    source_end = self._parse_music_time(source_parts[1])
                    if timeline_end <= timeline_start or source_end <= source_start:
                        raise ValueError(f"Dòng {line_number}: thời gian kết thúc phải lớn hơn bắt đầu.")
                    timeline_limit = float(getattr(self, "_music_timeline_duration", 0) or 0)
                    if timeline_limit and timeline_end > timeline_limit + 0.05:
                        raise ValueError(
                            f"Dòng {line_number}: thời gian timeline vượt quá Audio File chính "
                            f"({self._format_music_time(timeline_limit)})."
                        )
                    if source_end > duration + 0.05:
                        raise ValueError(f"Dòng {line_number}: đoạn nguồn dài hơn bài hát.")
                    imported.append({
                        "path": path,
                        "timeline_start": timeline_start,
                        "timeline_end": timeline_end,
                        "source_start": source_start,
                        "source_end": source_end,
                        "volume_db": volume_db,
                        "duration": duration,
                    })
            except Exception as error:
                messagebox.showerror("Import thất bại", str(error), parent=dialog)
                return
            if not imported:
                messagebox.showerror("Import thất bại", "Chưa có dòng nhạc nào để import.", parent=dialog)
                return
            self._snapshot_music_editor()
            self._music_editor_working.extend(imported)
            dialog.destroy()
            self._render_music_editor_rows()

        ctk.CTkButton(dialog, text="Nạp danh sách", width=130, command=do_import).pack(pady=(2, 15))

    def open_background_music_editor(self, show_main_value):
        if self._music_editor_popup is not None and self._music_editor_popup.winfo_exists():
            self._music_editor_popup.focus_force()
            return
        audio_paths = [path for path in self.audio_files if os.path.isfile(path)]
        if not audio_paths:
            messagebox.showwarning(
                "Chưa chọn Audio File",
                "Vui lòng chọn Audio File chính trước khi chỉnh nhạc nền.",
                parent=self,
            )
            return
        try:
            self._music_timeline_duration = sum(
                get_audio_duration_us(path) / 1000000.0
                for path in audio_paths
            )
        except Exception as error:
            messagebox.showerror(
                "Không đọc được Audio File",
                str(error),
                parent=self,
            )
            return
        self._music_editor_working = [dict(item) for item in self.background_music_clips]
        if not self._music_editor_working and self.background_music_files:
            cursor = 0.0
            for path in self.background_music_files:
                try:
                    duration = get_audio_duration_us(path) / 1000000.0
                except Exception:
                    duration = 0.0
                timeline_end = min(cursor + duration, self._music_timeline_duration)
                if timeline_end <= cursor:
                    cursor = 0.0
                    timeline_end = min(duration, self._music_timeline_duration)
                self._music_editor_working.append({
                    "path": path,
                    "timeline_start": cursor,
                    "timeline_end": timeline_end,
                    "source_start": 0.0,
                    "source_end": duration,
                    "volume_db": 0.0,
                    "duration": duration,
                })
                cursor = timeline_end

        popup = ctk.CTkToplevel(self)
        self._music_editor_popup = popup
        popup.title("Sắp nhạc nền")
        popup.geometry("800x680")
        popup.minsize(720, 560)
        popup.transient(self)
        popup.grab_set()
        ctk.CTkLabel(
            popup,
            text="TÙY CHỌN VỊ TRÍ NHẠC NỀN TRÊN TIMELINE",
            font=ctk.CTkFont(size=20, weight="bold"),
        ).pack(pady=(15, 4))
        ctk.CTkLabel(
            popup,
            text="Chọn vị trí nhạc xuất hiện và thời gian nhạc bắt đầu",
            text_color="gray65",
        ).pack(pady=(0, 8))
        toolbar = ctk.CTkFrame(popup, fg_color="transparent")
        toolbar.pack(fill="x", padx=15, pady=4)
        ctk.CTkButton(toolbar, text="+ Thêm nhạc", width=120, command=self._music_editor_add_file).pack(side="left")
        ctk.CTkButton(toolbar, text="Import cấu trúc", width=130, command=self._open_music_structure_import).pack(side="left", padx=8)
        self._music_editor_list = ctk.CTkScrollableFrame(popup)
        self._music_editor_list.pack(fill="both", expand=True, padx=15, pady=8)
        self._render_music_editor_rows()

        buttons = ctk.CTkFrame(popup, fg_color="transparent")
        buttons.pack(fill="x", padx=15, pady=(0, 15))

        def close_popup():
            self._stop_music_preview()
            try:
                popup.grab_release()
            except Exception:
                pass
            popup.destroy()
            self._music_editor_popup = None

        def save():
            try:
                clips = self._collect_music_editor_rows(validate=True)
            except Exception as error:
                messagebox.showerror("Thông tin nhạc chưa hợp lệ", str(error), parent=popup)
                return
            self.background_music_clips = clips
            self.background_music_files = list(dict.fromkeys(item["path"] for item in clips))
            if clips:
                show_main_value(f"Đã sắp {len(clips)} bài nhạc trên timeline")
            else:
                show_main_value("Có thể chọn nhiều file nhạc nền", placeholder_color=True)
            close_popup()

        ctk.CTkButton(buttons, text="Lưu", width=110, command=save).pack(side="right")
        ctk.CTkButton(buttons, text="Hủy", width=90, fg_color="gray35", command=close_popup).pack(side="right", padx=8)
        popup.protocol("WM_DELETE_WINDOW", close_popup)

    def create_dir_selector(self, parent, label_text, placeholder="", font=None):
        f = ctk.CTkFrame(parent, fg_color="transparent")
        f.pack(fill="x", pady=5, padx=10)
        ctk.CTkLabel(f, text=label_text, width=150, anchor="w").pack(side="left")
        entry = ctk.CTkEntry(f, font=font)
        entry.pack(side="left", fill="x", expand=True, padx=5)
        
        if placeholder:
            entry.insert(0, placeholder)
            entry.configure(text_color="gray60")
        entry.configure(state="readonly")

        def browse():
            dirpath = filedialog.askdirectory()
            if dirpath:
                entry.configure(state="normal")
                entry.delete(0, 'end')
                entry.insert(0, dirpath)
                entry.configure(text_color=("gray10", "gray90"))
                entry.configure(state="readonly")
        ctk.CTkButton(f, text="Browse", width=80, command=browse).pack(side="left")
        return entry

    def log(self, text):
        self._log_queue.put(str(text))

    def _post_ui(self, action, *args):
        self._ui_queue.put((action, args))

    def _drain_log_queue(self):
        pending_logs = []
        try:
            while True:
                pending_logs.append(self._log_queue.get_nowait())
        except queue.Empty:
            pass

        if pending_logs:
            self.log_box.insert("end", "\n".join(pending_logs) + "\n")
            self.log_box.see("end")

        try:
            while True:
                action, args = self._ui_queue.get_nowait()
                if action == "error":
                    messagebox.showerror("Lỗi", args[0])
                elif action == "count_error":
                    messagebox.showerror("Lỗi Số Lượng (Kiểm Tra Nhanh)", args[0])
                elif action == "success":
                    messagebox.showinfo("Thành công", args[0])
                elif action == "watermark_success":
                    self._show_watermark_success(args[0], args[1])
                elif action == "reset_button":
                    self._reset_generation_button()
        except queue.Empty:
            pass

        if self.winfo_exists():
            self.after(50, self._drain_log_queue)

    def _show_watermark_success(self, image_count, output_dir):
        output_dir = os.path.abspath(str(output_dir))
        popup = ctk.CTkToplevel(self)
        popup.title("Thành công")
        popup.geometry("570x250")
        popup.resizable(False, False)
        popup.transient(self)
        popup.grab_set()

        ctk.CTkLabel(
            popup,
            text="XỬ LÝ WATERMARK HOÀN TẤT",
            font=ctk.CTkFont(size=18, weight="bold"),
        ).pack(pady=(25, 13))
        ctk.CTkLabel(
            popup,
            text=f"Đã xử lý {image_count} ảnh.",
            font=ctk.CTkFont(size=14),
        ).pack(pady=(0, 5))
        ctk.CTkLabel(
            popup,
            text=f"Kết quả: {output_dir}",
            wraplength=520,
            justify="center",
            text_color="gray70",
        ).pack(padx=24, pady=(0, 18))

        def close_popup():
            try:
                popup.grab_release()
            except Exception:
                pass
            popup.destroy()

        def open_output_folder():
            if not os.path.isdir(output_dir):
                messagebox.showerror(
                    "Lỗi",
                    "Không tìm thấy thư mục kết quả.",
                    parent=popup,
                )
                return
            try:
                os.startfile(output_dir)
            except OSError as error:
                messagebox.showerror(
                    "Lỗi",
                    f"Không thể mở thư mục kết quả:\n{error}",
                    parent=popup,
                )

        button_row = ctk.CTkFrame(popup, fg_color="transparent")
        button_row.pack(pady=(0, 22))
        ctk.CTkButton(
            button_row,
            text="MỞ THƯ MỤC",
            width=145,
            height=38,
            command=open_output_folder,
        ).pack(side="left", padx=6)
        ctk.CTkButton(
            button_row,
            text="OK",
            width=110,
            height=38,
            command=close_popup,
        ).pack(side="left", padx=6)

        popup.protocol("WM_DELETE_WINDOW", close_popup)
        popup.bind("<Escape>", lambda _event: close_popup())
        popup.after(100, popup.focus_force)

    @staticmethod
    def _snapshot_project_directories(project_root):
        if not project_root or not os.path.isdir(project_root):
            return set()
        try:
            return {
                os.path.normcase(os.path.abspath(entry.path))
                for entry in os.scandir(project_root)
                if entry.is_dir(follow_symlinks=False)
            }
        except OSError:
            return set()

    def _begin_generation(self, project_root=None, target_name=None, clone_base_name=None):
        self._generation_cancel_event.clear()
        self._generation_running = True
        self._generation_cleanup_context = {
            "project_root": os.path.abspath(project_root) if project_root else None,
            "target_name": str(target_name or "").casefold(),
            "clone_base_name": str(clone_base_name or "").casefold(),
            "before": self._snapshot_project_directories(project_root),
        }
        self.generate_btn.configure(
            state="normal",
            text="HỦY",
            command=self.cancel_generation,
            fg_color="#c0392b",
            hover_color="#922b21",
        )

    def _reset_generation_button(self):
        self._generation_running = False
        self._generation_cancel_event.clear()
        self._generation_cleanup_context = None
        self.generate_btn.configure(
            state="normal",
            text="TẠO PROJECT CAPCUT",
            command=self.start_generation,
            fg_color=self._generate_button_default_fg,
            hover_color=self._generate_button_default_hover,
        )

    def cancel_generation(self):
        if not self._generation_running or self._generation_cancel_event.is_set():
            return
        self._generation_cancel_event.set()
        self.generate_btn.configure(state="disabled", text="ĐANG HỦY...")
        self.log("\n[ĐANG HỦY] Đang dừng hoàn toàn quá trình tạo project...")

        def terminate_worker():
            with self._active_worker_lock:
                process = self._active_worker_process
            if process is not None:
                try:
                    if process.is_alive():
                        process.terminate()
                except (OSError, ValueError):
                    pass

        threading.Thread(target=terminate_worker, daemon=True).start()

    def _raise_if_generation_cancelled(self):
        if self._generation_cancel_event.is_set():
            raise GenerationCancelled()

    def _cleanup_cancelled_generation_artifacts(self):
        context = self._generation_cleanup_context or {}
        project_root = context.get("project_root")
        if not project_root or not os.path.isdir(project_root):
            return
        before = context.get("before") or set()
        target_name = context.get("target_name") or ""
        clone_base_name = context.get("clone_base_name") or ""
        removed = []
        try:
            entries = list(os.scandir(project_root))
        except OSError:
            return
        for entry in entries:
            if not entry.is_dir(follow_symlinks=False):
                continue
            path = os.path.normcase(os.path.abspath(entry.path))
            if path in before:
                continue
            name = entry.name.casefold()
            is_target = bool(target_name and name == target_name)
            is_clone = bool(
                clone_base_name
                and (name == clone_base_name or name.startswith(clone_base_name + " ("))
            )
            if not (is_target or is_clone):
                continue
            try:
                shutil.rmtree(entry.path)
                removed.append(entry.name)
            except OSError as error:
                self.log(f"[CẢNH BÁO] Không thể xóa project đang tạo dở: {error}")
        if removed:
            self.log("Đã xóa project tạo dở: " + ", ".join(removed))

    def _run_worker_process(self, target, *args):
        """Run protected CPU-heavy code outside the Tkinter process."""
        self._raise_if_generation_cancelled()
        context = multiprocessing.get_context("spawn")
        receiver, sender = context.Pipe(duplex=False)
        process = context.Process(target=target, args=(sender, *args))
        process.start()
        with self._active_worker_lock:
            self._active_worker_process = process
        sender.close()

        result = None
        error = None
        try:
            while True:
                if self._generation_cancel_event.is_set():
                    if process.is_alive():
                        process.terminate()
                    raise GenerationCancelled()
                try:
                    process_alive = process.is_alive()
                    has_message = receiver.poll(0.1 if process_alive else 0)
                except (EOFError, BrokenPipeError, OSError):
                    break

                if not process_alive and not has_message:
                    break
                if not has_message:
                    continue
                try:
                    kind, payload = receiver.recv()
                except (EOFError, BrokenPipeError, OSError):
                    break
                if kind == "log":
                    self.log(payload)
                elif kind == "result":
                    result = payload
                elif kind == "error":
                    error = payload
        finally:
            receiver.close()
            if self._generation_cancel_event.is_set() and process.is_alive():
                process.terminate()
            process.join(timeout=3)
            if process.is_alive():
                process.kill()
                process.join(timeout=1)
            with self._active_worker_lock:
                if self._active_worker_process is process:
                    self._active_worker_process = None

        self._raise_if_generation_cancelled()
        if error:
            raise RuntimeError(error)
        if process.exitcode != 0:
            raise RuntimeError(
                f"Tiến trình xử lý dừng bất thường (mã {process.exitcode})."
            )
        if result is None:
            raise RuntimeError("Tiến trình xử lý không trả về kết quả.")
        return result

    def open_batch_export_popup(self):
        if self._generation_running:
            messagebox.showinfo("Đang tạo project", "Hãy chờ tác vụ hiện tại hoàn tất trước khi xuất hàng loạt.")
            return
        popup = getattr(self, '_batch_export_popup', None)
        if popup is not None and popup.winfo_exists():
            popup.deiconify()
            popup.lift()
            popup.focus_force()
            return
        from batch_export_ui import BatchExportPopup
        self._batch_export_popup = BatchExportPopup(self)

    def start_generation(self):
        popup = getattr(self, '_batch_export_popup', None)
        if popup is not None and popup.winfo_exists() and popup.running:
            messagebox.showinfo("Đang xuất video", "Hãy chờ xuất hàng loạt hoàn tất hoặc bấm Hủy trong popup xuất.")
            return
        def has_selection(entry, placeholder):
            value = entry.get().strip()
            return bool(value and value != placeholder)

        try:
            self.license_manager.require_execution("gui-create-start")
        except PermissionError:
            self.refresh_license_button()
            self.open_license_popup()
            return
        self.refresh_license_button()

        media_dir = self.image_dir.get().strip()
        media_selected = has_selection(self.image_dir, "Chọn thư mục chứa ảnh hoặc video")
        if not media_selected:
            media_dir = ""
        watermark_only = bool(
            self.remove_gemini_watermark.get()
            and media_selected
            and not self.audio_files
            and not has_selection(self.srt_path, "Chọn file SRT hoặc TXT")
            and not self.get_scenes_content()
            and not has_selection(self.project_name, "Đặt tên cho dự án CapCut")
            and not self.background_music_files
            and not self.background_music_clips
        )

        if watermark_only:
            if not os.path.isdir(media_dir):
                messagebox.showerror(
                    "Lỗi",
                    "Không tìm thấy thư mục ảnh đã chọn. Vui lòng bấm Browse và chọn lại Media Folder.",
                )
                return
            self._begin_generation()
            self.log_box.delete("1.0", "end")
            self.log("Chế độ chỉ xóa watermark: đang quét thư mục ảnh...")
            self.update_idletasks()
            threading.Thread(target=self.run_watermark_only, args=(media_dir,), daemon=True).start()
            return

        project_root = self.capcut_project_dir_setting.get().strip()
        if not project_root or not os.path.isdir(project_root):
            messagebox.showerror(
                "Lỗi",
                "Không tìm thấy thư mục lưu dự án CapCut. Vui lòng mở Cài đặt và chọn lại vị trí lưu.",
            )
            return

        project_name_selected = has_selection(
            self.project_name,
            "Đặt tên cho dự án CapCut",
        )
        project_name = ""
        if project_name_selected:
            try:
                project_name = validate_project_name(self.project_name.get())
            except ValueError as error:
                messagebox.showerror("Tên dự án không hợp lệ", str(error))
                self.project_name.focus_set()
                self.project_name.select_range(0, "end")
                return

        existing_projects = (
            find_capcut_projects_by_name(project_root, project_name)
            if project_name
            else []
        )
        creation_inputs_present = any((
            bool(self.audio_files),
            has_selection(self.audio_path, "Chọn một hoặc nhiều file audio"),
            has_selection(self.srt_path, "Chọn file SRT hoặc TXT"),
            bool(self.get_scenes_content()),
            media_selected,
            bool(self.background_music_files),
            bool(self.background_music_clips),
            has_selection(
                self.background_music_entry,
                "Có thể chọn nhiều file nhạc nền",
            ),
        ))
        if existing_projects and creation_inputs_present:
            messagebox.showerror(
                "Trùng tên dự án",
                f'Đã tồn tại dự án CapCut có tên "{project_name}". '
                "Vui lòng nhập tên dự án khác.",
            )
            self.project_name.focus_set()
            self.project_name.select_range(0, "end")
            return

        if existing_projects:
            transition_settings = self.get_transition_settings()
            effect_settings = self.get_effect_settings()
            sound_effect_settings = self.get_sound_effect_settings()
            animation_settings = self.get_animation_settings()
            selected_keys = (
                transition_settings.get("selected", [])
                + effect_settings.get("selected", [])
                + sound_effect_settings.get("selected", [])
                + [k for values in animation_settings.get("selected", {}).values() for k in values]
            )
            if not any(key != "none" for key in selected_keys):
                messagebox.showerror(
                    "Chưa chọn nội dung",
                    "Project này đã tồn tại. Hãy chọn ít nhất một Transition, "
                    "Hiệu ứng, Animation hoặc Sound effect để ghép vào project.",
                )
                return

            selected_project = existing_projects[0]
            job = {
                "project_path": selected_project["path"],
                "project_name": selected_project["name"],
                "project_root": project_root,
                "transition_settings": transition_settings,
                "effect_settings": effect_settings,
                "sound_effect_settings": sound_effect_settings,
                "animation_settings": animation_settings,
                "duplicate_count": len(existing_projects),
            }
            self._begin_generation(
                project_root=project_root,
                clone_base_name=f'{selected_project["name"]} AutoCapCut',
            )
            self.log_box.delete("1.0", "end")
            self.log(f'Đang tạo bản sao từ project CapCut: "{selected_project["name"]}"')
            self.log("Không cần chọn Audio, SRT, Scenes hoặc Media Folder.")
            if len(existing_projects) > 1:
                self.log(
                    f'[CẢNH BÁO] Có {len(existing_projects)} project trùng tên; '
                    "tool dùng project được sửa gần đây nhất."
                )
            self.log("Project gốc sẽ được giữ nguyên; tool chỉ chỉnh sửa bản sao AutoCapCut.")
            self.update_idletasks()
            threading.Thread(
                target=self.run_existing_project_asset_job,
                args=(job,),
                daemon=True,
            ).start()
            return

        audio_files = sorted(self.audio_files, key=self.natural_sort_key)
        multi_audio_mode = len(audio_files) > 1
        if not audio_files or not project_name_selected:
            messagebox.showerror(
                "Lỗi",
                "Vui lòng chọn audio và tên dự án CapCut!",
            )
            return
        if not multi_audio_mode and not all([
            has_selection(self.srt_path, "Chọn file SRT hoặc TXT"),
            self.get_scenes_content(),
        ]):
            messagebox.showerror(
                "Lỗi",
                "Khi chọn một audio, vui lòng chọn SRT và nhập nội dung Scenes.",
            )
            return

        audio_path = audio_files[0]
        srt_path = self.srt_path.get().strip()
        for selected_audio in audio_files:
            if not os.path.isfile(selected_audio):
                messagebox.showerror(
                    "Lỗi",
                    f"Không tìm thấy file audio: {os.path.basename(selected_audio)}. Vui lòng chọn lại.",
                )
                return
        if not multi_audio_mode and not os.path.isfile(srt_path):
            messagebox.showerror(
                "Lỗi",
                "Không tìm thấy file phụ đề đã chọn. Vui lòng bấm Browse và chọn lại file SRT hoặc TXT.",
            )
            return
        if media_selected and not os.path.isdir(media_dir):
            messagebox.showerror(
                "Lỗi",
                "Không tìm thấy thư mục ảnh/video đã chọn. Vui lòng bấm Browse và chọn lại Media Folder.",
            )
            return
        for music_path in self.background_music_files:
            if not os.path.isfile(music_path):
                messagebox.showerror(
                    "Lỗi",
                    f"Không tìm thấy file nhạc nền: {os.path.basename(music_path)}. Vui lòng chọn lại.",
                )
                return
        for clip in self.background_music_clips:
            music_path = str(clip.get("path") or "")
            if not os.path.isfile(music_path):
                messagebox.showerror(
                    "Lỗi",
                    f"Không tìm thấy file nhạc nền: {os.path.basename(music_path)}. Vui lòng mở Edit và chọn lại.",
                )
                return

        if not multi_audio_mode:
            try:
                compatibility = check_scene_srt_compatibility(
                    self.get_scenes_content(),
                    srt_path,
                    max_scenes=10,
                )
            except (OSError, ValueError, TypeError) as error:
                messagebox.showerror(
                    "Không thể kiểm tra Scenes và SRT",
                    f"Không thể đọc nội dung để kiểm tra:\n{error}",
                )
                return
            if not compatibility["compatible"]:
                messagebox.showerror(
                    "Scenes và SRT không khớp",
                    "Có sự khác nhau giữa file Scenes và file SRT.\n\n"
                    "Hãy kiểm tra lại nội dung hai file.",
                )
                return

        if project_name_exists(project_name, project_root):
            messagebox.showerror(
                "Lỗi",
                f'Đã tồn tại dự án CapCut có tên "{project_name}". Vui lòng nhập tên dự án khác.',
            )
            return

        try:
            motion_settings = self.get_motion_settings()
        except Exception as error:
            messagebox.showerror("Thông số keyframe", str(error))
            error_entry = getattr(self, "_last_motion_error_entry", None)
            if error_entry is not None:
                self.after(50, error_entry.focus_set)
            return

        job = {
            "audio_file": audio_path,
            "audio_files": audio_files,
            "srt_file": srt_path,
            "scenes_content": self.number_scene_lines(self.get_scenes_content()),
            "image_dir": media_dir,
            "placeholder_media": not media_selected,
            "project_name": project_name,
            "motion_settings": motion_settings,
            "transition_settings": self.get_transition_settings(),
            "effect_settings": self.get_effect_settings(),
            "sound_effect_settings": self.get_sound_effect_settings(),
            "animation_settings": self.get_animation_settings(),
            "sort_order": self.sort_combo.get(),
            "add_subtitles": self.add_subtitles.get() if not multi_audio_mode else False,
            "subtitle_mode": self.subtitle_mode_setting.get(),
            "capcut_version": self.capcut_version_setting.get(),
            "remove_gemini_watermark": self.remove_gemini_watermark.get(),
            "background_music_paths": list(self.background_music_files),
            "background_music_clips": [dict(item) for item in self.background_music_clips],
            "match_mode": self.match_mode_setting.get(),
            "project_root": project_root,
            "long_video_mode": self.long_video_setting.get(),
        }

        self._begin_generation(
            project_root=project_root,
            target_name=project_name,
        )
        self.log_box.delete("1.0", "end")
        self.log("Bắt đầu tạo project...")
        self.update_idletasks()
        threading.Thread(target=self.run_logic, args=(job,), daemon=True).start()

    def run_existing_project_asset_job(self, job):
        try:
            self._raise_if_generation_cancelled()
            self.license_manager.require_execution("gui-existing-project-dispatch")
            result = self._run_worker_process(
                update_existing_project_worker,
                {
                    "source_project_path": job["project_path"],
                    "source_project_name": job["project_name"],
                    "project_root": job["project_root"],
                    "transition_settings": job["transition_settings"],
                    "effect_settings": job["effect_settings"],
                    "sound_effect_settings": job["sound_effect_settings"],
                    "animation_settings": job.get("animation_settings", {}),
                },
            )
            self._raise_if_generation_cancelled()
            self.log(
                "Đã ghép vào project: "
                f'{result["transition_count"]} transition, '
                f'{result["effect_count"]} hiệu ứng, '
                f'{result.get("animation_count", 0)} animation, '
                f'{result["sound_count"]} sound effect.'
            )
            self.log(
                "Đã xóa nội dung cũ: "
                f'{result["removed_transition_count"]} transition, '
                f'{result["removed_effect_count"]} hiệu ứng, '
                f'{result.get("removed_animation_count", 0)} animation, '
                f'{result["removed_sound_count"]} sound effect.'
            )
            self.log(f'Project bản sao: {result["project_path"]}')
            self.log("\n[THÀNH CÔNG] Đã tạo và cập nhật project bản sao.")
            self._post_ui(
                "success",
                "Đã tạo bản sao và ghép nội dung thành công!\n"
                f'Tên: {result["project_name"]}\n\n'
                "Project gốc được giữ nguyên.",
            )
        except GenerationCancelled:
            self.log("\n[ĐÃ HỦY] Đã dừng hoàn toàn. Không tạo project bản sao.")
        except Exception as error:
            error_text = str(error)
            self.log(f"\n[LỖI] {error_text}")
            self._post_ui(
                "error",
                "Không thể ghép vào project CapCut có sẵn:\n"
                f"{error_text}",
            )
        finally:
            if self._generation_cancel_event.is_set():
                self._cleanup_cancelled_generation_artifacts()
            self._post_ui("reset_button")

    def _process_watermark_images(self, image_files, image_dir, copy_original_on_failure=False):
        output_dir = os.path.join(image_dir, "no watermark")
        os.makedirs(output_dir, exist_ok=True)
        self.log(f"Đang xóa watermark Gemini khỏi {len(image_files)} ảnh...")
        replaced_paths = {}
        not_detected = []
        failed = []
        processed_count = 0
        copied_original_count = 0

        for index, source_path in enumerate(image_files, start=1):
            self._raise_if_generation_cancelled()
            file_name = os.path.basename(source_path)
            self.log(f"Xóa watermark: {index}/{len(image_files)} - {file_name}")
            if not is_processable_image(source_path):
                result = {"applied": False, "reason": "unsupported_format"}
            else:
                result = process_image(source_path, output_dir)
            if result.get("applied") and result.get("output"):
                replaced_paths[source_path] = result["output"]
                processed_count += 1
                continue

            reason = result.get("reason", "unknown_error")
            if reason == "watermark_not_found":
                not_detected.append(file_name)
            else:
                failed.append((file_name, reason))

            if copy_original_on_failure:
                destination = os.path.join(output_dir, file_name)
                try:
                    shutil.copy2(source_path, destination)
                    replaced_paths[source_path] = destination
                    copied_original_count += 1
                except OSError as error:
                    failed.append((file_name, f"copy_failed: {error}"))

        self.log(f"Đã xóa watermark: {processed_count} ảnh")
        self.log(f"Không phát hiện watermark: {len(not_detected)} ảnh")
        for file_name in not_detected:
            self.log(f"  - {file_name}")
        if failed:
            fallback_text = "Đã sao chép ảnh gốc" if copy_original_on_failure else "Sử dụng ảnh gốc"
            self.log(f"Xử lý lỗi: {len(failed)} ảnh. {fallback_text}:")
            for file_name, reason in failed:
                self.log(f"  - {file_name} ({reason})")
        if copy_original_on_failure:
            self.log(f"Ảnh gốc được sao chép không thay đổi: {copied_original_count}")
        self.log(f"Thư mục kết quả: {output_dir}")
        return {
            "paths": [replaced_paths.get(path, path) for path in image_files],
            "output_dir": output_dir,
            "processed": processed_count,
            "not_detected": not_detected,
            "failed": failed,
            "copied_original": copied_original_count,
        }

    def run_watermark_only(self, image_dir):
        try:
            self.license_manager.require_execution("watermark-only-start")
            image_files = [
                os.path.join(image_dir, name)
                for name in os.listdir(image_dir)
                if os.path.isfile(os.path.join(image_dir, name))
                and os.path.splitext(name)[1].lower() in IMAGE_EXTENSIONS
            ]
            image_files.sort(key=self.natural_sort_key)
            if not image_files:
                self._post_ui("error", "Không tìm thấy file ảnh được hỗ trợ trong thư mục đã chọn.")
                return
            video_count = sum(
                1
                for name in os.listdir(image_dir)
                if os.path.isfile(os.path.join(image_dir, name))
                and is_supported_media_file(name)
                and os.path.splitext(name)[1].lower() not in IMAGE_EXTENSIONS
            )
            if video_count:
                self.log(f"Đã bỏ qua {video_count} file video.")
            result = self._process_watermark_images(
                image_files,
                image_dir,
                copy_original_on_failure=True,
            )
            self._raise_if_generation_cancelled()
            self.license_manager.require_execution("watermark-only-finish")
            self._post_ui(
                "watermark_success",
                len(image_files),
                result["output_dir"],
            )
        except GenerationCancelled:
            self.log("\n[ĐÃ HỦY] Đã dừng hoàn toàn quá trình xử lý watermark.")
        except Exception as error:
            self.log(f"[LỖI] {error}")
            self._post_ui("error", f"Đã xảy ra lỗi:\n{error}")
        finally:
            self._post_ui("reset_button")

    def _run_multi_audio_job(
        self,
        job,
        audio_files,
        image_dir,
        proj_name,
        motion_settings,
        transition_settings,
        effect_settings,
        sound_effect_settings,
    ):
        """Build a sequential timeline where each audio owns one media item."""
        audio_files = sorted(audio_files, key=self.natural_sort_key)
        animation_settings = job.get("animation_settings", {})
        placeholder_media = bool(job.get("placeholder_media")) or not image_dir or image_dir.startswith("Chọn")
        image_files = [None] * len(audio_files) if placeholder_media else [
            os.path.join(image_dir, name)
            for name in os.listdir(image_dir)
            if is_supported_media_file(name)
            and os.path.isfile(os.path.join(image_dir, name))
        ]

        sort_order = job["sort_order"]
        if not placeholder_media and sort_order == "Sắp xếp media theo ABC":
            image_files.sort(key=self.natural_sort_key)
        elif not placeholder_media and sort_order == "Sắp xếp media theo thời gian Cũ đến Mới":
            image_files.sort(key=lambda path: os.path.getctime(path))
        elif not placeholder_media and sort_order == "Sắp xếp media theo thời gian Mới đến Cũ":
            image_files.sort(key=lambda path: os.path.getctime(path), reverse=True)

        self.log("Chế độ nhiều audio: bỏ qua SRT và Scenes.")
        if placeholder_media:
            self.log("Media Folder trống: xen kẽ ảnh splash AutoCapCut và ảnh vàng 16:9 theo từng audio.")
        self.log(f"Đã nhận {len(audio_files)} audio và {len(image_files)} media.")
        if len(audio_files) != len(image_files):
            self.log(
                f"[LỖI] Kiểm tra nhanh: {len(audio_files)} audio vs {len(image_files)} media."
            )
            self._post_ui(
                "count_error",
                "Số file audio và số ảnh/video không bằng nhau!\n\n"
                f"Số audio: {len(audio_files)}\n"
                f"Số ảnh/video: {len(image_files)}\n\n"
                "Mỗi audio cần đúng một ảnh hoặc video tương ứng.",
            )
            return

        if not placeholder_media and job.get("remove_gemini_watermark"):
            candidate_images = [
                path for path in image_files
                if os.path.splitext(path)[1].lower() in IMAGE_EXTENSIONS
            ]
            watermark_result = self._process_watermark_images(
                candidate_images,
                image_dir,
                copy_original_on_failure=False,
            )
            replacements = dict(zip(candidate_images, watermark_result["paths"]))
            image_files = [replacements.get(path, path) for path in image_files]

        timings = {}
        cursor_us = 0
        for index, (audio_path, media_path) in enumerate(
            zip(audio_files, image_files),
            start=1,
        ):
            self._raise_if_generation_cancelled()
            self.log(
                f"Đọc thời lượng audio {index}/{len(audio_files)}: "
                f"{os.path.basename(audio_path)}"
            )
            duration_us = get_audio_duration_us(audio_path)
            start_seconds = cursor_us / 1000000.0
            cursor_us += duration_us
            end_seconds = cursor_us / 1000000.0
            timings[index] = {
                "text": "",
                "speech_start": start_seconds,
                "speech_end": end_seconds,
                "video_start": start_seconds,
                "video_end": end_seconds,
                "duration": duration_us / 1000000.0,
                "video_start_us": cursor_us - duration_us,
                "video_end_us": cursor_us,
                "duration_us": duration_us,
                "image_path": media_path,
            }

        self.license_manager.require_execution("gui-before-project")
        self.log("Đang tạo project CapCut từ nhiều audio...")
        if motion_settings.get("enabled"):
            modes_text = ", ".join(motion_settings["modes"])
            mix_text = "ngẫu nhiên" if motion_settings.get("random") else "xoay vòng"
            self.log(f"Auto keyframe: bật ({mix_text}) - {modes_text}")
        transition_names = [
            "Không transition" if key == "none" else TRANSITION_PRESETS[key]["name"]
            for key in transition_settings["selected"]
        ]
        transition_mode = (
            "trộn ngẫu nhiên" if transition_settings.get("random") else "xoay vòng"
        )
        self.log(f"Transition: {transition_mode} - " + ", ".join(transition_names))
        effect_names = [
            "Không hiệu ứng" if key == "none" else VIDEO_EFFECT_PRESETS[key]["name"]
            for key in effect_settings["selected"]
            if key == "none" or key in VIDEO_EFFECT_PRESETS
        ]
        effect_mode = (
            "trộn ngẫu nhiên" if effect_settings.get("random") else "xoay vòng"
        )
        self.log(f"Hiệu ứng: {effect_mode} - " + ", ".join(effect_names))
        sound_effect_names = [
            "Không sound effect"
            if key == "none"
            else SOUND_EFFECT_PRESETS[key]["name"]
            for key in sound_effect_settings["selected"]
            if key == "none" or key in SOUND_EFFECT_PRESETS
        ]
        sound_effect_mode = (
            "trộn ngẫu nhiên"
            if sound_effect_settings.get("random")
            else "xoay vòng"
        )
        self.log(
            f"Sound effects: {sound_effect_mode} - "
            + ", ".join(sound_effect_names)
        )

        proj_folder = self._run_worker_process(
            create_project_worker,
            {
                "project_name": proj_name,
                "audio_path": audio_files[0],
                "audio_paths": audio_files,
                "image_timings": timings,
                "placeholder_splash_path": _resource_path("splash_v43.png") if placeholder_media else None,
                "add_subtitles": False,
                "subtitle_mode": job["subtitle_mode"],
                "subtitle_srt_path": job["srt_file"],
                "motion_settings": motion_settings,
                "project_root": job["project_root"],
                "long_video_mode": job["long_video_mode"],
                "transition_settings": transition_settings,
                "effect_settings": effect_settings,
                "sound_effect_settings": sound_effect_settings,
                "animation_settings": animation_settings,
                "background_music_paths": job.get("background_music_paths", []),
                "background_music_clips": job.get("background_music_clips", []),
                "capcut_version": job["capcut_version"],
            },
        )
        self._raise_if_generation_cancelled()
        self.log(f"\n[THÀNH CÔNG] Project đã được tạo tại:\n{proj_folder}")
        self.log("\nMỗi media đã được căn theo đúng thời lượng audio tương ứng.")
        self._post_ui(
            "success",
            f"Đã tạo project CapCut thành công!\nTên: {proj_name}",
        )
    def run_logic(self, job):
        scenes_file = None
        try:
            self._raise_if_generation_cancelled()
            self.license_manager.require_execution("gui-worker-dispatch")
            audio_files = sorted(
                job.get("audio_files") or [job["audio_file"]],
                key=self.natural_sort_key,
            )
            multi_audio_mode = len(audio_files) > 1
            audio_file = audio_files[0] if audio_files else ""
            srt_file = job.get("srt_file", "")
            scenes_content = job.get("scenes_content", "")
            image_dir = job["image_dir"]
            placeholder_media = bool(job.get("placeholder_media")) or not image_dir or image_dir.startswith("Chọn")
            proj_name = job["project_name"]

            if not audio_file:
                raise Exception("Vui lòng chọn file audio!")
            if proj_name.startswith("Đặt tên") or not proj_name:
                proj_name = "My_New_Project"
            for selected_audio in audio_files:
                self._raise_if_generation_cancelled()
                if not os.path.isfile(selected_audio):
                    raise FileNotFoundError(
                        f"Không tìm thấy file Audio: {os.path.basename(selected_audio)}"
                    )
            if not placeholder_media and not os.path.isdir(image_dir):
                raise FileNotFoundError(
                    "Không tìm thấy Media Folder. Vui lòng bấm Browse và chọn lại."
                )
            motion_settings = job["motion_settings"]
            transition_settings = job["transition_settings"]
            effect_settings = job["effect_settings"]
            sound_effect_settings = job["sound_effect_settings"]
            animation_settings = job.get("animation_settings", {})

            if multi_audio_mode:
                self._run_multi_audio_job(
                    job,
                    audio_files,
                    image_dir,
                    proj_name,
                    motion_settings,
                    transition_settings,
                    effect_settings,
                    sound_effect_settings,
                )
                return

            if srt_file.startswith("Chọn") or not srt_file:
                raise Exception("Vui lòng chọn file SRT hoặc TXT!")
            if not scenes_content:
                raise Exception("Vui lòng nhập hoặc paste nội dung Scenes!")
            if not os.path.isfile(srt_file):
                raise FileNotFoundError(
                    "Không tìm thấy file SRT hoặc TXT. Vui lòng bấm Browse và chọn lại."
                )

            # Giữ nguyên logic đồng bộ hiện tại bằng một file scenes tạm.
            with tempfile.NamedTemporaryFile(
                mode="w", suffix=".txt", delete=False, encoding="utf-8"
            ) as temp_scenes:
                temp_scenes.write(scenes_content)
                scenes_file = temp_scenes.name
            
            self.log("Đang kiểm tra nhanh số lượng đầu vào...")
            
            # Đếm số dòng trong file text (cả none)
            raw_scenes = []
            with open(scenes_file, "r", encoding="utf-8-sig") as f:
                for line in f:
                    m = re.match(r'^(\d+)\.\s*(.*)', line.strip())
                    if m:
                        raw_scenes.append(int(m.group(1)))
                        
            # Lấy danh sách ảnh và video
            image_files = [None] * len(raw_scenes) if placeholder_media else []
            for fname in ([] if placeholder_media else os.listdir(image_dir)):
                if is_supported_media_file(fname):
                    image_files.append(os.path.join(image_dir, fname))
            if placeholder_media:
                self.log(f"Media Folder trống: dùng 2 ảnh 16:9 xen kẽ cho {len(raw_scenes)} dòng scene.")
                    
            if len(raw_scenes) != len(image_files):
                self.log(f"[LỖI] Kiểm tra nhanh: {len(image_files)} media vs {len(raw_scenes)} dòng text.")
                self._post_ui(
                    "count_error",
                    f"Phát hiện sự chênh lệch ngay từ bước đầu!\n\nSố ảnh/video trong thư mục: {len(image_files)}\nSố dòng scene: {len(raw_scenes)}\n\nVui lòng kiểm tra lại để đảm bảo khớp 100% trước khi tiếp tục.",
                )
                return
                
            # Áp dụng logic sắp xếp
            sort_order = job["sort_order"]
            if not placeholder_media and sort_order == "Sắp xếp media theo ABC":
                image_files.sort(key=self.natural_sort_key)
            elif not placeholder_media and sort_order == "Sắp xếp media theo thời gian Cũ đến Mới":
                image_files.sort(key=lambda x: os.path.getctime(x))
            elif not placeholder_media and sort_order == "Sắp xếp media theo thời gian Mới đến Cũ":
                image_files.sort(key=lambda x: os.path.getctime(x), reverse=True)
            
            # Map cứng 1-1 giữa raw lines và image files đã sort
            if not placeholder_media and job.get("remove_gemini_watermark"):
                candidate_images = [
                    path for path in image_files
                    if os.path.splitext(path)[1].lower() in IMAGE_EXTENSIONS
                ]
                watermark_result = self._process_watermark_images(
                    candidate_images,
                    image_dir,
                    copy_original_on_failure=False,
                )
                replacements = dict(zip(candidate_images, watermark_result["paths"]))
                image_files = [replacements.get(path, path) for path in image_files]

            image_map = {}
            for i, num in enumerate(raw_scenes):
                image_map[num] = image_files[i]

            self.log(f"Đã nhận {len(scenes_content.splitlines())} scenes từ ô nhập.")
            self.log(f"Đọc SRT file: {srt_file}")
            self.log(f"Đọc Audio file: {audio_file}")
            self.log("Đang xử lý. Vui lòng đợi...")

            scenes, timings, debug_info = self._run_worker_process(
                process_sync_worker,
                scenes_file,
                srt_file,
                audio_file,
                job["match_mode"],
                bool(job["add_subtitles"] and job["subtitle_mode"] == "scene_chunks"),
            )
            
            self.log(f"--> Tìm thấy {debug_info['scenes_count']} scenes trong file txt.")
            self.log(f"--> Tìm thấy {debug_info['srt_count']} blocks trong file SRT.")
            self.log("Bắt đầu phân tích và khớp nội dung...")
            
            valid_scenes_count = len(timings)
            if debug_info.get("match_mode") == "ultra":
                self.log(
                    "Chế độ: Khớp siêu chính xác."
                )
            elif debug_info.get("match_mode") == "fast":
                self.log("Chế độ: Khớp siêu nhanh.")
            else:
                self.log("Chế độ: Khớp chính xác.")
            unmatched_scenes = debug_info.get('unmatched_scenes', [])
            if unmatched_scenes:
                self.log(
                    "[CẢNH BÁO] Scene không tìm thấy trong audio/SRT: "
                    + ", ".join(str(num) for num in unmatched_scenes)
                )
            self.log(f"Đã khớp thành công {valid_scenes_count} scenes hợp lệ.")
            
            self.log("Đang kiểm tra ảnh/video...")
            
            valid_timings = {}
            missing_images = []
            scene_positions = {num: index for index, num in enumerate(raw_scenes)}
            for num, t in timings.items():
                img_path = image_map.get(num)
                if placeholder_media or img_path:
                    t['image_path'] = img_path
                    if placeholder_media:
                        t['placeholder_index'] = scene_positions[num]
                    valid_timings[num] = t
                else:
                    missing_images.append(num)
            
            if len(valid_timings) == 0:
                self.log("[LỖI] Không có scene nào hợp lệ để tạo project.")
                self._post_ui(
                    "error",
                    "Không có scene nào hợp lệ. Vui lòng kiểm tra lại file scenes.txt và SRT.",
                )
                return

            self.license_manager.require_execution("gui-before-project")
            self.log("Đang tạo project CapCut...")
            if motion_settings.get("enabled"):
                modes_text = ", ".join(motion_settings["modes"])
                mix_text = "ngẫu nhiên" if motion_settings.get("random") else "xoay vòng"
                self.log(f"Auto keyframe: bật ({mix_text}) - {modes_text}")
            transition_names = [
                "Không transition" if key == "none" else TRANSITION_PRESETS[key]["name"]
                for key in transition_settings["selected"]
            ]
            transition_mode = "trộn ngẫu nhiên" if transition_settings.get("random") else "xoay vòng"
            self.log(
                f"Transition: {transition_mode} - " + ", ".join(transition_names)
            )
            effect_names = [
                "Không hiệu ứng" if key == "none" else VIDEO_EFFECT_PRESETS[key]["name"]
                for key in effect_settings["selected"]
                if key == "none" or key in VIDEO_EFFECT_PRESETS
            ]
            effect_mode = (
                "trộn ngẫu nhiên" if effect_settings.get("random") else "xoay vòng"
            )
            self.log(f"Hiệu ứng: {effect_mode} - " + ", ".join(effect_names))
            sound_effect_names = [
                "Không sound effect"
                if key == "none"
                else SOUND_EFFECT_PRESETS[key]["name"]
                for key in sound_effect_settings["selected"]
                if key == "none" or key in SOUND_EFFECT_PRESETS
            ]
            sound_effect_mode = (
                "trộn ngẫu nhiên"
                if sound_effect_settings.get("random")
                else "xoay vòng"
            )
            self.log(
                f"Sound effects: {sound_effect_mode} - "
                + ", ".join(sound_effect_names)
            )
            proj_folder = self._run_worker_process(
                create_project_worker,
                {
                    "project_name": proj_name,
                    "audio_path": audio_file,
                    "image_timings": valid_timings,
                    "placeholder_splash_path": _resource_path("splash_v43.png") if placeholder_media else None,
                    "add_subtitles": job["add_subtitles"],
                    "subtitle_mode": job["subtitle_mode"],
                    "subtitle_srt_path": job["srt_file"],
                    "motion_settings": motion_settings,
                    "project_root": job["project_root"],
                    "long_video_mode": job["long_video_mode"],
                    "transition_settings": transition_settings,
                    "effect_settings": effect_settings,
                    "sound_effect_settings": sound_effect_settings,
                    "animation_settings": animation_settings,
                    "background_music_paths": job.get("background_music_paths", []),
                    "background_music_clips": job.get("background_music_clips", []),
                    "capcut_version": job["capcut_version"],
                },
            )
            self._raise_if_generation_cancelled()
            
            self.log(f"\n[THÀNH CÔNG] Project đã được tạo tại:\n{proj_folder}")
            self.log("\nBây giờ bạn có thể mở CapCut PC và sẽ thấy Project mới này!")
            self._post_ui(
                "success",
                f"Đã tạo project CapCut thành công!\nTên: {proj_name}",
            )
        except GenerationCancelled:
            self.log("\n[ĐÃ HỦY] Đã dừng hoàn toàn và không giữ project tạo dở.")
        except Exception as e:
            error_text = str(e)
            self.log(f"\n[LỖI] {error_text}")
            lowered_error = error_text.lower()
            if (
                "draft_content.json" in lowered_error
                or "draft_meta_info.json" in lowered_error
            ):
                self._post_ui("error", "Không tìm thấy thư mục dự án CapCut hợp lệ. Vui lòng mở Cài đặt và chọn lại vị trí lưu dự án CapCut.")
            else:
                self._post_ui("error", f"Đã xảy ra lỗi:\n{error_text}")
        finally:
            if scenes_file and os.path.exists(scenes_file):
                try:
                    os.remove(scenes_file)
                except OSError:
                    pass
            if self._generation_cancel_event.is_set():
                self._cleanup_cancelled_generation_artifacts()
            self._post_ui("reset_button")

if __name__ == "__main__":
    multiprocessing.freeze_support()
    if not _acquire_single_instance():
        raise SystemExit(0)
    try:
        app = AutoCapCutApp()
        app.update_idletasks()
        _close_nuitka_splash()
        app.mainloop()
    finally:
        _release_single_instance()
